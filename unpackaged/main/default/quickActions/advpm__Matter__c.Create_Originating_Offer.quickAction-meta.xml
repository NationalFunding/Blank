<?xml version="1.0" encoding="UTF-8"?>
<QuickAction xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldOverrides>
        <field>Lead_Attorney_Email__c</field>
        <formula>advpm__Matter__c.Lead_Attorney__r.Email</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Matter_Owner_Email__c</field>
        <formula>advpm__Matter__c.Owner:User.Email</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Name</field>
        <formula>advpm__Matter__c.advpm__Matter_Number__c + &apos; Offer &apos; + TEXT(advpm__Matter__c.Originating_Offer_Counter__c + 1)</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Offer_Made_By__c</field>
        <formula>IF(
				OR(ISPICKVAL( advpm__Matter__c.advpm__Status__c ,&quot;Local Counsel&quot;),
							AND(ISPICKVAL(advpm__Matter__c.advpm__Status__c,&quot;Open&quot;),ISPICKVAL(advpm__Matter__c.advpm__Stage__c ,&quot;Out to Collections&quot;)))
											,
											&quot;Local Counsel&quot;,&quot;Defendant&quot;)</formula>
    </fieldOverrides>
