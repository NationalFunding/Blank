<messaging:emailTemplate subject="You're just 3 steps away from the funding your business needs" recipientType="Contact" relatedToType="Contact">
    <messaging:plainTextEmailBody >
        Hi {!recipient.FirstName},
        

        Your business funding options are ready! Click below and choose the best option to take your business to the next level.
        
        <apex:repeat var="objBD" value="{!recipient}">
            <apex:outputText >
                <p>
               <a href="{!$Setup.Instance_Settings__c.QB_Base_URL__c}?source=RepC&utm_medium=email&utm_source=sf_rep&utm_campaign=contact&payload={!recipient.Encrypted_Email_String__c}">View Your Offers</a>
               </p>
</apex:outputText>
  </apex:repeat>              
        
        Thanks, 
        
        {!$User.FirstName} {!$User.LastName} | {!$User.Title}
        {!$Setup.QB_Email_Variables__c.QB_Address__c}
        {!$User.Email}
        {!$User.Phone}
    </messaging:plainTextEmailBody>
    <messaging:htmlEmailBody >
        <html>

        <head>
            <meta name="viewport" content="width=device-width" />
            <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
            <title>Thank you for applying</title>
            <style media="all" type="text/css">
            @media only screen and (max-width: 620px) {
                table[class=body] h1,
                table[class=body] h2,
                table[class=body] h3,
                table[class=body] h4 {
                    font-weight: 600 !important;
                }
                table[class=body] h1 {
                    font-size: 22px !important;
                }
                table[class=body] h2 {
                    font-size: 18px !important;
                }
                table[class=body] h3 {
                    font-size: 16px !important;
                }
                table[class=body] .content,
                table[class=body] .wrapper {
                    padding: 10px !important;
                }
                table[class=body] .container {
                    padding: 0 !important;
                    width: 100% !important;
                }
                table[class=body] .btn table,
                table[class=body] .btn a {
                    width: 100% !important;
                }
            }
            </style>
        </head>

        <body style="margin: 0; font-family: Arial, sans-serif; font-size: 14px; height: 100% !important; line-height: 1.2em; -webkit-font-smoothing: antialiased; padding: 0; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; width: 100% !important; background-color: #f6f6f6;">
            <table class="body" style="box-sizing: border-box; border-collapse: separate !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: 100%; background-color: #f6f6f6;" width="100%" bgcolor="#f6f6f6">
                <tr>
                    <td style="box-sizing: border-box; font-family: Arial, 'Lucida Grande', sans-serif; font-size: 14px; vertical-align: top;" valign="top"></td>
                    <td class="container" style="box-sizing: border-box; font-family: Arial, 'Lucida Grande', sans-serif; font-size: 14px; vertical-align: top; display: block; Margin: 0 auto !important; max-width: 580px; padding: 10px; width: 580px;" width="580" valign="top">
                        <div class="content" style="box-sizing: border-box; display: block; margin: 0 auto; max-width: 580px; padding: 10px;">
                            <table class="main" style="box-sizing: border-box; border-collapse: separate !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: 100%; background: #ffffff; border: 9px solid #e9e9e9; border-radius: 3px;" width="100%">
                                <tr class="blue" style="margin-bottom: 15px; margin-top: 10px; width: 100%; background-color: white; text-align: center;" bgcolor="#223657" align="center">
                                    <td style="box-sizing: border-box; font-family: 'Helvetica Neue', Helvetica, Arial, 'Lucida Grande', sans-serif; font-size: 14px; vertical-align: top; padding-top:10px" valign="top">
                                        <a href="{!$Setup.Instance_Settings__c.QB_Base_URL__c}" style="box-sizing: border-box; color: #DC0032; text-decoration: underline;">
                                        <apex:image url="https://694044703213-static-assets.s3.us-west-2.amazonaws.com/salesforce/Logo_Quickbridge_ForPrint.jpg" width="50%"/>
                                        </a>
                                    </td>                                                   
                                </tr>
                                <tr>
                                    <td class="wrapper" style="box-sizing: border-box; font-family: Arial; font-size: 14px; vertical-align: top; padding: 15px;" valign="top">
                                        <table style="box-sizing: border-box; border-collapse: separate !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: 100%;" width="100%">
                                            <tr>
                                                <td style="box-sizing: border-box; font-family: Arial; font-size: 14px; vertical-align: top; padding: 10px;" valign="top">
                                                    <p style="font-family: Arial; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">Hi {!recipient.FirstName},</p>
                                                    <br/>
                                                    <p style="font-family: Arial; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">Your business funding options are ready! Click below and choose the best option to take your business to the next level.</p>
                                                    <br/>
                                                    <table class="btn btn-primary" cellpadding="0" cellspacing="0" style="box-sizing: border-box; border-collapse: separate !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: 100%;" width="100%">
                                                        <tr>
                                                            <td align="center" style="box-sizing: border-box; font-family: Arial; font-size: 14px; vertical-align: top; padding-bottom: 10px;" valign="top">
                                                                <table cellpadding="0" cellspacing="0" style="box-sizing: border-box; border-collapse: separate !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; width: auto;">
                                                                    <tr>
                                                                        <td style="box-sizing: border-box; font-family: Arial; font-size: 14px; vertical-align: top; background-color: #3DB5E6; border-radius: 5px; text-align: center;" valign="top" bgcolor="#3DB5E6" align="center">
                                                                            <apex:repeat var="objBD" value="{!recipient}">
                                                                                <apex:outputText >
                                                                                    <a href="{!$Setup.Instance_Settings__c.QB_Base_URL__c}?source=RepC&utm_medium=email&utm_source=sf_rep&utm_campaign=contact&utm_content=202412relaunch&payload={!recipient.Encrypted_Email_String__c}" style="box-sizing: border-box; border-color: #3DB5E6; text-decoration: none; background-color: #3DB5E6; border: solid 1px #3DB5E6; border-radius: 5px; cursor: pointer; color: black; font-size: 14px; font-weight: bold; margin: 0; padding: 10px 50px; text-transform: capitalize; display: inline-block;">View Your Offers</a>
                                                                                </apex:outputText>
                                                                            </apex:repeat>
                                                                            
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                    <br/>
                                                    <p style="font-family: Arial; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 5px;">
                                                    <br/><b>{!$User.FirstName} {!$User.LastName}</b> | {!$User.Title}
                                                    <br/><apex:image style="padding-top:20px; padding-bottom:20px;" url="https://694044703213-static-assets.s3.us-west-2.amazonaws.com/salesforce/Logo_Quickbridge_ForPrint.jpg" height="15" width="200"/>
                                                    <br/>{!$Setup.QB_Email_Variables__c.QB_Address__c}
                                                    <br/>P: <a style="text-decoration: none; color:black" href = "tel: {!$User.Phone}&nbsp;"> {!$User.Phone}</a>
                                                    <br/>E: <a style=" color:#DC0032" href="mailto:{!$User.Email}&nbsp;"> {!$User.Email} </a> | <a style=" color:#DC0032" href="https://www.quickbridge.com">www.quickbridge.com</a>
                                                    </p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="align-left small-gray pad-t20" style="box-sizing: border-box; font-family: 'Helvetica Neue', Helvetica, Arial, 'Lucida Grande', sans-serif; vertical-align: top; font-size: 10px; text-align: left; color: #223657; padding-top: 5px;" valign="top" align="left">
                                                 <a style="text-decoration:none; color:#DC0032" href="https://www.quickbridge.com/terms-conditions/">Terms &amp; Conditions</a> | <a style="text-decoration:none; color:#DC0032" href="https://www.quickbridge.com/privacy-policy/">Privacy Policy</a> |<a style="text-decoration:none; color:#DC0032" href="tel:{!$Setup.QB_Email_Variables__c.Contact_Us_Phone__c}"> Contact Us</a>
                                                   <br/>© {!YEAR(TODAY())} QuickBridge. All rights reserved.
                                                   <br/>This is a marketing email. <a style="color:#DC0032" href="mailto:{!$Label.QB_Unsubscribe_Url}?subject=Unsubscribe%20From%20Emails&body=I%20confirm%20I%20want%20to%20opt%20out%20from%20any%20emails">Unsubscribe.</a>
                                                   <br/>{!$Setup.QB_Email_Variables__c.QB_Address__c}
                                                   <br></br>
                                                         <br/>Subject to approval. Terms and conditions apply. Products offered by QuickBridge Funding, LLC and affiliates are business products only. Products are made or arranged pursuant to a California Financing Law License. License number: 603J292.
                                                         <br/><span style="font-size: 10px;color:#223657">1.</span> Fast approvals and 24-hour funding subject to receipt of required documentation, underwriting guidelines, and processing time by your bank. Funds are deposited into your business checking account as soon as the next business day after approval and acceptance of terms.
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                    <td style="box-sizing: border-box; font-family: Arial; font-size: 16px; vertical-align: top;" valign="top"></td>
                </tr>
            </table>
        </body>

        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>