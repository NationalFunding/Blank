<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font style="color: rgb(0, 0, 0); font-size: 12pt;" face="Arial, sans-serif"><span style="font-size: 12pt;">Hello,&nbsp;</span></font><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div><p class="MsoNormal"><font face="Arial, sans-serif">Please complete the attached form and send back with:</font></p><p class="MsoNormal"></p><ul><li><font face="Arial, sans-serif">Voided check for new account</font></li><li><font face="Arial, sans-serif">January and February bank statements and a month to date transaction history for March</font></li><ul><li><font face="Arial, sans-serif"><b><u>OR</u></b> if account was just opened, the opening statement and current balance on new account&nbsp;</font></li></ul></ul><p></p><p class="MsoNormal"><font face="Arial, sans-serif">Any questions, please give me a call.&nbsp;</font></p></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Arial, sans-serif">Thank you,&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><div style="font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif">{!User.Name} |&nbsp;{!User.Title}</font></div><div style="font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif"><br></font></div><p class="MsoNormal" style="background: rgb(255, 255, 255);"><b><span style="font-size: 12pt; font-family: Arial, sans-serif;">National Funding, Inc.,&nbsp;the parent and servicing&nbsp;company of&nbsp;</span></b><span style="font-size: 12pt; font-family: Arial, sans-serif;"><o:p></o:p></span></p><div style="background-color: rgb(255, 255, 255);"><b style="font-size: 12pt;"><span style="font-size: 12pt; font-family: Arial, sans-serif;">Quick Bridge Funding, LLC</span></b></div><div style="background-color: rgb(255, 255, 255);"><div>{!$Setup.Company_Information__c.Street__c}</div><div>{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</div></div><div style="font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif">P:&nbsp;{!User.Phone} | F:&nbsp;{!User.Fax}</font></div><div style="font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif">E:&nbsp;{!User.Email}</font></div></div></div>]]></td>
