<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Hello </span>{!Contact.FirstName}<span style="font-size: 12pt;">,&nbsp;</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><font face="Arial, sans-serif"><br></font></span></div><div style=""><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">We are reaching out to inform you that your account is past due. If you are having difficulties making payments currently, we offer temporary modification programs to bring your account back into good standing. Please get in touch with us as soon as you can to address the overdue payments.&nbsp;</span><span style="font-size: 12pt;">You can reach out by replying to this email, using our SMS correspondence, or by phone via my direct line at the bottom of this email.</span></font><div style=""><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif">Thank you,&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif">{!Case.OwnerFullName}<font style="color: rgb(0, 0, 0); font-size: medium;">&nbsp;|&nbsp;</font>{!Case.OwnerTitle}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b style="font-size: 14.6667px;"><span style="font-size: 12pt;">National Funding, Inc., the parent and servicing company of</span></b><br style="font-size: 14.6667px;"><span style="font-size: 12pt;"><b>Quick Bridge Funding, LLC</b></span></font></p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><div style="font-size: 12pt;">{!$Setup.Company_Information__c.Street__c}</div><div style="font-size: 12pt;">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</div></div><div style="background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">P: {!Case.OwnerPhone}&nbsp;| F:&nbsp;</font><font face="Arial, sans-serif">{!User.Fax}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif"><span style="color: rgb(0, 0, 0); font-size: medium;">E:&nbsp;</span>{!Case.OwnerEmail}</font></div></div></div></div></div>]]></td>
</tr>
</table>