<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p style="margin-top:0in;margin-right:0in;margin-bottom:8.0pt;margin-left:0in"><o:p></o:p></p><p style="margin-top:0in;margin-right:0in;margin-bottom:8.0pt;margin-left:0in"><o:p></o:p></p><p style="margin-top:0in;margin-right:0in;margin-bottom:8.0pt;margin-left:0in"><o:p></o:p></p><p style="margin-top:0in;margin-right:0in;margin-bottom:8.0pt;margin-left:0in"><o:p></o:p></p><p style="margin-top:0in;margin-right:0in;margin-bottom:8.0pt;margin-left:0in"><o:p></o:p></p><p style="margin-top:0in;margin-right:0in;margin-bottom:8.0pt;margin-left:0in"><span style="font-size: 12pt;">The last payment on your settlement agreement was returned
as the account has been frozen. We scheduled it to re-run for a second
time but the payment was again returned. Please contact me as soon
as possible as you are in default of your settlement agreement. If we do
not hear from you we will move forward with enforcing the terms of the
settlement agreement and seek to recover our attorney’s fees and costs for such
efforts.&nbsp;</span><span style="font-family: Arial, sans-serif; font-size: 12pt;">&nbsp;</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif">I look forward to hearing from you.&nbsp;&nbsp;</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif">&nbsp;</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif">Best Regards,&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></p><div style=""><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style=""><div style="background-color: rgb(255, 255, 255);"><div style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;"><font face="arial">{!User.Name} |&nbsp;</font><span style="font-family: arial;">{!User.Title}</span></div><div style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;"><span style="font-family: arial;"><br></span></div><div style=""><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b>{!advpm__Matter__c.Email_Signature_Company__c}</b></font></p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 16px;"><div>{!$Setup.Company_Information__c.Street__c}</div><div>{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</div></div><div style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;"><font face="arial">P:&nbsp;{!User.Phone} | F:&nbsp;{!User.Fax}</font></div><div style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;"><span style="font-family: arial;">E:&nbsp;{!User.Email}</span></div></div></div></div></div>]]></td>
