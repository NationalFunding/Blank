<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Hello </span>{!Contact.FirstName}<span style="font-size: 12pt;">,&nbsp;</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><font face="Arial, sans-serif"><br></font></span></div><div style=""><span style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 11pt;"><span style="font-family: Calibri, sans-serif;"><span style="font-size: 12pt;"><span style="font-family: Arial, sans-serif;">Please contact us immediately regarding your business loan. At this time, the account is past due. As stated in our previous email, temporary modification plans are available to help you keep your account in good standing in times of financial strain.&nbsp;</span></span><span style="font-size: 12pt;"><span style="font-family: Arial, sans-serif;">Please reach out to us as soon as possible by replying to this email or by phone via my direct line at the bottom of this email.</span></span></span></span><br style="font-family: &quot;Times New Roman&quot;; font-size: medium;"><br style="font-family: &quot;Times New Roman&quot;; font-size: medium;"><span style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 11pt;"><span style="font-family: Calibri, sans-serif;"><span style="font-size: 12pt;"><span style="font-family: Arial, sans-serif;">We look forward to hearing from you.</span></span></span></span><br><div style=""><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif">Thank you,&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif">{!Case.OwnerFullName}<font style="color: rgb(0, 0, 0); font-size: medium;">&nbsp;|&nbsp;</font>{!Case.OwnerTitle}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b style="font-size: 14.6667px;"><span style="font-size: 12pt;">National Funding, Inc., the parent and servicing company of</span></b><br style="font-size: 14.6667px;"><span style="font-size: 12pt;"><b>Quick Bridge Funding, LLC</b></span></font></p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><div style="font-size: 12pt;">{!$Setup.Company_Information__c.Street__c}</div><div style="font-size: 12pt;">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</div></div><div style="background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">P: {!Case.OwnerPhone}&nbsp;| F:&nbsp;</font><font face="Arial, sans-serif">{!User.Fax}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif"><span style="color: rgb(0, 0, 0); font-size: medium;">E:&nbsp;</span>{!Case.OwnerEmail}</font></div></div></div></div></div>]]></td>
