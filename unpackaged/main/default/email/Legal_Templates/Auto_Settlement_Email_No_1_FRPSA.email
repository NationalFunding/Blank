<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><span style="font-size: 12pt;">To </span>{!Contact.FirstName}<span style="font-size: 12pt;">,</span></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><div style=""><div style=""><div style="">Your agreement for the purchase and sale of future receivables with {!advpm__Matter__c.Originating_Lender__c} has recently charged off. The amount due is {!advpm__Matter__c.Total_Amount_Charged_Off__c}. We understand that there could be many reasons why you were unable to perform and therefore wanted to reach out to see if you were interested in working out a payment plan without having to proceed with possible litigation.</div><div style=""><br></div><div style="">Please feel free to call and/or email us to discuss further.</div></div></div></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Thank you</font><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">,</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style=""><font face="arial">{!advpm__Matter__c.Lead_Attorney_Name__c}</font><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;| {!advpm__Matter__c.Lead_Attorney_Title__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><strong style="font-size: medium; background-color: rgb(255, 255, 255);">National Funding, Inc.</strong><span style="font-size: medium; background-color: rgb(255, 255, 255);">, the parent and servicing company of</span><br style="font-size: medium; background-color: rgb(255, 255, 255);"><strong style="font-size: medium; background-color: rgb(255, 255, 255);">Quick Bridge Funding, LLC</strong></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: 12pt;">{!$Setup.Company_Information__c.Street__c}</div><div style="font-size: 12pt;">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">P: {!advpm__Matter__c.Lead_Attorney_Phone__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">E: {!advpm__Matter__c.Lead_Attorney_Email__c}</font></div>]]></td>
