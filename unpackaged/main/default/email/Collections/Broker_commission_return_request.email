<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif">Hello, <o:p></o:p></font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><br></font></p><p dir="auto" style="margin: 0in; line-height: 20px; padding: 0px; border: 0px; outline: 0px; vertical-align: baseline; background: rgb(255, 255, 255);"><font face="Arial, sans-serif" style="color: rgb(47, 57, 65); font-family: arial; font-size: 11pt;"><span style="margin: 0px; padding: 0px; border: 0px; outline: 0px; vertical-align: baseline; background: transparent; line-height: normal; color: black; font-size: 12pt;">This is a formal request for the commission return of </span></font><font face="Arial, sans-serif">{!Opportunity.Broker_Commission__c}</font></p><p dir="auto" style="margin: 0in; line-height: 20px; padding: 0px; border: 0px; outline: 0px; vertical-align: baseline; background: rgb(255, 255, 255);"><span style="margin: 0px; padding: 0px; border: 0px; outline: 0px; vertical-align: baseline; background: transparent; line-height: normal;"><font face="Arial, sans-serif" style=""><font face="arial"><span style="font-size: 12pt;">Customer completed </span></font>{!Case.Payments_Collected__c}&nbsp;<font face="arial"><span style="font-size: 12pt;">payments before beginning to bounce payments and going dark. We are going to be proceeding with litigation on this file and will need commission returned.</span></font></font></span></p><p dir="auto" style="color: rgb(47, 57, 65); font-family: arial; font-size: 11pt; margin: 0in; line-height: 20px; padding: 0px; border: 0px; outline: 0px; vertical-align: baseline; background: rgb(255, 255, 255);"><span style="margin: 0px; padding: 0px; border: 0px; outline: 0px; vertical-align: baseline; background: transparent; line-height: normal; color: black; font-size: 12pt;"><font face="Arial, sans-serif">Please confirm your authorization to ACH back the commission from the account on file. Wire instructions can also be provided upon request<br><br>Thank you,</font></span></p><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><div style="font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif">{!User.Name} |&nbsp;{!User.Title}</font></div><div style="font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif"><br></font></div><div style="background-color: rgb(255, 255, 255);"><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b>{!Case.Email_Signature_Company__c}</b></font></p></div><div style="background-color: rgb(255, 255, 255);"><div style="font-family: &quot;Times New Roman&quot;;"><font face="Arial, sans-serif">{!$Setup.Company_Information__c.Street__c}</font></div><div style="font-family: &quot;Times New Roman&quot;;"><font face="Arial, sans-serif">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</font></div></div><div style="font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif">P:&nbsp;{!User.Phone} | F:&nbsp;{!User.Fax}</font></div><div style="font-size: medium; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif">E:&nbsp;{!User.Email}</font></div></div></div>]]></td>
</tr>
</table>