<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;" face="Arial, sans-serif"><span style="font-size: 12pt;">Hello,&nbsp;</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif"><br></font></div><div style=""><p class="MsoNormal" style=""><font face="Arial, sans-serif">Your account is currently running past maturity. The balance remaining of</font><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;{!Case.Past_Due_Balance__c}&nbsp;</font><font face="arial">is considered past due at this time.&nbsp;We will continue to run your&nbsp;{!Case.Payment_Frequency__c} payments until the balance remaining is paid in full. We would also like to start to run additional payments as well in an effort to get this balance paid off in a timely manner. Please let me know what days work best for you&nbsp; to do so.&nbsp;</font><span style="font-family: arial;">&nbsp;</span></p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Thank you,&nbsp;</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><font face="arial">{!User.Name} |&nbsp;</font><span style="font-family: arial;">{!User.Title}</span></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><span style="font-family: arial;"><br></span></div><div style="background-color: rgb(255, 255, 255);"><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b>{!Case.Email_Signature_Company__c}</b></font></p></div><div style="background-color: rgb(255, 255, 255);"><div style="font-family: &quot;Times New Roman&quot;;"><font face="Arial, sans-serif">{!$Setup.Company_Information__c.Street__c}</font></div><div style="font-family: &quot;Times New Roman&quot;;"><font face="Arial, sans-serif">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</font></div></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><font face="arial">P:&nbsp;{!User.Phone} | F:&nbsp;{!User.Fax}</font></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><span style="font-family: arial;">E:&nbsp;{!User.Email}</span></div></div></div>]]></td>
</tr>
</table>