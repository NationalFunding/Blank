<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="arial" style="font-family: arial;"><span style="font-size: 12pt;">Hello,&nbsp;</span></font><div style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><br></div><div style="font-family: arial;"><span style="font-size: 12pt; line-height: 107%; font-family: Arial, sans-serif;">Please contact us regarding the recently returned
payments. At this time, we have not heard back from you and we would like to
partner with you ensure the account remains in good standing. Please let us
know if payments will clear moving forward and if we will be able to catch up the
now past due payments that have been returned. If not, please reach out to us
so we can help find a solution to keep your account current.</span></div><div style=""><div style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><br></div><div style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><br></div><div style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;">Thank you,&nbsp;</div><div style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><div style="font-family: &quot;Times New Roman&quot;; font-size: medium; background-color: rgb(255, 255, 255);"><font face="arial">{!User.Name} |&nbsp;</font><span style="font-family: arial;">{!User.Title}</span></div><div style="font-family: &quot;Times New Roman&quot;; font-size: medium; background-color: rgb(255, 255, 255);"><span style="font-family: arial;"><br></span></div><div style="font-family: arial; background-color: rgb(255, 255, 255);"><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b>{!Case.Email_Signature_Company__c}</b></font></p></div><div style="background-color: rgb(255, 255, 255);"><div style=""><font face="Arial, sans-serif" style="">{!$Setup.Company_Information__c.Street__c}</font></div><div style=""><font face="Arial, sans-serif" style="">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</font></div></div><div style="font-family: &quot;Times New Roman&quot;; font-size: medium; background-color: rgb(255, 255, 255);"><font face="arial">P:&nbsp;{!User.Phone} | F:&nbsp;{!User.Fax}</font></div><div style="font-family: &quot;Times New Roman&quot;; font-size: medium; background-color: rgb(255, 255, 255);"><span style="font-family: arial;">E:&nbsp;{!User.Email}</span></div></div></div>]]></td>
