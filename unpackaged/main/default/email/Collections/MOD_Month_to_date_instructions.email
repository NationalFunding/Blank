<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="arial" style="font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Hello,&nbsp;</span></font><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);"><br></div><div style=""><p class="MsoNormal" style="font-family: arial; font-size: 12pt;"><span style="font-size:12.0pt;line-height:107%;font-family:
&quot;Arial&quot;,sans-serif">If you are having trouble getting your Month to date as a
PDF, please follow these instructions:</span></p><p class="MsoNormal" style=""><span style="font-family: Arial, sans-serif; font-size: 12pt; text-indent: -0.25in; line-height: 107%;">- Log in to your banking website on a desktop</span></p><p class="MsoNormal" style=""><span style="font-family: Arial, sans-serif; font-size: 12pt; text-indent: -0.25in;">- Right click anywhere on the webpage</span></p><p class="MsoNormal" style=""><span style="font-family: Arial, sans-serif; font-size: 12pt; text-indent: -0.25in;">- S</span><span style="font-size: 12pt; text-indent: -0.25in; line-height: 107%; font-family: Arial, sans-serif;">elect "Print" In the browser</span></p><p class="MsoNormal" style=""><span style="font-family: Arial, sans-serif; font-size: 12pt; text-indent: -0.25in;">- Select "Change Printer"</span></p><p class="MsoNormal" style=""><span style="text-indent: -0.25in; line-height: 107%;"><span style="font-variant-numeric: normal; font-variant-east-asian: normal; font-stretch: normal; line-height: normal;"><font face="Arial, sans-serif">-&nbsp;</font></span></span><span style="font-size: 12pt; text-indent: -0.25in; line-height: 107%; font-family: Arial, sans-serif;">Select "Print to PDF"</span></p><p class="MsoNormal" style=""><span style="font-family: Arial, sans-serif; font-size: 12pt; text-indent: -0.25in;">- Select “Print” (This will save the webpage as a
pdf to your selected destination)</span></p></div><div style="font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Thank you,&nbsp;</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><font face="arial">{!User.Name} |&nbsp;</font><span style="font-family: arial;">{!User.Title}</span></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><span style="font-family: arial;"><br></span></div><div style="background-color: rgb(255, 255, 255);"><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b>{!Case.Email_Signature_Company__c}</b></font></p></div><div style="background-color: rgb(255, 255, 255);"><div style="font-family: &quot;Times New Roman&quot;;"><font face="Arial, sans-serif">{!$Setup.Company_Information__c.Street__c}</font></div><div style="font-family: &quot;Times New Roman&quot;;"><font face="Arial, sans-serif">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</font></div></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><font face="arial">P:&nbsp;{!User.Phone} | F:&nbsp;{!User.Fax}</font></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><span style="font-family: arial;">E:&nbsp;{!User.Email}</span></div></div></div>]]></td>
</tr>
</table>