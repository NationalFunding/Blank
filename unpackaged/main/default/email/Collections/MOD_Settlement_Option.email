<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;" face="Arial, sans-serif"><span style="font-size: 12pt;">Good Afternoon,&nbsp;</span></font><div><br><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: 12pt;">We have received approval for 2 options:</div><div style="font-size: 12pt;">&nbsp;</div><div style="font-size: 12pt;">A. We will settle the balance with a 1 time payment of $3,000.00 which can be made via credit card if necessary.</div><div style="font-size: 12pt;">&nbsp;</div><div style="font-size: 12pt;">B.&nbsp;<font face="arial" style="font-size: medium;">We can stop the payment for 2 weeks, run half payments for 2 weeks and then resume the full payment until the full remaining balance is repaid.</font></div><div style="font-size: 12pt;">&nbsp;</div><div style="font-size: 12pt;">Let me know which you would like to move forward with.</div></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Thank you,&nbsp;</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style=""><div style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; background-color: rgb(255, 255, 255);"><div><font face="arial">Modification Department</font></div></div><div style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; background-color: rgb(255, 255, 255);"><span style="font-family: arial;"><br></span></div><div style="background-color: rgb(255, 255, 255);"><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b>{!Case.Email_Signature_Company__c}</b></font></p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><div style="font-size: 12pt;">{!$Setup.Company_Information__c.Street__c}</div><div style="font-size: 12pt;">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</div></div></div></div></div>]]></td>
</tr>
