<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font style="color: rgb(0, 0, 0);" face="Arial, sans-serif">Hello,&nbsp;</font><div style="color: rgb(0, 0, 0);"><font face="Arial, sans-serif"><br></font></div><div style=""><p class="MsoNormal" style="color: rgb(0, 0, 0);"><font face="Arial, sans-serif" style="">We have received your request for a reconciliation, as provided for in Section 2.3 of the Agreement. In
order to process your request please provide us with the last two months of
bank statements.&nbsp; We need to receive
those within the next <b style="">five (5) days</b> for us to process your request,
otherwise your request will be voided.&nbsp;
Once we receive the statements, we will process your request and notify
you of any adjustment to the remittance amount going forward.</font></p><div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0);"><br></div></div><div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0);"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Thank you,&nbsp;</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><font face="arial">{!User.Name} |&nbsp;</font><span style="font-family: arial;">{!User.Title}</span></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><span style="font-family: arial;"><br></span></div><div style="background-color: rgb(255, 255, 255);"><p class="MsoNormal" style="background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"><font face="Arial, sans-serif"><b>{!Case.Email_Signature_Company__c}</b></font></p></div><div style="background-color: rgb(255, 255, 255);"><div style="font-family: &quot;Times New Roman&quot;; font-size: medium;"><font face="Arial, sans-serif">{!$Setup.Company_Information__c.Street__c}</font></div><div style="font-family: &quot;Times New Roman&quot;; font-size: medium;"><font face="Arial, sans-serif">{!$Setup.Company_Information__c.City__c}, {!$Setup.Company_Information__c.State__c} {!$Setup.Company_Information__c.Zip__c}</font></div></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><font face="arial">P:&nbsp;{!User.Phone} | F:&nbsp;{!User.Fax}</font></div><div style="font-size: medium; background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;;"><span style="font-family: arial;">E:&nbsp;{!User.Email}</span></div></div></div>]]></td>
