<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: arial;">{!Opportunity.Name} has final funded. &nbsp;Please update the lease plus record to reflect the change. &nbsp;Thank you.&nbsp;</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: arial;"><br></span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: arial;">Lease Plus # &nbsp;</span><font face="arial">{!Account.LP_Cust_Number__c}</font></div><font face="arial"><div><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Lease #:&nbsp;</font>{!Opportunity.Lease_Number__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Final Fund Date:&nbsp;</font>{!Opportunity.Final_Fund_Date__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><font size="3" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">{!Opportunity.Link}</font></font>]]></td>
