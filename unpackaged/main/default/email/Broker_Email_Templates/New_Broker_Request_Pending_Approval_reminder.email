<td tEditID="c1r2" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b style="font-size: 12pt;">General Info:&nbsp;</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Name:&nbsp;{!Account.Legal_Name__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Business Website:&nbsp;{!Account.Website}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Business Landline:&nbsp;{!Account.Phone}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Physical Address:&nbsp;</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">{!Account.ShippingAddress}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Detailed Info:</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Current Lenders:&nbsp;{!Account.Current_Lenders__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">How many reps:&nbsp;{!Account.Current_Rep_Count__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">How many employees:&nbsp;{!Account.NumberOfEmployees}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Monthly Funded Units:&nbsp;{!Account.Units_per_Month__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Monthly Funded Volume:&nbsp;{!Account.Deal_Volume_Per_Month__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">How They Entered Space:&nbsp;{!Account.How_Broker_Entered_Space__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div>]]></td>
</tr>
