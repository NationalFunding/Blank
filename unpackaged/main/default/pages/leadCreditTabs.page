<apex:page doctype="html-5.0" applyBodyTag="false" applyHtmlTag="false" showHeader="false" sidebar="false" standardStylesheets="false" StandardController="Lead" Extensions="vf_leadCreditTabs_ext">
    <html class="sfbs-fullscreen">

    <head>
