<apex:page Controller="customOpportunityName" tabStyle="Opportunity">
<apex:pageMessages />
<apex:form > 
    <apex:pageBlock title="Select Opportunity Record Type" id="selectRecType" mode="edit">
        <apex:pageBlockButtons >
            <apex:commandButton value="Continue" action="{!go}"/>
            <apex:commandButton value="Cancel" action="{!Cancel}"/>
        </apex:pageBlockButtons>
        <apex:pageBlockSection columns="1">
             <apex:pageBlockSectionItem >
               <apex:outputLabel id="lblOppRecType" value="Record Type of new record"/>
               <apex:selectList id="ddlOppRecType" size="1" multiselect="False" value="{!strRecId}">
                    <apex:selectOptions value="{!OpportunityRecordType}" /> 
                </apex:selectList>
             </apex:pageBlockSectionItem>
        </apex:pageBlockSection>
    </apex:pageBlock>
    <apex:pageBlock title="Available Opportunity Record Types" id="availableRecType" mode="view">
        <apex:pageBlockTable value="{!lstAllRecordTypes}" var="item">
           <apex:column headerValue="Record Type Name" value="{!item.name}"/>
           <apex:column headerValue="Description" value="{!item.Description}"/>
       </apex:pageBlockTable>
    </apex:pageBlock>
</apex:form> 
</apex:page>