<apex:page controller="NFCreditExperianPullController" standardStylesheets="false" showHeader="false" applyBodyTag="false" docType="html-5.0">
    <apex:stylesheet value="{!URLFOR($Resource.CreditReviewScreen, 'css/bootstrap.css')}"/>
    <apex:includescript value="//ajax.googleapis.com/ajax/libs/jquery/1.11.2/jquery.min.js"/>
    <apex:includeScript value="{!URLFOR($Resource.CreditReviewScreen, 'js/bootstrap.js')}"/>
    <style>
        .spin{
            -webkit-transform-origin: 50% 50%;
            transform-origin:50% 50%;
            -ms-transform-origin:50% 50%; /* IE 9 */
            -webkit-animation: spin 2s infinite linear;
            -moz-animation: spin 2s infinite linear;
            -o-animation: spin 2s infinite linear;
            animation: spin 2s infinite linear;
        }
        @-moz-keyframes spin {
        from {
        -moz-transform: rotate(0deg);
        }
        to {
        -moz-transform: rotate(360deg);
        }
        }
        
        @-webkit-keyframes spin {
        from {
        -webkit-transform: rotate(0deg);
        }
        to {
        -webkit-transform: rotate(360deg);
        }
        }
        
        @keyframes spin {
        from {
        transform: rotate(0deg);
        }
        to {
        transform: rotate(360deg);
        }
        }
    </style>
    <script>
    var $j = jQuery.noConflict();
    </script>
    <body class="mb30">
        <div class="container">
            <apex:form >
                <apex:actionFunction action="{!pullSimilars}" name="pullSimilars" reRender="mainForm" />
                <apex:outputPanel id="mainForm">
                    <div class="page-header">
                        <h1>Pulling Experian Commercial Credit <small>for {!acct.Name}</small></h1>
                    </div>
                        <div class="panel panel-default">
                            <!-- Default panel contents -->
                            <div class="panel-heading panel-title" style="font-weight: bolder;">Inquiry Information</div>
                            <!-- Table -->
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <td style="font-style: italic;">Legal Name:</td>
                                        <td>{!cr.Opportunity__r.Legal_Name__c}</td>
                                        <td rowspan="2">{!cr.Opportunity__r.Physical_Address_1__c}<br />{!cr.Opportunity__r.Physical_Address_City__c}, {!cr.Opportunity__r.Physical_Address_State__c} {!cr.Opportunity__r.Physical_Address_Zip__c}</td>
                                        <td rowspan="2">{!cr.Opportunity__r.Phone__c}</td>
                                        <td rowspan="2"></td>
                                    </tr>
                                    <tr>
                                        <td style="font-style: italic;border-top: 0px;">Company DBA:</td>
                                        <td style="border-top: 0px;">{!cr.Opportunity__r.Company_DBA__c}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    <apex:outputText rendered="{!isLoading == true}">
                        <p style="text-align: center; padding-top: 100px">
                            Searching for business names similar to <strong>{!cr.Opportunity__r.Legal_Name__c}</strong>...  (this may take some time)
                        </p>
                        <h1 style="padding-bottom: 100px 0">
                            <center><span class="glyphicon glyphicon-repeat spin" aria-hidden="true"></span></center>
                        </h1>
                    </apex:outputText>
                    <apex:outputText rendered="{!errorMessage != null}">
                        <div class="panel panel-danger">
                            <div class="panel-heading">
                                <h3 class="panel-title">Unable to Pull Credit</h3>
                            </div>
                            <div class="panel-body">
                                {!errorMessage}
                            </div>
                        </div>
                    </apex:outputText>
                    <apex:outputText rendered="{!records != null && records.size > 0}">
                        <div class="panel panel-default">
                            <!-- Default panel contents -->
                            <div class="panel-heading">Returned Results</div>
                            <!-- Table -->
                            <apex:inputText value="{!primaryResult}" id="primaryResult" style="display: none" styleClass="primaryResult" />
                            <table class="table table-striped table-hover">
                                <thead>
                                    <th width="20">Pull</th>
                                    <th width="20">Primary</th>
                                    <th>Business Name</th>
                                    <th>Address</th>
                                    <th>Phone</th>
                                    <th>BIS List Number</th>
                                    <th>Recent Credit Report</th>
                                </thead>
                                <tbody>
                                    <apex:repeat value="{!records}" var="rec">
                                        <tr>
                                            <td><apex:inputCheckbox value="{!rec.pullResult}" /></td>
                                            <td style="text-align: center"><input type="radio" value="{!rec.BISListNumber}" name="prRes" onchange="$j('.primaryResult').attr('value','{!rec.BISListNumber}');setToPull(this);" required="true" /></td>
                                            <td>{!rec.businessName}</td>
                                            <td>{!rec.StreetAddress}<br />{!rec.City}, {!rec.State} {!rec.Zip}</td>
                                            <td>{!rec.PhoneNumber}</td>
                                            <td>{!rec.BISListNumber}</td>
                                            <td>
                                                <apex:outputText rendered="{!rec.recentReport != null}">
                                                <!-- There is a recent credit report in the past 30 days for this experian file number -->
                                                    <apex:outputText value="{0, date, MMM d','  yyyy}">
                                                        <apex:param value="{!IF(rec.recentReport != null, rec.recentReport.Transaction_Date__c, 'None')}" /> 
                                                    </apex:outputText>
                                                    <span style="padding-left: 5px;">
                                                        <a href="{!IF(rec.recentReport != null, rec.recentReport.URL_for_View_Link__c, '')}" target="_blank">(View Report)</a>
                                                    </span>
                                                </apex:outputText>
                                                <apex:outputText rendered="{!rec.recentReport == null}">
                                                <!-- There is a NO recent credit report in the past 30 days for this experian file number -->
                                                    None in the past 30 days                                       
                                                </apex:outputText>
                                            </td>
                                        </tr>
                                    </apex:repeat>
                                </tbody>
                            </table>
                            <div class="panel-footer">
                                <apex:commandButton action="{!pullResults}" styleClass="btn lgBtn" value="Pull Credit Records from Experian" />
                            </div>
                        </div>
                    </apex:outputText>
                    <apex:outputText rendered="{!isLoading == false && errorMessage == null && records.size == 0}">
                        <div class="panel panel-default">
                            <!-- Default panel contents -->
                            <div class="panel-heading">Returned Results</div>
                            <!-- Table -->
                            <div class="panel-body">
                                Experian returned no results.
                            </div>
                        </div>
                    </apex:outputText>
                </apex:outputPanel>
            </apex:form>
            <apex:outputText rendered="{!isComplete}">
                <script>
                    window.opener.callBusinessLoading('experian');
                    window.close();
                </script>
            </apex:outputText>
        </div>
        
        
        <script>
        function setToPull(obj) {
            var checkbox = $j(obj).closest('tr').find('input[type=checkbox]')
            checkbox.prop( "checked", true )
        }

        $j(document).ready(pullSimilars());
        </script>
    </body>
</apex:page>