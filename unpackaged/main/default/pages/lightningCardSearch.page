<apex:page >
    <script src="/support/console/49.0/integration.js" type="text/javascript"></script>
    <script src="https://code.jquery.com/jquery-1.11.1.min.js"></script>
        
    <script type="text/javascript">
       
        const campaignName = "{!$CurrentPage.parameters.Campaign_Name}";
        const ani = "{!$CurrentPage.parameters.ANI}";
        const dnis = "{!$CurrentPage.parameters.DNIS}";
        const direction = "{!$CurrentPage.parameters.call_direction}";
        
        // New Tab should be LEX Unified Search Result
        var stringToEncode = '{"componentDef":"forceSearch:search","attributes":{"term":"'+ani + '","scopeMap":{"type":"TOP_RESULTS"},"context": {"disableSpellCorrection":false,"SEARCH_ACTIVITY":{"term":"'+ ani + '"}}}}';
        var encodedString = btoa(stringToEncode);
        var globalSearchUrl ="/one/one.app?source=alohaHeader#" +encodedString


    function openPrimaryTab(){
        //Open a new primary tab with the salesforce.com home page in it
        sforce.console.openPrimaryTab(null, globalSearchUrl, true, 'Phone Search', openSuccess, 'ANI');
    }

    var openSuccess = function openSuccess(result){
        //Report whether opening the new tab was successful
        console.log('Open Tab Result: ', result);
    };

    function testCloseTab() {
        //First find the ID of the current tab to close it
        sforce.console.getEnclosingTabId(closeSubtab);
        }
        
    var closeSubtab = function closeSubtab(result) {
        //Now that we have the tab ID, we can close it
        var tabId = result.id;
        sforce.console.closeTab(tabId);
    };

    function pageLoad(){

        console.log('Five9 Campaign Name: ', campaignName);
        console.log('Five9 ANI: ', ani);
        console.log('Five9 DNIS: ', dnis);
        console.log('Five9 Direction: ', direction);


        // NOTE: 12/15/2020 - Inbound calls are defined by F9 IVRs. There is a custom variable that is defined & populated when a call goes through an IVR. See Direction Variable on top of page.

        // Determing Direction:
        // If Inbound, continue with Screen Pop
        if(direction == 'Inbound'){

            console.log('This is an Inbound F9 Call!!');

            //If Mailer pop card search
            //Else Close Card Search & Open General Salesforce Search on ANI
            if(campaignName.includes('Mailer') && campaignName != null){

                // Do Nothing
                console.log('Mailer Campaign - Screen Pop');


            } else {

                console.log('NOT Mailer Campaign - Cloase Screen Pop & Open General Phone Search');
                // **************
                // Close this Tab
                // **************
                testCloseTab();

                // **************
                // Open New Tab
                // **************

                // Open new Tab within Salesforce Console
                openPrimaryTab();

                // Open new Browser Tab
                // window.open(globalSearchUrl);
            }

        } else {

            console.log('This is an Outbound Call');

            // Close all Tabs
            testCloseTab();

            // Method loads the previous URL in the history list. Used to refocus on Original Tab
            window.history.back();

        }
        



    }
        
    window.onload = pageLoad();        
    
    </script>

    <!--This component loads the JavaScript file used by Lightning Components for Visualforce-->
    <apex:includeLightning />
    
    <!--Display Aura Lightning Component-->
    <div style="width:100%; height:100%" id="CardSearch"></div>
    
    <!--VF JS Script-->
    
    <script>
           
        $Lightning.use("c:AuraCardSearchApplication",function(){
                
            $Lightning.createComponent("c:AuraCardSearch",
            {
            }, 
            "CardSearch",
            function(component){
                console.log("cardSearch VFP LWC Callback:");
                console.log(component);
                $A.eventService.addHandler({ "event": "c:cardSearchRecord", "handler" : visualForceFunction});
            });
        });
            
    </script>  
    
    <script>
        var visualForceFunction = function(event){
            var myEventData = event.getParam("recordId");
            console.log('VFP Received Event from Aura: ', myEventData);
            sforce.one.navigateToSObject(myEventData);
            console.log('Opened Tab');
        };
    </script>
    
</apex:page>