            reparentActivity(t1, result.id, p1);
        };
        
        sforce.console.getFocusedSubtabObjectId(showObjectId2);
        
    };
    
    function reparentActivity(objId, reparent, phoneNumber){
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.VisualforceTestActivityController.phoneMatch}',
            reparent, phoneNumber,
            function(result, event){
                console.log('Second Phone Match Pass::::::>  ' + result);
                if(result == true){
                    reparentSend(objId, reparent);
                };
                if(result == false){
                    sforce.console.getPrimaryTabIds(checkSubTabCallback);
                };
            }           
        );
    };
    
    
    
    function reparentSend(objId, reparent){
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.VisualforceTestActivityController.reparentActivityCtrl}',
            objId, reparent,
            function(result, event){
                if(result == true){
                    console.log('Reparent Task:::::::> '  + objId);
                };
            }
        );
    };
    
    
    
    function phoneMatchLog(taskId){
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.VisualforceTestActivityController.phoneMatchLog}',
            taskId,
            function(result, event){
                if(result == true){
                    console.log('Phonematch Task Report::::::> ' + taskId);
                    location.reload();
                };
            }
        );
    };
    
    function nophoneMatchLog(taskId){
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.VisualforceTestActivityController.nophoneMatchLog}',
            taskId,
            function(result, event){
                if(result == true){
                    console.log('NoPhonematch Task Report::::::> ' + taskId);
                    location.reload();
                    
                };
                
            }
        );
    };
    function checkSubTabCallback(result) {
        var arrPriTabs = result.ids;
        if (result.error) {
            console.log("Error message is " + result.error);
        } else {
            for (var i = 0; i < arrPriTabs.length; i++) {
                if(i != arrPriTabs.length - 1){
                    sforce.console.getPageInfo(arrPriTabs[i] , showPageInfo);
                }
                else{
                    sforce.console.getPageInfo(arrPriTabs[i] , showPageInfo2);
                }
            }
            
        }
        
    };
    
