    function startActions(objid, phone, id) {
        var oppId = objid.replace(/"/g,"");
        var phoneNumber = phone.replace(/"/g,"");
        var taskId = id.replace(/"/g,"");
        
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.VisualforceTestActivityController.phoneMatch}',
            oppId, phoneNumber,
            function(result, event){
                console.log('First Phone Match Pass::::::> ' + result + ' ObjectID: ' + oppId);
                if(result == false || result == 'null'){
                    var pObjID = sforce.console.getFocusedPrimaryTabObjectId(showObjectId);
                };
                if(result == true){
                    phoneMatchLog(taskId);
                };
            }           
        );
        
        var showObjectId = function showObjectId(result) {
            //Display the object ID
            console.log('Object ID(Page):::::::> ' + result.id + ' Object ID(Task): ' + oppId + ' Task Id: ' + taskId);
            console.log(result.id.length);
            if(result.id.length < 5 ){
                console.log('fire');
                subTabEvent(taskId, phoneNumber);    
            }
            if(result.id.length > 10){
                reparentActivity(taskId, result.id, phoneNumber);
            }
        };
        
    };
    function subTabEvent(taskId, phoneNumber){
        const t1 = taskId;
        const p1 = phoneNumber;
        
