<apex:page StandardController="FPC_Equipment__c" extensions="CustomEquipmentController">
    <style>
        .sectionLabel label, .bPageBlock .pbBody .labelCol .helpButton{
            display:block;
            width:150px;
        }
        .bPageBlock .pbBody .labelCol label{
            width:140px;
        }
        .locationError { color: red; font-weight: strong;}
        
        .bPageBlock .detailList .data2Col {
            text-align:center;
        }

    </style>
    <apex:sectionHeader title="Equipment Edit" subtitle="New Equipment"/> 
    <apex:pageMessages />
    <apex:form >
        <apex:pageBlock id="VendorPageBlock" mode="edit" >      
        
        <apex:pageBlockSection columns="1" rendered="{!isError_flg}">
                    <apex:outputText value="{!ErrorMessage}" rendered="{!isErrIn_flg}" style="color:#ff0000;font-weight: bold;"/>
                    <apex:outputText value="The Vendor Postalcode must be in 99999 or 99999-9999 format" rendered="{!isErrFt_flg}" style="color:#ff0000;font-weight: bold;"/>       
                    <apex:outputText value="Vendor Phone: Invalid phone number." rendered="{!isErrFt_flg1}" style="color:#ff0000;font-weight: bold;"/>
        </apex:pageBlockSection>                
                
            <apex:pageBlockButtons location="top">          
                <apex:commandButton value="Create New Vendor" action="{!CreateNewVendor}" reRender="VendorPageBlock" immediate="true"/> 
                <apex:commandButton value="Associate Vendor" action="{!AssociateVendor}" reRender="VendorPageBlock" immediate="true"/>
            </apex:pageBlockButtons>            
            <apex:pageBlockSection title="Vendor Information" columns="3" rendered="{!isCreate_flg}">           
                <apex:inputField value="{!FPC_Equipment__c.Vendor_Name__c}" required="true"/>                               
                <apex:pageBlockSectionItem >                
                    <apex:outputLabel value="Vendor Address 1" for="requiredAddfield"/>
                    <apex:outputPanel >
                        <div class="requiredInput">
                            <div class="requiredBlock"></div>
                            <apex:inputtext value="{!TempVendor_Address_1}" id="requiredAddfield" />
                        </div>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                <apex:outputLabel value="Vendor City" for="requiredCTYfield"/>
                <apex:outputPanel >
                    <div class="requiredInput">
                        <div class="requiredBlock"></div>
                        <apex:inputtext value="{!TempVendor_City}" id="requiredCTYfield"/>
                    </div>
                </apex:outputPanel>
                </apex:pageBlockSectionItem>                
                <apex:inputField value="{!FPC_Equipment__c.Vendor_State__c}" />
                <apex:pageBlockSectionItem >
                <apex:outputLabel value="Vendor Zip" for="requiredPOSfield"/>
                <apex:outputPanel >
                    <div class="requiredInput">
                        <div class="requiredBlock"></div>
                        <apex:inputtext value="{!TempVendor_Postalcode}" id="requiredPOSfield" />
                    </div>
                </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <!-- 20110329 Albert add ST-->
                <apex:pageBlockSectionItem >
                <apex:outputLabel value="Vendor Phone" for="requiredPHNfield"/>
                <apex:outputPanel >
                    <div class="requiredInput">
                        <div class="requiredBlock"></div>
                        <apex:inputtext value="{!FPC_Equipment__c.Vendor_Phone__c}" id="requiredPHNfield" />
                    </div>
                </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem />               
            </apex:pageBlockSection>                        
            <apex:pageBlockSection title="Vendor Information" columns="3" rendered="{!isAssCre_flg}">           
                <apex:inputField value="{!FPC_Equipment__c.Account__c}" required="true">
                    <apex:actionSupport event="onchange" rerender="VendorPageBlock" action="{!populateVendorData}" status="Mystatus" /> 
                </apex:inputField>
                
                <apex:pageBlockSectionItem >
                <apex:outputLabel value="Vendor Address 1" for="requiredAddfield"/>
                <apex:outputPanel >
                    <div class="requiredInput">
                        <div class="requiredBlock"></div>
                        <apex:inputtext value="{!TempVendor_Address_1}" id="requiredAddfield" />
                    </div>
                </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                <apex:outputLabel value="Vendor City" for="requiredCTYfield"/>
                <apex:outputPanel >
                    <div class="requiredInput">
                        <div class="requiredBlock"></div>
                            <apex:inputtext value="{!TempVendor_City}" id="requiredCTYfield" />
                    </div>
                </apex:outputPanel>

                </apex:pageBlockSectionItem>                
                <apex:inputField value="{!FPC_Equipment__c.Vendor_State__c}" />
                <apex:pageBlockSectionItem >
                <apex:outputLabel value="Vendor Zip" for="requiredPOSfield"/>
                <apex:outputPanel >
                    <div class="requiredInput">
                        <div class="requiredBlock"></div>
                        <apex:inputtext value="{!TempVendor_Postalcode}" id="requiredPOSfield" />
                    </div>
                </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Vendor Phone" for="requiredPHNfield"/>
                    <apex:outputPanel >
                        <div class="requiredInput">
                            <div class="requiredBlock"></div>
                            <apex:inputtext value="{!FPC_Equipment__c.Vendor_Phone__c}" id="requiredPHNfield" />
                        </div>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem />
                <apex:actionStatus startText=" (reading...)" id="Mystatus"/>
                <apex:pageBlockSectionItem />
            </apex:pageBlockSection>
        </apex:pageBlock>
        
        <apex:pageBlock id="EquipmentPageBlock" mode="edit">    
            <apex:pageBlockSection title="Add Equipment Information" columns="3">
                
                <apex:pageBlockSectionItem >
                <apex:outputLabel value="Equipment Description" for="requiredEQDfield"/>
                    <apex:outputText >
                        <div class="requiredInput">
                            <div class="requiredBlock"></div>
                            <apex:inputtext value="{!TempEquipment_Description}" id="requiredEQDfield" />
                        </div>
                    </apex:outputText>

                </apex:pageBlockSectionItem>            
                
                <apex:inputField value="{!FPC_Equipment__c.Equipment_Year__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Model_Number__c}"/>
                
<!--1 error delete  
                <apex:outputText value="{!ErrorMessage1}" rendered="{!isError_flg1}" style="color:#ff0000;font-weight: strong;"/>
                <apex:pageBlockSectionItem rendered="{!isError_flg1}"/> 
                <apex:pageBlockSectionItem rendered="{!isError_flg1}"/> 
-->                                 
                <apex:inputField value="{!FPC_Equipment__c.New_Used__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Make__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Serial_Number__c}"/>                 
                <apex:inputField value="{!FPC_Equipment__c.Title_Work__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Quantity__c}"/>
            </apex:pageBlockSection>
            <apex:pageBlockSection title="Equipment Costs" columns="3">
                <apex:inputField value="{!FPC_Equipment__c.Original_Invoice_Amount__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Shipping__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Sales_Tax__c}"/>             
                <apex:pageBlockSectionItem />               
                <apex:inputField value="{!FPC_Equipment__c.Other_Charge__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Total_Tax__c}"/>
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem >                
                <apex:inputField value="{!FPC_Equipment__c.Grand_Total_F__c}"/>
                <apex:outputtext id="grandtotal"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:pageBlockSection title="Equipment Address" columns="3">
                <apex:inputField value="{!FPC_Equipment__c.Address1__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.State__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Equipment_Location_Desc__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.City__c}"/>
                <apex:inputField value="{!FPC_Equipment__c.Postalcode__c}"/>
            </apex:pageBlockSection>
            <apex:pageBlockSection title="Equipment Notes" columns="3">
                <apex:inputField value="{!FPC_Equipment__c.Equipment_Notes__c}" style="width: 150px; height: 60px"/>
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem />
                        <apex:inputField value="{!FPC_Equipment__c.Opportunity__c}" rendered="false"/>
            </apex:pageBlockSection>
            <br/><br/>      
            <apex:commandButton value="Add Equipment" action="{!CreateNewEquipment}" reRender="VendorPageBlock,SaveCancelPageBlock,EquipmentPageBlock,cmdBtns"/>
            <br/><br/>
            
        </apex:pageBlock>
        
        <apex:pageBlock id="SaveCancelPageBlock" mode="edit">
            <apex:pageBlockTable value="{!eqpList}" var="item" border="0">      
                <apex:column headerValue="Equipment Description"> 
                        <apex:outputField value="{!item.Equipment_Description__c}"/>
                </apex:column>
                <apex:column headerValue="New Used"> 
                        <apex:outputField value="{!item.New_Used__c}" />
                </apex:column>
                <apex:column headerValue="Title Work"> 
                        <apex:outputField value="{!item.Title_Work__c}"/>
                </apex:column>   
                <apex:column headerValue="Quantity"> 
                        <apex:outputField value="{!item.Quantity__c}"/>
                </apex:column> 
                <apex:column headerValue="Serial Number"> 
                        <apex:outputField value="{!item.Serial_Number__c}"/>
                </apex:column>
                <apex:column headerValue="Grand Total"> 
                        <apex:outputField value="{!item.Grand_Total__c}"/>
                </apex:column> 
                <apex:column headerValue="Vendor"> 
                        <apex:outputField value="{!item.Vendor_Name__c}"/>
                </apex:column>   
                <apex:column headerValue="Vendor Phone"> 
                        <apex:outputField value="{!item.Vendor_Phone__c}"/>
                </apex:column>              
                <apex:column headerValue="Equipment Address 1"> 
                        <apex:outputField value="{!item.Address1__c}"/>
                </apex:column>                                      
            </apex:pageBlockTable>                      
            <apex:pageBlockButtons location="bottom" id="cmdBtns"> 
                <apex:commandButton value="Save" action="{!saveNewEquiment}" disabled="{!isDisSav_flg}" id="saveBtn" immediate="true" />
                <apex:commandButton value="Cancel" action="{!Mycancel}" immediate="true"/>
            </apex:pageBlockButtons>                 
        </apex:pageBlock>
    </apex:form>
</apex:page>