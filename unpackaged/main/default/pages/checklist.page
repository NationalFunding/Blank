      var checklistFlag = false;
      var stipulationsFlag = false;
      var creditReviewStatus = '{!creditReviewObj.Status__c}';
      function disabledEvents(creditStatus) {
        if ('{!$Permission.Modify_Completed_Credit_Reviews}' == 'false') {
          if ((creditStatus == 'Approved' || creditStatus == 'Second Review' || creditStatus == 'Withdrawn' || creditStatus == 'Declined')) {
            $('input,button,select,textarea').attr('disabled', 'disabled');
          } else {
            $('input,button,select,textarea').removeAttr('disabled');
          }
        }
      }
      function removeChecklistPrevent() {
        $('[href="#tab2"]').removeClass('disabled');
        window.onbeforeunload = function () {
          null;
        };
        checklistFlag = false;
      }
      function removeStipulationsPrevent() {
        $('[href="#tab1"]').removeClass('disabled');
        window.onbeforeunload = function () {
          null;
        };
        stipulationsFlag = false;
      }
      function canceChecklistChanges() {
        var r = confirm('Are you sure?');
        if (r) {
          removeChecklistPrevent();
          checklistReset();
        }
      }
      function canceStipulationsChanges() {
        var r = confirm('Are you sure?');
        if (r) {
          removeStipulationsPrevent();
          stipulationsReset();
        }
      }

      function checkedRow() {
        $('.done').each(function () {
          if ($(this).is(":checked")) {
            $(this).closest('tr').addClass('complete');
          } else {
            $(this).closest('tr').removeAttr('class');
          }
        }).click(function () {
          if ($(this).is(":checked")) {
            $(this).closest('tr').addClass('complete');
          } else {
            $(this).closest('tr').removeAttr('class');
          }
        })
      }
      function bindCheckListInput() {
        $('#tab1').find('input[type=text]').keyup(function (event) {
          if ($(this).val() != '') {
            // alert()
            if (!checklistFlag) {
              checklistFlag = true;
              $('[href="#tab2"]').addClass('disabled');
              window.onbeforeunload = function () {
                return "You have unsaved changes. Are you sure you want to leave this page? All changes will be lost.";
              };
            }
          }
        });
        $('#tab1').find('input[type=checkbox]').click(function (event) {
          if (!checklistFlag) {
            checklistFlag = true;
            $('[href="#tab2"]').addClass('disabled');
            window.onbeforeunload = function () {
              return "You have unsaved changes. Are you sure you want to leave this page? All changes will be lost.";
            };
          }
        });
      }
      function bindStipulationsInput() {
        $('#tab2').find('select').change(function (event) {
          if ($(this).val() != '') {
            if (!stipulationsFlag) {
              stipulationsFlag = true;
              $('[href="#tab1"]').addClass('disabled');
              window.onbeforeunload = function () {
                return "You have unsaved changes. Are you sure you want to leave this page? All changes will be lost.";
              };
            }
          }
