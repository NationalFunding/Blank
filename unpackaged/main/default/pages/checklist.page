      function stipCheck() {
        autosize($('.stip_notes'));
        $('.stip').click(function () {
          if ($(this).is(":checked")) {
            $(this).closest('.input-group').find('.stip_notes').removeClass('disabled')
          } else {
            $(this).closest('.input-group').find('.stip_notes').addClass('disabled');
          }
          // checklistSaveNew();
          $(document).on('keypress keydown', '.disabled', function (e) {
            if (event.keyCode == 9) {
              return true;
            }
            if (event.keyCode == 8 || event.keyCode == 46) {
              return false;
            }

            return false;
          });
        })
        disabledTextarea();
      }
      function disabledTextarea() {
        $('.stip').each(function () {
          if ($(this).is(":checked")) {
            $(this).closest('.input-group').find('.stip_notes').removeClass('disabled')
          } else {
            $(this).closest('.input-group').find('.stip_notes').addClass('disabled');
          }
        });
      }
      $(function () {
        $(document).on('keypress keydown', '.disabled', function (e) {
          if (event.keyCode == 9) {
            return true;
          }
          if (event.keyCode == 8 || event.keyCode == 46) {
            return false;
          }

          return false;
        });

        bindCheckListInput();
        checkedRow();
        bindStipulationsInput();
        valueFill();
        bindUrlMaker();
        stipCheck();
        disabledEvents(creditReviewStatus);

        $('.done').click(function () {
          if ($(this).is(":checked")) {
            $(this).closest('tr').addClass('complete');
          } else {
            $(this).closest('tr').removeAttr('class');
          }
        })
        if (getCookie("stripulations") != '') {
          $('.tab2').click();
          unsetCookie('stripulations');
        }
        $("[data-toggle='tab']").click(function () {
          if ($(this).hasClass("disabled")) {
            alert('Please save your changes before switching tabs. If you do not wish to save your changes, please click \'Cancel\' on the bottom of this page.');
            return false;
          }
        });
      })
      function unlockCreditReviewForm() {
        $('input,button,select,textarea').removeAttr('disabled');
