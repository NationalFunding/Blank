        $('#tab2').find('input[type=text]').keyup(function (event) {
          if ($(this).val() != '') {
            if (!stipulationsFlag) {
              stipulationsFlag = true;
              $('[href="#tab1"]').addClass('disabled');
              window.onbeforeunload = function () {
                return "You have unsaved changes. Are you sure you want to leave this page? All changes will be lost.";
              };
            }
          }
        });
      }

      function getCookie(cname) {
        var name = cname + "=";
        var ca = document.cookie.split(';');
        for (var i = 0; i < ca.length; i++) {
          var c = ca[i];
          while (c.charAt(0) == ' ') c = c.substring(1);
          if (c.indexOf(name) == 0) {
            return c.substring(name.length, c.length);
          }
        }
        return "";
      }
      function unsetCookie(cname) {
        document.cookie = cname + '=;expires=Thu, 01 Jan 1970 00:00:01 GMT;';
      }
      function bindUrlMaker() {
        $('.search_for').each(function (index, el) {
          var url = 'https://www.google.com/search?q=' + encodeURIComponent($(this).val()).split(' ').join('+');
          var link = '<a href="' + url + '" target="_blank">' + url + '</a>';
          $(this).closest('tr').find('.url').html(link);
        }).keyup(function (event) {
          var url = 'https://www.google.com/search?q=' + encodeURIComponent($(this).val()).split(' ').join('+');
          var link = '<a href="' + url + '" target="_blank">' + url + '</a>';
          $(this).closest('tr').find('.url').html(link);
        });
