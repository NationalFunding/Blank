        <apex:stylesheet value="{!URLFOR($Resource.CreditReviewScreen, 'assets/plugins/bootstrap-datepicker/css/datepicker.css')}"/>
        <apex:includescript value="https://ajax.googleapis.com/ajax/libs/angularjs/1.3.9/angular.min.js"></apex:includescript>
        <apex:includescript value="https://ajax.googleapis.com/ajax/libs/jquery/1.3.2/jquery.js"></apex:includescript>
