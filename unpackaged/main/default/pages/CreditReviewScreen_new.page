        <apex:includeScript value="{!URLFOR($Resource.CreditReviewScreen, 'angular/main.ctrl.js')}" />
        <!--<script src="{!$Resource.cometd}"/>
  <script src="{!$Resource.jquery_1_5_1}"/> 
  <script src="{!$Resource.json2}"/>
      <script src="{!$Resource.jquery_cometd}"></script>-->

        <!-- Custom Script -->
        <script>
  var ModifyPermission = true;
  var unLockPermissionDeny = false;
  var approved_date ="{!approved_date}";
  var rejected_date ="{!rejected_date}";
  var Syndication_rejected_date ="{!Syndication_rejected_date}";
  var approved_by = "{!creditReview.ApprovedBy__c}";
  var withdrawn_date ="{!withdrawn_date}";
  var withdrawn_by = "{!creditReview.Withdrawn_By__c}";
  var approvedRecomendation_date ="{!approvedRecomendation_date}";
  var approvedRecomendationBy = "{!creditReview.ApprovalRecomendationBy__c}";
  var businessEditPermission = "{!$Permission.Credit_Business_Information_Edit}";
  var pullCreditPermission = "{!$Permission.Credit_Review_Pull_Credit}";
  var consumer1Interval,consumer2Interval,consumer3Interval,consumer4Interval,consumer5Interval,consumer6Interval;
  var reasons = "{!creditReview.DeclineReasons__c}";
  var declineType = '';

  if("{!creditReview.Opportunity__r.RecordType.Name}" !='Broker WC Oppty' && "{!creditReview.Review_Type__c}" != 'Commercial Review'){
      //alert('dd1');
    $('.brokerDeclineCheckbox').show();
    $('.declineCheckbox,.commercialDeclineCheckbox').hide();
    declineType ='Decline';
    reasons = "{!creditReview.Decline_Reasons__c}";
  }
  if("{!creditReview.Opportunity__r.RecordType.Name}" == 'Broker WC Oppty' && "{!creditReview.Review_Type__c}" != 'Commercial Review'){
    // alert('dd2')
    $('.declineCheckbox').show();
    $('.brokerDeclineCheckbox,.commercialDeclineCheckbox').hide();
    declineType = 'Broker';
    reasons = "{!creditReview.Broker_Decline_Reasons__c}";
  }
  if("{!creditReview.Review_Type__c}" == 'Commercial Review'){
     //alert('dd3')
    $('.commercialDeclineCheckbox').show();
    $('.brokerDeclineCheckbox,.commercialDeclineCheckbox').hide();
    declineType = 'Commercial';
    reasons = "{!creditReview.Commercial_Decline_Reasons__c }";
  }
  var reasonsArr = reasons.split(';');
  var reasonCheckList = {};
  for(var i=0;i<reasonsArr.length;i++){
    reasonCheckList[reasonsArr[i]] = reasonsArr[i];
  }
  function declineChecked(){
    $('.brokerOther,.declineOther,.commercialOther').hide();
    //alert()
    if(reasonCheckList['Other'] !== undefined){
      if(declineType =='Commercial' ){
        $('.commercialOther').show();
      }
      if(declineType =='Broker'){
        $('.brokerOther').show();
      }
      if(declineType =='Decline'){
        $('.declineOther').show();
      }
    }
    
    $('.declineSyndicationOption').each(function(){
      $(this).filter(function() {
       /// alert(reasonCheckList[$(this).val()]);
          return $(this).val() === reasonCheckList[$(this).val()];
      }).attr("checked",true);
    })
  }
  // Landing Tab
  var decitionTab = "{!$Permission.Credit_Review_Start_on_Decision}";
  // Get Windo Height Width
  var w = window.innerWidth;
  var h = window.innerHeight;
  // Set the effect type
  var effect = 'slide';
  var fetchAttachmentAndNote = "{!$RemoteAction.CreditreViewScreenController.fetchNotesAndAttachments}";
  var saveNote = "{!$RemoteAction.CreditreViewScreenController.saveNotes}";
  var parentId = "{!$CurrentPage.parameters.id}";
  var acc = "{!creditReview.Opportunity__r.Account.name}";
  var account_name = acc;// unescape(escape(acc));
  var accLegal = "{!JSENCODE(creditReview.Opportunity__r.Account.Legal_Name__c)}";
  var accLegal_name = accLegal; //unescape(escape(accLegal));
  var accountId = "{!creditReview.Opportunity__r.Account.Id}";
  var creditReviewStatus = "{!creditReview.Status__c}";
  var secondReviewFrom = "{!creditReview.Second_Review_From__c}";
  var creditReviewType = "{!creditReview.Review_Type__c}";
  var userMaxApproval ="{!$User.WC_Approval_Authority__c}";
  var userFullName = "{!$user.firstname} {!$user.lastname}"; 
  var SyndicationRejectedByFullName = "{!creditReview.Syndication_Recommended_by__r.firstname} {!creditReview.Syndication_Recommended_by__r.lastname}";
  var rejectedByFullName = "{!creditReview.Rejected_by__r.firstname} {!creditReview.Rejected_by__r.lastname}"; 
  var approvedByFullName = "{!creditReview.ApprovedBy__r.firstname} {!creditReview.ApprovedBy__r.lastname}"; 
  var withdrawnByFullName = "{!creditReview.Withdrawn_By__r.firstname} {!creditReview.Withdrawn_By__r.lastname}"; 
  var approvedRecomendationByFullName = "{!creditReview.ApprovalRecomendationBy__r.firstname} {!creditReview.ApprovalRecomendationBy__r.lastname}"; 
  var userId = '{!$user.id}'; 
  // Set the options for the effect type chosen
  var options = { direction: 'right' };
  // Set the duration (default: 400 milliseconds)
  var duration = 500;
  //alert('{!creditReview.EXP_Business_Summary__r.status__c}');

  function fillApprove(){
    var v1 = "{!creditReview.Policy_Exception_Categories__c}";
    var v2 = "{!creditReview.Allowable_Exceptions__c}";
    var v3 = "{!creditReview.Strong_Mitigating_Factors__c}";
    var v1Arr = v1.split(';');
    var v2Arr = v2.split(';');
    var v3Arr = v3.split(';');
    var value1='';
    var value2='';
    var value3='';
    for(var i=0; i < v1Arr.length; i++){
      $('.PEC_Label input[type=Checkbox]').filter(function() {
          return $(this).val() === String(v1Arr[i]);
      }).attr("checked",true);
      value1+=v1Arr[i]+'<br/>';
    }
    for(var j=0; j < v2Arr.length; j++){
      $('.AE_Label input[type=Checkbox]').filter(function() {
          return $(this).val() === String(v2Arr[j]);
      }).attr("checked",true);
      value2+=v2Arr[j]+'<br/>';
    }
    for(var k=0; k < v3Arr.length; k++){
      $('.SMF_Label input[type=Checkbox]').filter(function() {
          return $(this).val() === String(v3Arr[k]);
      }).attr("checked",true);
      value3+=v3Arr[k]+'<br/>';
    }
    $('.policyExceptions').html(value1);
    $('.allowableExceptions').html(value2);
    $('.strongMitigatingFactors').html(value3);

    if(rejected_date != ''){
       var d4 = stringToDateTime(rejected_date);
        $('.rejected_on').text(formatDate(d4, true));
         $('.rejected_by').html('<a href="/{!creditReview.Rejected_by__c}" target="_blank">'+rejectedByFullName+'</a>');
      }
    if(Syndication_rejected_date != ''){
       var d5 = stringToDateTime(Syndication_rejected_date);
        $('.Syndication_rejected_on').text(formatDate(d5, true));
         $('.Syndication_rejected_by').html('<a href="/{!creditReview.Syndication_Recommended_by__c}" target="_blank">'+SyndicationRejectedByFullName+'</a>');
      }
    if(approved_by != ''){
      var d1 = stringToDateTime(approved_date);
      $('.submitted-date').text(formatDate(d1, true));
      $('.approved-by').html('<a href="/'+approved_by+'" target="_blank">'+approvedByFullName+'</a>');
    }
    if(withdrawn_by != ''){
      var d2 = stringToDateTime(withdrawn_date);
      $('.withdram-on').text(formatDate(d2, true));
      $('.withdram-by').html('<a href="/'+withdrawn_by+'" target="_blank">'+withdrawnByFullName+'</a>');
    }
    if(approvedRecomendationBy != ''){
      var d3 = stringToDateTime(approvedRecomendation_date);
      $('.submittedRecommended-date').text(formatDate(d3, true));
      $('.approvedRecommended-by').html('<a href="/'+approvedRecomendationBy+'" target="_blank">'+approvedRecomendationByFullName+'</a>');
    }
  }
  function setCookie(cname,cvalue,exdays) {
      var d = new Date();
      d.setTime(d.getTime() + (exdays*24*60*60*1000));
      var expires = "expires=" + d.toGMTString();
      document.cookie = cname+"="+cvalue+"; "+expires;
  }
  // Fill SSN Lookup Record 
  function fillSSNLookupRecord(){
      if("{!creditReview.PG1__r.Name}" != ''){
        $('#signor-contact_id').val("{!creditReview.PG1__c}");
        $('#signor-contact_name').val("{!creditReview.PG1__r.Name}");
        $('#signor-ownership').val("{!creditReview.PG1__r.Ownership_Percentage__c}");
        $('#signor-contact_ssn').val("{!creditReview.PG1__r.SSN_Encrypted__c}");
        $('#signor-ssn,#signor-ownership').removeAttr('disabled');
        if(pullCreditPermission =='true'){
          $('.pull1').removeAttr('disabled').addClass('permissionDeny'); 
        }
        var pg1Error='';
        if("{!creditReview.PG1__r.FirstName}" == '') pg1Error +='<li>First Name </li>'; 
        if("{!creditReview.PG1__r.LastName}" == '')  pg1Error +='<li>Last Name</li>';
        if("{!creditReview.PG1__r.SSN_Encrypted__c}" == '')  pg1Error +='<li>SSN Encrypted</li>';
        if('{!PG1Addresses.size}' =='0') pg1Error +='<li>An associated Home Address </li>';
        if(pg1Error != ''){
          $('.equifax1_error,.experian1_error').show().find('.error_area').html(pg1Error);
          $('.equifax1,.experian1').hide();
          
          $('.pull1').attr('disabled',true);
        }
      }
      if("{!creditReview.PG2__r.Name}" != ''){
        $('#guarantor2-contact_id').val("{!creditReview.PG2__c}");
        $('#guarantor2-contact_name').val("{!creditReview.PG2__r.Name}");
        $('#guarantor2-ownership').val("{!creditReview.PG2__r.Ownership_Percentage__c}");
        $('#guarantor2-contact_ssn').val("{!creditReview.PG2__r.SSN_Encrypted__c}");
        $('#gua2-ssn,#guarantor2-ownership').removeAttr('disabled');
        if(pullCreditPermission =='true')
           $('.pull2').removeAttr('disabled').addClass('permissionDeny'); 
        var pg2Error='';
        if("{!creditReview.PG2__r.FirstName}" == '') pg2Error +='<li>First Name </li>'; 
        if("{!creditReview.PG2__r.LastName}" == '')  pg2Error +='<li>Last Name</li>';
        if("{!creditReview.PG2__r.SSN_Encrypted__c}" == '')  pg2Error +='<li>SSN Encrypted</li>';
        if('{!PG2Addresses.size}' =='0') pg2Error +='<li>An associated Home Address </li>';
        if(pg2Error != ''){
          $('.equifax2_error,.experian2_error').show().find('.error_area').html(pg2Error);
          $('.equifax2,.experian2').hide();
          $('.pull2').attr('disabled',true);
        }
      }
      if("{!creditReview.PG3__r.Name}" != ''){
        $('#guarantor3-contact_id').val("{!creditReview.PG3__c}");
        $('#guarantor3-contact_name').val("{!creditReview.PG3__r.Name}");
        $('#guarantor3-ownership').val("{!creditReview.PG3__r.Ownership_Percentage__c}");
        $('#guarantor3-contact_ssn').val("{!creditReview.PG3__r.SSN_Encrypted__c}");
        $('#gua3-ssn,#guarantor3-ownership').removeAttr('disabled');
        if(pullCreditPermission =='true')
            $('.pull3').removeAttr('disabled').addClass('permissionDeny');  
        var pg3Error='';
        if("{!creditReview.PG3__r.FirstName}" == '') pg3Error +='<li>First Name </li>'; 
        if("{!creditReview.PG3__r.LastName}" == '')  pg3Error +='<li>Last Name</li>';
        if("{!creditReview.PG3__r.SSN_Encrypted__c}" == '')  pg3Error +='<li>SSN Encrypted</li>';
        if('{!PG3Addresses.size}' =='0') pg3Error +='<li>An associated Home Address </li>';
        if(pg3Error != ''){
          $('.equifax3_error,.experian3_error').show().find('.error_area').html(pg3Error);
          $('.equifax3,.experian3').hide();
          $('.pull3').attr('disabled',true);
        }
      }
   }
      
  function disabledEvents(creditStatus){
      if("{!$Permission.Modify_Completed_Credit_Reviews}" == 'false'){
          if ((creditStatus =='Approved' || creditStatus =='Second Review' || creditStatus =='Withdrawn' || creditStatus =='Declined') && unLockPermissionDeny == false){
              $('.disabledByZ-index,.unlockForm').show();
              $('.permissionDeny').attr('disabled','disabled');
              ModifyPermission = false;
              unLockPermissionDeny == false;
          }
          else {
              $('.disabledByZ-index,.unlockForm').hide();
              $('.permissionDeny').removeAttr('disabled');
              ModifyPermission = true;
              unLockPermissionDeny = true;
          }
      }
      if("{!$Permission.Credit_Review_Read_Only}" == 'true'){
          $('.disabledByZ-index,.unlockForm').show();
          $('.disabledByZ-index-decision').show();
          $('.permissionDeny').attr('disabled','disabled');
          ModifyPermission = false;
          unLockPermissionDeny == false;
     }

      // Deny permissions for experian credit pulls
      if("{!canPullExperian}" == 'true') {
        $('.permissionDenyExpPG').removeAttr('disabled');
        $('.permissionDenyExpBiz').removeAttr('disabled');
      } else {
        $('.permissionDenyExpPG').attr('disabled','disabled');
        $('.permissionDenyExpBiz').attr('disabled','disabled');
      }
  }
  function unlockCreditReviewForm(){
    $('.disabledByZ-index,.unlockForm').hide();
    $('.permissionDeny').removeAttr('disabled');
    ModifyPermission = true;
    unLockPermissionDeny = true;
  }
  function rebindGuarantorInformationValidation(){
    if($('#signor-contact_name').val() !='' && $('.pull1').attr('disabled') !== undefined){
      $('.equifax1,.experian1').hide();
    }
    if($('#guarantor2-contact_name').val() !='' && $('.pull2').attr('disabled') !== undefined){
      $('.equifax2,.experian2').hide();
    }
    if($('#guarantor3-contact_name').val() !='' && $('.pull3').attr('disabled') !== undefined){
      $('.equifax3,.experian3').hide();
    }
  }
  function callPage(){
     window.open("/apex/checklist?id="+parentId, "",'width='+w+'px,height='+h+'px');
  }
      
</script>
