        <script src="{!$Resource.functions}" />
        <script src="{!$Resource.creditpull}"></script>
        <!-- Style -->
        <c:CreditReviewScreenStyle />
    </head>



    <apex:form id="mainForm">

        <!-- General action function to refresh the view state of the controller.
        This is important because some of the "save" functions, such as for PGs, update the Credit Review via javascript remoting
        rather than explicitly using the view state. -->
        <apex:actionfunction name="refreshViewState" action="{!resetBusinessInformationRecord}" oncomplete="rebindDateFields()" />

        <!--
          Action Function to call on the Credit Review Screen Controller to refresh the PG Credit data in creditReview after a credit pull
          It will re-render all of the PG apex:outputPanel objects on the credit review screen
        -->
        <apex:actionFunction name="updatePGCredit" action="{!updatePGCredit}" reRender="pg1_left,pg2_left,pg3_left" oncomplete="rebindDateFields()"/>


        <!-- Action function to re-render a PG credit result panel (the small green box) -->

        <!--OLIVIA UPDATES - 7.9.18 -->
        <apex:actionFunction name="updatePG1EquifaxPanel" action="{!dataLoad}" reRender="pg1_credit_equifax,pg1_left"/>
        <apex:actionFunction name="updatePG2EquifaxPanel" action="{!dataLoad}" reRender="pg2_credit_equifax,pg2_left"/>
        <apex:actionFunction name="updatePG3EquifaxPanel" action="{!dataLoad}" reRender="pg3_credit_equifax,pg3_left"/>

        <apex:actionFunction name="updatePG1ExperianPanel" action="{!resetBusinessInformationRecord}" reRender="pg1_credit_experian,pg1_left"/>
        <apex:actionFunction name="updatePG2ExperianPanel" action="{!resetBusinessInformationRecord}" reRender="pg2_credit_experian,pg2_left"/>
        <apex:actionFunction name="updatePG3ExperianPanel" action="{!resetBusinessInformationRecord}" reRender="pg3_credit_experian,pg3_left"/>

        <apex:actionFunction name="updatePGCreditPanels" action="{!resetBusinessInformationRecord}"
                             reRender="pg1_credit_equifax,pg2_credit_equifax,pg3_credit_equifax,pg1_credit_experian,pg2_credit_experian,pg3_credit_experian"/>

        <apex:actionFunction name="reloadWholePage" action="{!reloadPage}" reRender="mainForm" />
        <apex:actionFunction name="Diamond" status="fetching" action="{!setReviewDiamond}" reRender="mainForm" />
        <apex:actionFunction name="Platinum"  status="fetching" action="{!setPlatinum}" reRender="mainForm" />
        <apex:actionFunction name="Gold"  status="fetching" action="{!setReviewGold}" reRender="mainForm" />
        <apex:actionFunction name="Commercial" status="fetching" action="{!setReviewCommercial}" reRender="mainForm" />
        <apex:actionFunction name="refreshDecision"  action="{!resetBusinessInformationRecord}" reRender="declineArea" oncomplete="declineChecked();declineOtherCheckbox()" />
        <apex:actionfunction name="reloadRecommended" action="{!resetBusinessInformationRecord}" oncomplete="refreshDecisionRecord()"/>
        <apex:actionfunction name="refreshDecisionRecord" action="{!refreshDecisionRecord}" oncomplete="rebindDateFields()" rerender="pg1_left,pg2_left,pg3_left,recommendId" />

        <apex:actionFunction name="reloadBusinessLoader" reRender="businessPull_EXP,businessDetailPanel,recommendId,decisionbusiness" action="{!resetBusinessInformationRecord}" oncomplete="disabledEvents(creditReviewStatus);clearBusinessLoading('experian');stopToClearValue();rebindDateFields();getBusinessCreditSummaryMark();makeBizReportAccordion('experian')"  />

        <apex:actionFunction name="LoadingIcon" status="fetching" reRender="businessPull_EXP,businessPull_EQF,businessDetailPanel,recommendId" />

