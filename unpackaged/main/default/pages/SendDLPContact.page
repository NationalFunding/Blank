<apex:page standardController="Account" extensions="SendDLPRequestContact" id="floMapPageId">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.0/jquery.min.js"></script>
    <apex:form id="formId">
        <apex:commandLink action="{!cancel}" value="<< Go Back"/>
            <apex:sectionHeader title="{!Account.Name}" subtitle="Send DLP Email and Drip Campaign" />
                <apex:pageMessages id="msgsId"/>
                    <apex:pageBlock >
                        <apex:pageBlockButtons location="bottom">
                            <apex:commandButton value="Save" action="{!SendEmail}"/>
                                </apex:pageBlockButtons>
                            <apex:pageBlockSection columns="4" title="Select Contacts: ">
                                <apex:pageBlockTable value="{!Contacts}" var="con">
                                    <apex:column ><apex:inputCheckbox id="looped" value="{!con.IsSelected}" onclick="uncheckOthers(this)"/></apex:column> <!--onclick="enableDisable(this)"-->
                                    <apex:column style="width: 150px;" headerValue="Name" value="{!con.Contact.Name}" />
                                        <apex:column headerValue="Email" style="width:250px">
                                            <apex:outputPanel styleClass="requiredInput" layout="block" rendered="{!con.Contact.Email==NULL}">
                                                <apex:outputPanel styleClass="requiredBlock" layout="block"/>
                                                    <apex:inputField value="{!con.Contact.Email}"
                                                    styleClass="requiredInput" />
                                                        </apex:outputPanel>
                                                    <apex:outputField value="{!con.Contact.Email}" rendered="{!con.Contact.Email!=NULL}"/>
                                                        </apex:column>
                                                    <apex:column headerValue="DLP Drip Email Status">
                                                        <apex:pageblockSection id="pbs1">

                                                            
                                                            
                                                            <apex:selectList size="1"  value="{!con.picklistdata}"  >
                                                                
                                                                <apex:selectOptions value="{!con.picklistFields}">
                                                                    </apex:selectOptions>
                                                                
                                                                </apex:selectList>
                                                                </apex:pageblockSection>
                                                                </apex:column>
                                                                </apex:pageBlockTable>
                                                                </apex:pageBlockSection>
                                                                </apex:pageBlock>
                                                                </apex:form>
                                                                
                                                                
                                                                <script type="text/javascript">
                                                                    function uncheckOthers(radio) {
                                                                    var name = radio.name.substring(radio.name.lastIndexOf(':'));
                                                                    var elements = radio.form.elements;
                                                                    for (var i = 0; i < elements.length; i++) {
                                                                        if (elements[i].name.substring(elements[i].name.lastIndexOf(':')) == name) {
                                                                            elements[i].checked = false;
                                                                        }
                                                                    }
                                                                    radio.checked = true;
                                                                }
                                                                
                                                                </script>
    
    
    <script>
    $(document).ready(function(){
        if($('input:checkbox').length  == 1){
            $('input:checkbox').attr('checked',true);
        }
    });
    </script>
</apex:page>