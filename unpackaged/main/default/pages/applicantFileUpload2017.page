<apex:page showheader="false" controller="vf_applicantFileUpload" standardStylesheets="false">
    
    <apex:stylesheet value="{!URLFOR($Resource.visualforce_uploads, 'css/bootstrap.min.css')}"/>
    
    
    <head>
        <meta charset="utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
    <title>National Funding Document Upload</title>
        <meta name="description" content="Document Uploads into Salesforce for National Funding"/>
        <link rel="shortcut icon" href="//wp.natfundcdn.com/static/img/favicon.png"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
  

    <style>
        @font-face {
            font-family: 'BrandonTextWeb-Regular';
            src: url("{!URLFOR($Resource.visualforce_uploads, 'fonts/3217CA_1_0.eot')}"), url("{!URLFOR($Resource.visualforce_uploads, 'fonts/3217CA_1_0.eot?#iefix')}") format('embedded-opentype'), url("{!URLFOR($Resource.visualforce_uploads, 'fonts/3217CA_1_0.woff2')}") format('woff2'), url("{!URLFOR($Resource.visualforce_uploads, 'fonts/3217CA_1_0.woff')}") format('woff'), url("{!URLFOR($Resource.visualforce_uploads, 'fonts/3217CA_1_0.ttf')}") format('truetype');
        }

        html,
        body {
          height: 100%;
        }

        body {
            font-family: 'BrandonTextWeb-Regular', BrandonText, Tahoma, sans-serif;
            color: #223657;
        }

        a, a:hover, a:active, a:focus {
            color: #eb8243;
        }


        .btn-primary, .btn-primary:hover, .btn-primaary:active, .btn-primary:focus {
            background-color: #eb8243;
            border-color: #eb8243;
        }

        .btn-primary[disabled] {
            background-color: #eb8243;
            border-color: #eb8243;
        }


        .navbar-brand {
            padding: 0;
        }

        .phone {
            font-size: 18px;
            color: #eb8243 !important;
        }

        /* Wrapper for page content to push down footer */
        #wrap {
          height: auto !important;
          
          /* Negative indent footer by it's height */
          margin: 0 auto;
        }

        .content-container {
            padding-top: 70px;
        }

        .btn-file {
            position: relative;
            overflow: hidden;
        }
        .btn-file input[type=file] {
            position: absolute;
            top: 0;
            right: 0;
            min-width: 100%;
            min-height: 100%;
            font-size: 100px;
            text-align: right;
            filter: alpha(opacity=0);
            opacity: 0;
            outline: none;
            background: white;
            cursor: inherit;
            display: block;
        }


        /* Footer CSS */
        /* Set the fixed height of the footer here */
        #push {
          height: 278px;
        }
        /* Lastly, apply responsive CSS fixes as necessary */
        @media (max-width: 767px) {
          #footer {
            margin-left: -20px;
            margin-right: -20px;
            padding-left: 20px;
            padding-right: 20px;
          }
        
        }
.trust {
  background: #223657;
  padding: 8px 0 0 0;
  text-align: center; }
  .trust span {
    display: inline-block;
    height: 55px;
    margin: 0 40px;
    background: url("{!URLFOR($Resource.visualforce_uploads, 'img/partners.png')}") no-repeat center;
    background-size: 191px; }
    .trust span.bbb {
      background-position: 0 0;
      width: 191px; }
    .trust span.elfa {
      background-position: center -55px;
      width: 191px; }
    .trust span.docusign {
      background-position: center -110px;
      width: 191px; }
    .trust span.inc {
      background-position: center -165px;
      width: 191px; }

@media (max-width: 545px) {
  .trust span {
    margin: 0 3px; } }

.sponsorships {
  background: #ffffff;
  display: block;
  text-align: center;
  position: relative;
  padding: 0; }
  .sponsorships h4.title {
    color: #223657; }
  .sponsorships .sponsorship-description a {
    color: #223657;
    text-decoration: underline;
    font-weight: bold; }
  .sponsorships span {
    display: inline-block;
    position: relative; } 
    .sponsorships span[data-icon='chargers'] {
      background: url("{!URLFOR($Resource.visualforce_uploads, 'img/chargers-small.png')}") no-repeat left center;
      padding: 40px 0 40px 100px; }
    .sponsorships span[data-icon='padres'] {
      background: url("{!URLFOR($Resource.visualforce_uploads, 'img/padres-small.png')}") no-repeat left center;
      padding: 40px 0 40px 100px; }
    .sponsorships span[data-icon='usc'] {
      background: url("{!URLFOR($Resource.visualforce_uploads, 'img/usc-small.png')}") no-repeat left center;
      padding: 40px 0 40px 77px; }
    .sponsorships span[data-icon='holiday'] {
      background: url("{!URLFOR($Resource.visualforce_uploads, 'img/holiday_bowl-small.png')}") no-repeat left center;
      padding: 40px 0 40px 100px; }

        .footer-bottom {
  background-color: #eb8243;
  color: #ffffff;
  font-family: "BrandonTextWeb-Bold", BrandonText, Tahoma, sans-serif;
  font-size: 14px;
  text-align: center;
  padding: 1.25rem 0; 
  }
  .footer-bottom a {
    color: #ffffff !important; }

@media screen and (min-width: 640px) {
  .footer-bottom .copyright {
    text-align: left; }
  .footer-bottom .subfooter-nav {
    text-align: right; } 
        
    </style>
</head>
