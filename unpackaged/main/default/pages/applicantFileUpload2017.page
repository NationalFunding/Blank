<div style="display: none">DEBUG: invalidSource: {!invalidSource}; source: {!source}; ParentId: {!parentId}; ProductType: {!productType}; File Selected: {!fileSelected}; File: {!File.name};</div>
    <nav id="nf-navbar" class="navbar navbar-default navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span> 
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="https://www.nationalfunding.com">
                    <img src="{!URLFOR($Resource.visualforce_uploads, 'img/logo_horizontal.png')}" width="263" height="50"/>
                </a>
            </div>
            <div id="navbar" class="navbar-collapse collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li><a class="phone" href="tel:8887332383"><span class="glyphicon glyphicon-earphone"></span>&nbsp;888.733.2383</a></li>
                </ul>
            </div>
            <!--/.nav-collapse -->
        </div>
    </nav>
    
    <div id="wrap" class="content-container container">
        <!-- Example row of columns -->
        <div class="row">
            <div class="col-md-12">
                <apex:outputText rendered="{!invalidSource}">
                    <h1>Something went wrong!</h1>
                    <p>Very strange that you reached this page.  Please get the proper link from your e-mail or call us directly at 888-733-2383 for assistance.<br />&nbsp;<br />&nbsp;</p>
                </apex:outputText>
                <apex:outputText rendered="{!invalidSource == false}">
                    <apex:outputPanel rendered="{!fileSelected}">
                        <h2>{!file.Name}</h2>
                        <p>{!file.Description__c}</p>
                        <apex:form >
                            <p><apex:inputFile value="{!fileContents}" fileName="{!fileName}" /></p>
                            <p><apex:commandButton id="upload-file" styleClass="upload-file btn-primary btn" value="Upload Selected File" action="{!fileUploaded}" /></p>
                            <p>&nbsp;</p>
                            <p>&nbsp;</p>
                        </apex:form>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!fileSelected == false}">
                        <apex:outputText rendered="{!CheckUploadSuccess}">
                            <div class="alert alert-success" role="alert">Success!  Your file was uploaded.  To upload more documents, please select the type of document you would like to upload.</div>
                        </apex:outputText>
                        <h2>Upload Your Documents</h2>
                        <apex:repeat value="{!fileTypes}" var="ft">
                            <h2><apex:outputLink value="/appupload2017?source={!source}&file={!ft.id}">{!ft.Name}</apex:outputLink></h2>
                            <p>{!ft.Description__c}</p>
                        </apex:repeat>
                        <h2>Most Recent File Uploaded</h2>
                        <p>
                            <apex:outputText rendered="{!FilesHaveBeenUploaded == false}"><b>No files have been uploaded this session.</b></apex:outputText>
                            <apex:repeat var="filename" value="{!filesUploaded}">{!filename}<br /></apex:repeat></p>
                        <p><b>Note:</b> Please select which type of document you are uploading.  You may upload multiple files for each type of document.<br />Please contact us directly if you are unsure what files are remaining to be uploaded.</p>
                        <p>&nbsp;</p>
                            <p>&nbsp;</p>
                    </apex:outputPanel>
                </apex:outputText>
            </div>
        </div>
    </div>
 <footer id="footer">
            <div class="trust">
                <span class="bbb" title="BBB Accredited Business"></span>
                <span class="elfa" title="ELFA"></span>
                <span class="docusign" title="DocuSign"></span>
                <span class="inc" title="Inc. 5000"></span>
            </div>
            <div class="sponsorships text-center" style="display:none">
                <div class="container">
                    <div class="row">
                        <div class="col-xs-12">
                            <h4 class="title"><strong>Proud Sponsorships</strong></h4>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-12">
                            <p class="sponsorship-description">We're in a league of our own. <a href="https://www.nationalfunding.com/about-us/sponsorships/" target="_blank">Find out more.</a></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-6 col-sm-6 col-md-3">
                            <span data-icon="chargers"></span>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-3">
                            <span data-icon="padres"></span>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-3">
                            <span data-icon="usc"></span>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-3">
                            <span data-icon="holiday"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="container">
                    <div class="row">
                        <div class="col-xs-12 col-md-6 copyright">© 2017 National Funding. All rights reserved.</div>
                        <div class="col-xs-12 col-md-6 subfooter-nav">
                            <a href="https://www.nationalfunding.com/terms-conditions/" target="_blank">Terms &amp; Conditions</a>  <a href="https://www.nationalfunding.com/privacy-policy/" target="_blank">Privacy Policy</a>    <a href="https://www.nationalfunding.com/sitemap/" target="_blank">Sitemap</a>
                    </div>
                    </div>
            </div>
        </div>
    </footer>
    <!-- /container -->
</apex:page>