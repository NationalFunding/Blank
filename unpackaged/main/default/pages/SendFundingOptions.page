<apex:page id="SendFundingOptions" standardController="Opportunity" extensions="SendFundingOptionsController">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.0/jquery.min.js"></script>
    <apex:form id="formId">
        <apex:commandLink action="{!cancel}" value="<< Go Back"/>
        <apex:sectionHeader title="{!Opportunity.Name}" subtitle="Send Funding Email" />
        <apex:pageMessages />
        <apex:pageBlock >
            <apex:pageBlockButtons location="bottom">
                <apex:commandButton value="Send" action="{!SendEmail}"/>
            </apex:pageBlockButtons>
            <apex:pageBlockSection columns="4" title="Select Contact: ">
                <apex:pageBlockTable value="{!contactList}" var="con">
                    <apex:column ><apex:inputCheckbox id="looped" value="{!con.IsSelected}" onclick="uncheckOthers(this)"/></apex:column>
                    <apex:column style="width: 150px;" headerValue="Name" value="{!con.theContact.Name}" />
                    <apex:column headerValue="Email" style="width:250px">
                        <apex:outputPanel styleClass="requiredInput" layout="block" rendered="{!con.theContact.Email==NULL}">
                            <apex:outputPanel styleClass="requiredBlock" layout="block"/>
                            <apex:inputField value="{!con.theContact.Email}" styleClass="requiredInput" />
                        </apex:outputPanel>
                        <apex:outputField value="{!con.theContact.Email}" rendered="{!con.theContact.Email!=NULL}"/>
                    </apex:column>
                </apex:pageBlockTable>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>


    <script type="text/javascript">
        function uncheckOthers(radio) {
            var name = radio.name.substring(radio.name.lastIndexOf(':'));
            var elements = radio.form.elements;
            for (var i = 0; i < elements.length; i++) {
                if (elements[i].name.substring(elements[i].name.lastIndexOf(':')) == name) {
                    elements[i].checked = false;
                }
            }
            radio.checked = true;
        }
    </script>


    <script>
    $(document).ready(function(){
        if($('input:checkbox').length  == 1){
            $('input:checkbox').attr('checked',true);
        }
    });
    </script>
</apex:page>