    <formulas>
        <name>F_FormatPhoneNumber</name>
        <dataType>String</dataType>
        <expression>&quot;+1&quot; + SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE({!Var_MobilePhone}, &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;), &quot; &quot;, &quot;&quot;), &quot;-&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>F_RemoveCommas</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(TEXT({!Get_Generic_Number.Generic_Number__c}), &quot;,&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>F_UnformattedNumber</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE({!Var_MobilePhone}, &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;), &quot; &quot;, &quot;&quot;), &quot;-&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>F_UniqueId</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE({!Var_MobilePhone}, &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;), &quot; &quot;, &quot;&quot;), &quot;-&quot;, &quot;&quot;) + {!Get_Opt_In_Key_Words.Id}</expression>
    </formulas>
    <formulas>
        <name>formula_DLP_Brand</name>
        <dataType>String</dataType>
        <expression>IF({!var_brand}=&apos;Quick Bridge&apos;, &apos;QuickBridge Funding&apos;, &apos;National Funding&apos;)</expression>
    </formulas>
    <formulas>
        <name>formula_remove_commas_QB</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(TEXT({!Get_Generic_Number_QB.Generic_Number_QB__c}), &quot;,&quot;, &quot;&quot;)</expression>
    </formulas>
