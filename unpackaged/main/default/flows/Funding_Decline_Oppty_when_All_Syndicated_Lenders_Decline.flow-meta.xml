    <start>
        <locationX>268</locationX>
        <locationY>234</locationY>
        <connector>
            <targetReference>Get_Funding_Records</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(        
    ISPICKVAL({!$Record.Status__c}, &apos;Declined&apos;),
    {!$Record.Opportunity__r.IsClosed} = FALSE,
    OR(
        AND(
            NOT(ISPICKVAL({!$Record.Opportunity__r.Type}, &apos;New&apos;)),
            OR(
                {!$Record.Opportunity__r.RecordType.DeveloperName} = &apos;MCA_Oppty&apos;,
                {!$Record.Opportunity__r.RecordType.DeveloperName} = &apos;FRPSA&apos;,
                {!$Record.Opportunity__r.RecordType.DeveloperName} = &apos;Broker_FRPSA&apos;,
                {!$Record.Opportunity__r.RecordType.DeveloperName} = &apos;Broker_WC_Oppty&apos;
            )
        ),
        AND(
            ISPICKVAL({!$Record.Opportunity__r.Type}, &apos;New&apos;),
            NOT(CONTAINS({!$Record.Lender_ID__r.Name}, &apos;National Funding&apos;)),
            NOT(CONTAINS({!$Record.Lender_ID__r.Name}, &apos;Quick Bridge&apos;)),
            NOT(CONTAINS({!$Record.Lender_ID__r.Name}, &apos;MLP&apos;))
        )
    )
)</filterFormula>
        <object>FPC_Funding_del__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
