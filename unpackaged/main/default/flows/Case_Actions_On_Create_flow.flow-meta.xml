    <decisions>
        <name>Trigger_Chargeoff_Drip</name>
        <label>Trigger Chargeoff Drip?</label>
        <locationX>710</locationX>
        <locationY>792</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Trigger_Drip</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Customer_Last_In_Touch_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Customer_Last_In_Touch_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>formula_last60Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Last_Payment_Made_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>formula_last30days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Trigger_CO_Drip</targetReference>
            </connector>
            <label>Trigger Drip</label>
        </rules>
    </decisions>
    <description>Last Update: 3/26/2025 - BAU-462, commit account update before trigger CO drip to prevent timing issue
+add check for payment within last 30 days for CO drip trigger path (PD-4478)</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_last30days</name>
        <dataType>Date</dataType>
        <expression>TODAY()-30</expression>
    </formulas>
    <formulas>
        <name>formula_last60Days</name>
        <dataType>Date</dataType>
        <expression>TODAY()-60</expression>
    </formulas>
    <formulas>
        <name>formulaCollectionStage</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Product__c}=&quot;FRPSA&quot;,
&quot;FRPSA- Charge Off&quot;,
&quot;Charge Off&quot;)</expression>
    </formulas>
