    <formulas>
        <name>formBankVerification</name>
        <dataType>Boolean</dataType>
        <expression>IF(
  AND(
    OR({!varOpptyRecordType}=&quot;Broker WC Oppty&quot;, {!varOpptyRecordType}=&quot;Working Capital Oppty&quot;),
{!varOpptyType}=&quot;NEW&quot;,
{!varAmountDocd}&gt;100000
   ), TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>formBenOwnerRequired</name>
        <dataType>Boolean</dataType>
        <expression>IF(
  AND(
    {!varBofiState} = &apos;Allowed&apos;,
    {!varOpptyLegalStatus} != &apos;Sole Proprietor&apos;
   ), TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>formBlanketUcc</name>
        <dataType>Boolean</dataType>
        <expression>IF({!varBlanketUcc} = True, True, False)</expression>
    </formulas>
    <formulas>
        <name>formDealReview</name>
        <dataType>Boolean</dataType>
        <expression>IF(
  AND(
          {!varOpptyRecordType}=&quot;Broker WC Oppty&quot;,
          {!varOpptyType}=&quot;NEW&quot;,
          {!varAmountDocd}&gt;50000
         ), TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>formIdAnalyticsValue</name>
        <dataType>Boolean</dataType>
        <expression>IF({!varOpptyType} = &apos;NEW&apos;, TRUE, {!varMCIdAnalytics})</expression>
    </formulas>
    <formulas>
        <name>formMtdRequiredDof</name>
        <dataType>Boolean</dataType>
        <expression>IF({!varMTDrequiredDoF} = True, True, False)</expression>
    </formulas>
    <formulas>
        <description>The label name of this field is UCC Search (N).  The API name is UCC_Search_50K_N__c.</description>
        <name>formUCCSearch50KN</name>
        <dataType>Boolean</dataType>
        <expression>IF(
OR(CONTAINS({!varOpptyRecordType},&quot;Broker&quot;),{!varAmountDocd}&gt;=50000), True, False)</expression>
    </formulas>
    <formulas>
        <name>formulaRenewal</name>
        <dataType>Boolean</dataType>
        <expression>IF(
OR(
{!varOpptyType}=&apos;RENEWAL&apos;,
{!varOpptyType}=&apos;RENEWAL CONCURRENT&apos;
),
TRUE, 
FALSE
)</expression>
    </formulas>
    <formulas>
        <name>formWelcomeCallN</name>
        <dataType>Boolean</dataType>
        <expression>IF({!varOpptyRecordType}=&quot;Broker WC Oppty&quot;, True, False)</expression>
    </formulas>
