    <description>+broker refresh case due date assignment</description>
    <formulas>
        <name>formIsPrimaryContact</name>
        <dataType>String</dataType>
        <expression>IF({!ContactCollection.Isprimary__c}=TRUE,&quot;Signor&quot;,&quot;Other&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaBrokerRefreshStatus</name>
        <dataType>String</dataType>
        <expression>CASE({!Case_Type},
&quot;Broker Refresh&quot;, &quot;Broker Refresh Pending&quot;, 
&quot;Bank Change&quot;, &quot;Bank Change Requested&quot;,&quot;&quot;
 )</expression>
    </formulas>
    <formulas>
        <name>formulaDueDate</name>
        <dataType>Date</dataType>
        <expression>If({!Case_Type}=&quot;Broker Refresh&quot;, {!lookUpAccount.Broker_Refresh_Due__c}, DATEVALUE(&quot;&quot;))</expression>
    </formulas>
