    <decisions>
        <description>DLP Opted - In SMS Messages</description>
        <name>DLP_Opted_In_SMS_Messages</name>
        <label>DLP Opted - In SMS Messages</label>
        <locationX>248</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Mobile_Phone_is_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FALSE_DLP Opted - In SMS Messages</defaultConnectorLabel>
        <rules>
            <name>TRUE_DLP_Opted_In_SMS_Messages</name>
            <conditionLogic>(1 AND 2 AND 3 AND 4 AND (5 OR 6)) OR (2 AND 3 AND 4 AND 6 AND 7)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SMS_Opt_In__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SMS_Opt_In__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MobilePhone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SMS_Opt_Out__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LastModifiedById</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varUserId_NFCreditAPI</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LastModifiedById</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varUserId_NFAutomationUser</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Formula_LeadIsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opt_In_Date</targetReference>
            </connector>
            <label>TRUE DLP Opted - In SMS Messages</label>
        </rules>
    </decisions>
    <decisions>
        <description>Mobile Phone is Changed</description>
        <name>Mobile_Phone_is_Changed</name>
        <label>Mobile Phone is Changed</label>
        <locationX>446</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>FALSE_Mobile Phone is Changed</defaultConnectorLabel>
        <rules>
            <name>TRUE_Mobile_Phone_is_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMobileFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_SMS_Values</targetReference>
            </connector>
            <label>TRUE Mobile Phone is Changed</label>
        </rules>
    </decisions>
    <description>Last Update: 6/1/2025 Removed subflow element and moved to the Customer Event - SMS Opt In flow
4/28/2025, BAU-469, Added condition to check for new leads
This flow is used to send Opt In message for lead whenever SMS -Opt In is changed from false to true</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_LeadIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>varMobileFormula</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE(PRIORVALUE({!$Record.MobilePhone}), &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;), &quot; &quot;, &quot;&quot;), &quot;-&quot;, &quot;&quot;) != SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE({!$Record.MobilePhone}, &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;), &quot; &quot;, &quot;&quot;), &quot;-&quot;, &quot;&quot;),
    NOT(ISBLANK({!$Record.MobilePhone}))
)</expression>
    </formulas>
    <interviewLabel>Lead - SMS Opt-Ins {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - SMS Opt-Ins</label>
