    <decisions>
        <name>Broker_Early_Bounce</name>
        <label>Broker Early Bounce?</label>
        <locationX>1150</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Early_Bounce</name>
            <conditionLogic>5 AND 6 AND 7 AND 8 AND 9 AND ((1 AND 4) OR (2 AND 3)) AND 10</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Actual_Payment_Frequency__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Weekly</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Actual_Payment_Frequency__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Daily</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Payments_Collected__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Setup.Case_Custom_Settings__c.Broker_Daily_Early_Bounce_Limit__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Payments_Collected__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Setup.Case_Custom_Settings__c.Broker_Weekly_Early_Bounce_Limit__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Broker_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formIsQuickBridgeBroker</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_Bounce_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Internal_Funding_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Loan Write-off</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Termination_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formula_internalbroker</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_Creation</targetReference>
            </connector>
            <label>Early Bounce</label>
        </rules>
    </decisions>
