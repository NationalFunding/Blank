    <formulas>
        <name>formCaseSubject</name>
        <dataType>String</dataType>
        <expression>{!$Record.Opportunity__r.Legal_Name__c} &amp; &apos;-&apos; &amp; {!formulaLoanNumber} &amp; &apos;-&apos; &amp; {!conBrokerComRet}</expression>
    </formulas>
    <formulas>
        <name>formIsQuickBridgeBroker</name>
        <dataType>Boolean</dataType>
        <expression>IF(
CONTAINS({!$Record.Opportunity__r.Broker_Account__r.Name},&quot;Quick Bridge Funding&quot;),
TRUE,
FALSE)</expression>
    </formulas>
    <formulas>
        <name>formula_internalbroker</name>
        <dataType>Boolean</dataType>
        <expression>IF (
OR (
CONTAINS(UPPER({!$Record.Opportunity__r.Broker_Account__r.Name}), &quot;NATIONAL FUNDING&quot;),
CONTAINS(UPPER({!$Record.Opportunity__r.Broker_Account__r.Name}), &quot;QUICK BRIDGE&quot;)
), TRUE, FALSE
)</expression>
    </formulas>
    <formulas>
        <name>formulaCollectionStage</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK({!$Record.Collections_Stage__c})),
  {!$Record.Collections_Stage__c},
   IF({!$Record.Product__c}=&quot;FRPSA&quot;,&quot;FRPSA - Paying&quot;,
&quot;Paying&quot;
))</expression>
    </formulas>
    <formulas>
        <name>formulaCollectionStatus</name>
        <dataType>String</dataType>
        <expression>IF(
 NOT(ISBLANK({!$Record.Collections_Status_Account__c})),
 {!$Record.Collections_Status_Account__c},
    IF({!$Record.Product__c}=&quot;FRPSA&quot;, 
&quot;Paying&quot;,
&quot;Current&quot;
))</expression>
    </formulas>
    <formulas>
        <name>formulaLoanNumber</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!$Record.Opportunity__r.Merchant_Number__c}),
{!$Record.Opportunity__r.Lease_Number__c},
{!$Record.Opportunity__r.Merchant_Number__c}
)</expression>
    </formulas>
    <formulas>
        <name>formulaNextBusinessDay</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!varNextBusinessDay}))&amp;&quot;/&quot;&amp;TEXT(DAY({!varNextBusinessDay}))&amp;&quot;/&quot;&amp;TEXT(YEAR({!varNextBusinessDay}))</expression>
    </formulas>
    <formulas>
        <name>formulaReturnPaymentTypeUpper</name>
        <dataType>String</dataType>
        <expression>UPPER({!$Record.Returned_Payment_Type__c})</expression>
    </formulas>
    <formulas>
        <name>formulaSumNote</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!$Record.Sum_Note__c}),
&quot;RR&quot;,
{!$Record.Sum_Note__c})</expression>
    </formulas>
