    <formulas>
        <name>formula_deal_origination</name>
        <dataType>String</dataType>
        <expression>IF(
	AND(
		CONTAINS({!WC_Credit_Decision.Credit_Review__r.Deal_Origination__c}, &apos;Broker&apos;),
		NOT(CONTAINS({!WC_Credit_Decision.Credit_Review__r.Opportunity__r.Broker_Account__r.Name}, &apos;Quick Bridge&apos;))
		),
	&apos;Broker&apos;,
	&apos;Direct&apos;
	)</expression>
    </formulas>
    <formulas>
        <name>formulaExitPath</name>
        <dataType>String</dataType>
        <expression>IF(
	{!varAutoDeclineUsed}=TRUE,
	&apos;CMR.5&apos;,
	IF(
		AND(
			{!formulaHasDeclineReason} = FALSE,
			{!formulaHasModelReviewDecline} = FALSE
			),
		&apos;CMR.1&apos;,
		IF(
			AND(
				{!formulaHasDeclineReason} = TRUE,
				{!formulaHasModelReviewDecline} = FALSE
				),
			&apos;CMR.2&apos;,
			IF(
				AND(
					{!formulaHasDeclineReason} = FALSE,
					{!formulaHasModelReviewDecline} = TRUE
					), 
				&apos;CMR.3&apos;,
				IF(
					AND(
						{!formulaHasDeclineReason} = TRUE,
						{!formulaHasModelReviewDecline} = TRUE
						), 
					&apos;CMR.4&apos;,
					null
					)
				)
			)
		)
	)</expression>
    </formulas>
    <formulas>
        <name>formulaHasDeclineReason</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!WC_Credit_Decision.Model_Decline_Reasons__c}))</expression>
    </formulas>
    <formulas>
        <name>formulaHasModelReviewDecline</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!WC_Credit_Decision.WC_Decision_Recommendation__c}, &quot;Model Review&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaIsDirectDeal</name>
        <dataType>Boolean</dataType>
        <expression>{!WC_Credit_Decision.Credit_Review__r.Opportunity__r.RecordType.DeveloperName} = &quot;MCA_Oppty&quot;</expression>
    </formulas>
    <formulas>
        <name>formulaNoDecision</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!WC_Credit_Decision.WC_Decision_Recommendation__c})</expression>
    </formulas>
    <formulas>
        <name>formulaResult</name>
        <dataType>String</dataType>
        <expression>CASE(
{!varExitPath},
&apos;CMR.1&apos;, &apos;Continue&apos;,
&apos;CMR.2&apos;, &apos;Stop&apos;,
&apos;CMR.3&apos;, &apos;Stop&apos;,
&apos;CMR.4&apos;, &apos;Stop&apos;,
&apos;CMR.5&apos;, &apos;Stop&apos;,
&apos;CMR.Error1&apos;, &apos;Manual Review&apos;,
&apos;Error&apos;)</expression>
    </formulas>
