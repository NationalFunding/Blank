<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <assignments>
        <name>Assign_Principal_Consumer_Risk_Summary</name>
        <label>Assign Principal Consumer Risk Summary</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Principal_Consumer_Risk_Summary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Principal_Consumer_Risk_Summary_Formula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Populates Principal Consumer Risk Summary when Opportunity Contact Roles are created or edited.
Scenarios where a new Consumer Risk Summary after one has already been set on the Opportunity Contact Role, but before the Opportunity is submitted to UW are handled in the &quot;Consumer Risk Summary - Set Principal Consumer Risk Summary&quot; flow.
CRD-194</description>
    <environments>Default</environments>
    <formulas>
        <name>Principal_Consumer_Risk_Summary_Formula</name>
        <dataType>String</dataType>
        <expression>IF(
	ISBLANK({!$Record.Contact.Principal_Consumer_Risk_Summary__c}),
	&apos;&apos;,
	{!$Record.Contact.Principal_Consumer_Risk_Summary__c}
)</expression>
    </formulas>
    <interviewLabel>Opportunity Contact Role - Set Principal Consumer Risk Summary {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Contact Role - Set Principal Consumer Risk Summary</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Principal_Consumer_Risk_Summary</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.ContactId})) &amp;&amp;
(ISNEW() || ISCHANGED({!$Record.ContactId}))</filterFormula>
        <object>OpportunityContactRole</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
