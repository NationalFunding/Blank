    <decisions>
        <name>Compare_Record_Type_with_Product</name>
        <label>Compare Record Type with Product</label>
        <locationX>236</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>Get_Record_Types</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Matched</defaultConnectorLabel>
        <rules>
            <name>RT_Matched_UW_Product</name>
            <conditionLogic>(1 AND (2 OR 3)) OR (4 AND (5 OR 6)) OR (7 AND 8)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Funding__r.UW_Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Working Capital</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_opptyrecordtype_devname</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MCA_Oppty</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_opptyrecordtype_devname</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Broker_WC_Oppty</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Funding__r.UW_Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FRPSA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_opptyrecordtype_devname</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FRPSA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_opptyrecordtype_devname</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Broker_FRPSA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Funding__r.UW_Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MLP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_opptyrecordtype_devname</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Direct_MLP</stringValue>
                </rightValue>
            </conditions>
            <label>RT Matched UW Product</label>
        </rules>
    </decisions>
