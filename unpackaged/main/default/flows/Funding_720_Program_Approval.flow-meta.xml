    <apiVersion>52.0</apiVersion>
    <assignments>
        <name>Add_Emails_to_Collection_Variable</name>
        <label>Add Emails to Collection Variable</label>
        <locationX>50</locationX>
        <locationY>455</locationY>
        <assignmentItems>
            <assignToReference>varEmailAddresses</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Opportunity__r.Owner.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varEmailAddresses</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Opportunity__r.Owner.Manager.Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>X720_Program_Approval_Email_Alert</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Pricing_Definition_is_Direct_FICO_720</name>
        <label>Pricing Definition is Direct - FICO 720+ And Lender is NF</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X720_Program</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Definition__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Direct - FICO 720+</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lender_ID__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>National Funding</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Emails_to_Collection_Variable</targetReference>
            </connector>
            <label>720 Program And Lender is NF</label>
        </rules>
    </decisions>
    <description>Email Alert to Opportunity Owner and their Manager when a funding record is approved and is part of the 720+ program and Lender is NF</description>
    <interviewLabel>Funding - 720+ Program Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Funding - 720+ Program Approval</label>
    <processMetadataValues>
