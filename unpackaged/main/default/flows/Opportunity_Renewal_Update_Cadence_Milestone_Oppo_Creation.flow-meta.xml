    <description>PD-4602 - Converted from the &quot;Renewals - Engagement Cadence&quot; process builder

Last Update: 5/12/2025 SPR-319 Removed autoamtion for setting the Next Activity Date
5/10/2024 - PD-4759, change cadence day type to calendar days</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_AddCadenceDays</name>
        <dataType>Date</dataType>
        <expression>IF({!var_DayType}=&apos;Business Days&apos;, {!formula_WorkdayAfterAdding}, {!$Record.Last_Activity_Date__c} + {!var_DaysToAdd})</expression>
    </formulas>
    <formulas>
        <name>formula_EligibleDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Balance_Paid_100_Percent_Date__c} + 30</expression>
    </formulas>
    <formulas>
        <description>The weekday after adding var_DaysToAdd to Last_Activity_Date__c</description>
        <name>formula_WorkdayAfterAdding</name>
        <dataType>Date</dataType>
        <expression>CASE(
    MOD(IF(OR(ISBLANK({!$Record.Last_Activity_Date__c}),TODAY() &gt; {!$Record.Last_Activity_Date__c}),TODAY(),{!$Record.Last_Activity_Date__c}) - DATE(1900, 1, 7), 7),
    0, (IF(OR(ISBLANK({!$Record.Last_Activity_Date__c}),TODAY() &gt; {!$Record.Last_Activity_Date__c}),TODAY(),{!$Record.Last_Activity_Date__c})) + ({!var_DaysToAdd}) + FLOOR((({!var_DaysToAdd})-1)/5)*2,
    1, (IF(OR(ISBLANK({!$Record.Last_Activity_Date__c}),TODAY() &gt; {!$Record.Last_Activity_Date__c}),TODAY(),{!$Record.Last_Activity_Date__c})) + ({!var_DaysToAdd}) + FLOOR((({!var_DaysToAdd}))/5)*2,
    2, (IF(OR(ISBLANK({!$Record.Last_Activity_Date__c}),TODAY() &gt; {!$Record.Last_Activity_Date__c}),TODAY(),{!$Record.Last_Activity_Date__c})) + ({!var_DaysToAdd}) + FLOOR((({!var_DaysToAdd})+1)/5)*2,
    3, (IF(OR(ISBLANK({!$Record.Last_Activity_Date__c}),TODAY() &gt; {!$Record.Last_Activity_Date__c}),TODAY(),{!$Record.Last_Activity_Date__c})) + ({!var_DaysToAdd}) + FLOOR((({!var_DaysToAdd})+2)/5)*2,
    4, (IF(OR(ISBLANK({!$Record.Last_Activity_Date__c}),TODAY() &gt; {!$Record.Last_Activity_Date__c}),TODAY(),{!$Record.Last_Activity_Date__c})) + ({!var_DaysToAdd}) + FLOOR((({!var_DaysToAdd})+3)/5)*2,
    5, (IF(OR(ISBLANK({!$Record.Last_Activity_Date__c}),TODAY() &gt; {!$Record.Last_Activity_Date__c}),TODAY(),{!$Record.Last_Activity_Date__c})) + ({!var_DaysToAdd}) + CEILING((({!var_DaysToAdd}))/5)*2,
    6, (IF(OR(ISBLANK({!$Record.Last_Activity_Date__c}),TODAY() &gt; {!$Record.Last_Activity_Date__c}),TODAY(),{!$Record.Last_Activity_Date__c})) - IF(({!var_DaysToAdd})&gt;0,1,0) + ({!var_DaysToAdd}) + CEILING(({!var_DaysToAdd})/5)*2,
null)</expression>
    </formulas>
