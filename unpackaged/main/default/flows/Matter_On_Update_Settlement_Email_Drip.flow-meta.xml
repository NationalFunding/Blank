    <formulas>
        <name>formulaDripStatusNotEligible</name>
        <dataType>String</dataType>
        <expression>IF(
{!varDripEmailIndex}=1,
&apos;Not Eligible&apos;,
&apos;Cancelled&apos;
)</expression>
    </formulas>
    <formulas>
        <name>formulaFRPSALoanFacility</name>
        <dataType>Boolean</dataType>
        <expression>IF(
 OR(ISNULL({!Get_FRPSA_Loan_Facility_MDT.Id}),
      ISBLANK({!Get_FRPSA_Loan_Facility_MDT.Id})),
FALSE,
TRUE)</expression>
    </formulas>
    <formulas>
        <name>formulaTemplateName</name>
        <dataType>String</dataType>
        <expression>IF (
	AND(
		{!formulaFRPSALoanFacility}=TRUE,
		{!varDripEmailIndex}=1
		),
	&apos;Auto_Settlement_Email_No_&apos;+TEXT({!varDripEmailIndex})+&apos;_FRPSA&apos;, 
	&apos;Auto_Settlement_Email_No_&apos;+TEXT({!varDripEmailIndex})
	)</expression>
    </formulas>
