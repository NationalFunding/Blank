    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
    AND(
        [Account].RecordType.Name =&quot;Broker - Customer Account&quot;,
        ISNEW(),
        NOT(ISBLANK([Account].Web_Id_NatFund__c))
    ),
    AND(
        [Account].RecordType.Name =&quot;Broker - Customer Account&quot;,
        ISCHANGED([Account].Web_Id_NatFund__c)
    ),
    AND(
        /* Determine if the Account was created greated than 1 minutes ago */
        (NOW() - (1/1440)) &gt; [Account].CreatedDate,
        /* Web ID Field is Changed */
        ISCHANGED([Account].Web_Id_NatFund__c)
    )
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        {!myVariable_current.RecordType.Name} =&quot;Broker - Customer Account&quot;,
        ISNEW(),
        NOT(ISBLANK({!myVariable_current.Web_Id_NatFund__c}))
    ),
    AND(
        {!myVariable_current.RecordType.Name} =&quot;Broker - Customer Account&quot;,
        ISCHANGED({!myVariable_current.Web_Id_NatFund__c})
    ),
    AND(
        /* Determine if the Account was created greated than 1 minutes ago */
        (NOW() - (1/1440)) &gt; {!myVariable_current.CreatedDate},
        /* Web ID Field is Changed */
        ISCHANGED({!myVariable_current.Web_Id_NatFund__c})
    )
)</expression>
