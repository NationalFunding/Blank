    <decisions>
        <name>Check_Team_Roles</name>
        <label>Check Team Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Members</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non Opener</defaultConnectorLabel>
        <rules>
            <name>Opener</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Members.TeamMemberRole</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opener</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Count</targetReference>
            </connector>
            <label>Opener</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opener_Exists</name>
        <label>Opener Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>AddOpener</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Opener</defaultConnectorLabel>
        <rules>
            <name>Yes_Opener_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_opener_count</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
