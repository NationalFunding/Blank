        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;To {!Input_Matter_Record.advpm__Primary_Contact__r.FirstName} &lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(62, 62, 60);&quot;&gt;{!Input_Matter_Record.advpm__Primary_Contact__r.LastName}&lt;/span&gt;,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Your loan with {!Input_Matter_Record.Originating_Lender__c} has recently charged off due to non-payment and has been sent to us, the legal department for review. The amount due on the loan is ${!Input_Matter_Record.Total_Amount_Charged_Off__c}. We understand that we are all going through uncertain times right now and therefore wanted to reach out to see if you were interested in working out some sort of payment resolution without having to go the litigation route.&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please feel free to call and/or email us to discuss further.&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Sincerely,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!Input_Matter_Record.Lead_Attorney__r.FirstName} &lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(62, 62, 60);&quot;&gt;{!Input_Matter_Record.Lead_Attorney__r.LastName}&lt;/span&gt; | {!Input_Matter_Record.Lead_Attorney__r.Title}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;NEED TO BUILD THIS FIELD IN STAGE&lt;/b&gt;&lt;/p&gt;&lt;p&gt;9820 Towne Centre Drive&lt;/p&gt;&lt;p&gt;San Diego, CA 92121&lt;/p&gt;&lt;p&gt;P: {!Input_Matter_Record.Lead_Attorney__r.Phone} | F: &lt;span style=&quot;color: rgb(62, 62, 60); background-color: rgb(255, 255, 255);&quot;&gt;{!Input_Matter_Record.Lead_Attorney__r.Fax}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(62, 62, 60); background-color: rgb(255, 255, 255);&quot;&gt;E: {!Input_Matter_Record.Lead_Attorney__r.Email}&lt;/span&gt;&lt;/p&gt;</text>
