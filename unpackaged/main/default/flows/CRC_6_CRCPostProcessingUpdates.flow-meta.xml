    <description>Actions to update the Credit Review Controller after a ruleset runs. This flow is agnostic to the ruleset that it is running for. Actions should mimic the same post-processing updates that are done in the NFBR webservice.</description>
    <formulas>
        <name>formulaStepNumber</name>
        <dataType>Number</dataType>
        <expression>IF(
AND(
{!sObjectCreditReviewController.Step_Number__c}&lt;{!sObjectCreditReviewController.Total_Steps__c},
{!varResult}&lt;&gt;&apos;Stop&apos;
),
({!sObjectCreditReviewController.Step_Number__c}+1),
{!sObjectCreditReviewController.Step_Number__c}
)</expression>
