    <description>Ensures all related Contacts to a deal are SMS Opted In when the deal funds.

Last Update: Fix Timing Issue of Opt-In When Funded by LoanGen BAU-101</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaFRPSADeal</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    CONTAINS({!$Record.RecordType.DeveloperName}, &apos;FRPSA&apos;),
    True,
    False
)</expression>
    </formulas>
    <formulas>
        <name>formulaLeadingOne</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    LEFT({!formulaUnformattedPhone},1) = &quot;1&quot;,
    TRUE,
    FALSE
)</expression>
    </formulas>
    <formulas>
        <name>formulaLenderName</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!$Record.Lender_Account__r.Name}, &quot;Quick Bridge&quot;),
    &quot;Quick Bridge&quot;,
    &quot;National Funding&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaUnformattedPhone</name>
        <dataType>String</dataType>
        <expression>IF(
    OR(
        AND(
            LEFT(TRIM(TEXT({!Loop_Opportunity_Contacts.Contact.MobilePhone_Trim__c})),1) = &quot;1&quot;,
            LEN(TRIM(TEXT({!Loop_Opportunity_Contacts.Contact.MobilePhone_Trim__c}))) = 11
        ),
        LEN(TRIM(TEXT({!Loop_Opportunity_Contacts.Contact.MobilePhone_Trim__c}))) = 10
    ),   
    RIGHT(TRIM(TEXT({!Loop_Opportunity_Contacts.Contact.MobilePhone_Trim__c})),10),
    null
)</expression>
    </formulas>
