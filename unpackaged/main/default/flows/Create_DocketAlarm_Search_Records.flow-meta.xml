    <description>Subflow to be used on Case or Matter page to create DocketAlarm Search records. (PD-5130)

Last Update: 4/18/2025 - BAU-380, refactor matter batch creation process (use info from linked oppty instead of case)
+ 7/22/2024 - changed data type of Search Date to date</description>
    <environments>Default</environments>
    <formulas>
        <description>Use Account Name for Business Name When Legal_Name_Normal__c is blank.</description>
        <name>formula_business_name_case</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Case.Account.Legal_Name_Normal__c}), {!Get_Case.Account.Name}, {!Get_Case.Account.Legal_Name_Normal__c})</expression>
    </formulas>
    <formulas>
        <name>formula_business_name_oppty</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Matter.advpm__Opportunity__r.Account.Legal_Name_Normal__c}), {!Get_Matter.advpm__Opportunity__r.Account.Name}, {!Get_Matter.advpm__Opportunity__r.Account.Legal_Name_Normal__c})</expression>
    </formulas>
    <formulas>
        <name>formula_clean_ein</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!var_fed_tax_id}, &quot;-&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Remove dashed from ssn</description>
        <name>formula_clean_ssn</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!var_ssn}, &quot;-&quot;, &quot;&quot;)</expression>
    </formulas>
