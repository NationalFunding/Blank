<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Note to change who this is sent to you need to change the Custom Label Renewal_Processing_Emails.</description>
        <name>Send_Email_to_Renewals</name>
        <label>Send Email to Renewals</label>
        <locationX>751</locationX>
        <locationY>50</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>conEmailSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>forEmailAddresses</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <constants>
        <description>Lauren Martin&apos;s email address</description>
        <name>conEmailAddress</name>
        <dataType>String</dataType>
        <value>
            <stringValue>lmartin@nationalfunding.com, kburke@nationalfunding.com</stringValue>
        </value>
    </constants>
    <constants>
        <name>conEmailSubject</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Exclusivity Alert - Deal Submitted to Credit</stringValue>
        </value>
    </constants>
    <description>Updated to Add Oppty Owner to Email</description>
    <formulas>
        <name>forEmailAddresses</name>
        <dataType>String</dataType>
        <expression>{!$Label.Renewal_Processing_Emails}</expression>
    </formulas>
    <interviewLabel>Related Opportunity Search - Renewals Notification on Exclusivity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Related Opportunity Search - Renewals Notification on Exclusivity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>606</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Send_Email_to_Renewals</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRelatedOpptyId</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputAssignments>
            <assignToReference>varRenewalRepName</assignToReference>
            <field>NF_Renewal_Rep__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Opportunity</name>
        <label>Get Related Opportunity</label>
        <locationX>474</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Related_Opportunity_Search__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varROSId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Stage__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Funded</stringValue>
            </value>
        </filters>
        <object>Related_Opportunity__c</object>
        <outputAssignments>
            <assignToReference>varRelatedOpptyId</assignToReference>
            <field>Opportunity__c</field>
        </outputAssignments>
        <sortField>Fund_Date__c</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Lookup_Credit_Review_Controller</name>
        <label>Lookup Credit Review Controller</label>
        <locationX>175</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lookup_Related_Opportunity_Search</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Credit_Review__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputCreditReviewId</elementReference>
            </value>
        </filters>
        <object>Credit_Review_Controller__c</object>
        <outputAssignments>
            <assignToReference>varCRCId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Lookup_Related_Opportunity_Search</name>
        <label>Lookup Related Opportunity Search</label>
        <locationX>335</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Related_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Credit_Review_Controller__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCRCId</elementReference>
            </value>
        </filters>
        <object>Related_Opportunity_Search__c</object>
        <outputAssignments>
            <assignToReference>varROSId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Lookup_Credit_Review_Controller</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>EmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>The following Opportunity has been submitted to Credit:{!inputOpptyName}
Renewal Rep: {!varRenewalRepName}
https://nf.my.salesforce.com/{!inputOpptyId}
Click here to review the existing deals for this Account: https://nf.my.salesforce.com/{!varROSId}</text>
    </textTemplates>
    <variables>
        <name>inputCreditReviewId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>inputOpptyId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>inputOpptyName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varCRCId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varRelatedOpptyId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varRenewalRepName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varROSId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
