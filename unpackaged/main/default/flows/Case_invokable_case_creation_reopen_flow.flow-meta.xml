    <description>+ACH Bounce case path - called by Chargent Transaction flow (PD-3896)</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaBounceCaseSubject</name>
        <dataType>String</dataType>
        <expression> {!formulaLoanNumber} &amp; &apos; &apos; &amp;{!varOpportunityRecord.Legal_Name__c} &amp; &apos; &apos; &amp; {!inputCaseType}</expression>
    </formulas>
    <formulas>
        <name>formulaLoanNumber</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!varOpportunityRecord.Merchant_Number__c}),
{!varOpportunityRecord.Lease_Number__c},
{!varOpportunityRecord.Merchant_Number__c}
)</expression>
    </formulas>
    <formulas>
        <name>formulaPMCaseSubject</name>
        <dataType>String</dataType>
        <expression>{!varOpportunityRecord.Legal_Name__c} &amp; &apos;-&apos; &amp; {!formulaLoanNumber} &amp; &apos;-&apos; &amp; {!inputCaseType}</expression>
    </formulas>
