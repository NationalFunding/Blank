LEFT(RIGHT(TRIM({!$Record.TwilioSF__To_Number__c}),10),3) +
&quot;) &quot; +
RIGHT(LEFT(RIGHT(TRIM({!$Record.TwilioSF__To_Number__c}),10),6),3) +
&quot;-&quot; + 
RIGHT(TRIM({!$Record.TwilioSF__To_Number__c}),4)</expression>
    </formulas>
