        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Next_Contact_Time_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NVMConnect__NextContactTime__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
