    <description>Handles the email drip process for Legal Demand Cases by sending the appropriate email and setting the NCCI Email Drip Status to reflect whether the email drip is still in progress or has been completed.
BAU-730</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaDripStatusNotEligible</name>
        <dataType>String</dataType>
        <expression>IF(
	ISBLANK({!$Record.Current_Email_Drip_Index__c}),
	&apos;Not Eligible&apos;,
	&apos;Cancelled&apos;
)</expression>
    </formulas>
    <formulas>
        <name>formulaEmailTemplateName</name>
        <dataType>String</dataType>
        <expression>&quot;Auto_Case_NCCI_Legal_Demand_Email_&quot; &amp; 
IF({!$Record.Product__c} = &quot;FRPSA&quot;, &quot;FRPSA_&quot;, &quot;&quot;) &amp; 
&quot;No_&quot; &amp; TEXT({!formulaNextEmailDripIndex})</expression>
    </formulas>
    <formulas>
        <name>formulaNextEmailDripIndex</name>
        <dataType>Number</dataType>
        <expression>IF(
	ISBLANK({!$Record.Current_Email_Drip_Index__c}),
	1,
	{!$Record.Current_Email_Drip_Index__c} + 1
)</expression>
        <scale>0</scale>
    </formulas>
