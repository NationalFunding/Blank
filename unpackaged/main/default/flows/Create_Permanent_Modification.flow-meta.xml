    <formulas>
        <name>formulaLineBreak</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!txtLineBreak},&quot;~&quot;,&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaMailingAddressId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Case_Record.Opportunity__r.Addr_Mail1__c})),
{!Case_Record.Opportunity__r.Addr_Mail1__c},
{!Case_Record.Opportunity__r.Addr_Bill1__c}
)</expression>
    </formulas>
    <formulas>
        <name>formulaMaterialModificationSummary</name>
        <dataType>String</dataType>
        <expression> &quot;Material Modification: &quot; + TEXT({!of_Payments}) + &quot; &quot; + {!Frequency} + &quot; payments of $&quot; + TEXT({!Amount}) + &quot; starting &quot; + TEXT(MONTH({!Start_Date_Schedule}))+&quot;/&quot;+TEXT(DAY({!Start_Date_Schedule}))+&quot;/&quot;+TEXT(YEAR({!Start_Date_Schedule})) + &quot; for a total of $&quot; + TEXT({!formulaTotalAmountModified}) + BR()</expression>
    </formulas>
    <formulas>
        <name>formulaMaturityDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!Case_Record.Opportunity__r.Fund_Date__c},16)</expression>
    </formulas>
    <formulas>
        <name>formulaModLoanNumber</name>
        <dataType>String</dataType>
        <expression>{!Case_Record.Opportunity__r.Merchant_Number__c} + &apos;-MM1&apos;</expression>
    </formulas>
    <formulas>
        <name>formulaNewOpptyLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_280}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_280})) &amp; {!Create_Opportunity}</expression>
    </formulas>
    <formulas>
        <name>formulaNewTerminDays</name>
        <dataType>Number</dataType>
        <expression>{!formulaMaturityDate}-{!Start_Date}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaNewTerminMonths</name>
        <dataType>Number</dataType>
        <expression>FLOOR({!formulaNewTerminDays}/30)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaPayment</name>
        <dataType>Number</dataType>
        <expression>{!Case_Record.Balance_Remaining__c}/{!formulaTerm}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaTerm</name>
        <dataType>Number</dataType>
        <expression>{!formulaNewTerminMonths}*2</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaTotalAmountModified</name>
        <dataType>Currency</dataType>
        <expression>{!of_Payments}*{!Amount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Calculates the number of weeks into the term the customer currently is - based on the original fund date and the new loan start date</description>
        <name>formulaWeeksIntoTerm</name>
        <dataType>Number</dataType>
        <expression>({!Start_Date}-DATEVALUE({!Case_Record.Opportunity__r.Fund_Date__c}))/7</expression>
        <scale>2</scale>
    </formulas>
