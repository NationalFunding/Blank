<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Email_to_Sales_Rep</name>
        <label>Send Email to Sales Rep</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Opportunity__r.Owner.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>tt_email_subject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>tt_email_body</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <apiVersion>60.0</apiVersion>
    <description>Notify sales rep when approval amount or term is updated and the funding record is already in Approved status PD-4380

Last Update: Bug fix for opportunity hyperlink not working correctly</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_opportunity_link</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Instance_Settings__c.Salesforce_URL__c}&amp;{!$Record.Opportunity__r.Id}</expression>
    </formulas>
    <interviewLabel>Funding - Email Notification When Approval Changes {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Funding - Email Notification When Approval Changes</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Email_to_Sales_Rep</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4) AND 5</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Approved_Amount__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Max_Merchant_Turn__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Calculator_User_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>External Lender</stringValue>
            </value>
        </filters>
        <object>FPC_Funding_del__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>tt_email_body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;{!$Record.Opportunity__r.Owner.FirstName} {!$Record.Opportunity__r.Owner.LastName},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;There has been an update to the approval information for &lt;a href=&quot;{!formula_opportunity_link}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;{!$Record.Opportunity__r.Name}&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Lender: {!$Record.Lender_ID__r.Name}&lt;/p&gt;&lt;p&gt;&lt;u&gt;Updated Approval&lt;/u&gt;&lt;/p&gt;&lt;p&gt;Approved Amount: {!$Record.Approved_Amount__c}&lt;/p&gt;&lt;p&gt;Approved Term: {!$Record.Max_Merchant_Turn__c}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;u&gt;Previous Approval&lt;/u&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;Approved Amount: &lt;/span&gt;{!$Record__Prior.Approved_Amount__c}&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;Approved Term: {!$Record__Prior.Max_Merchant_Turn__c}&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>tt_email_subject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.Lender_ID__r.Name} {!$Record.Status__c} - {!$Record.Opportunity__r.Name}</text>
    </textTemplates>
</Flow>
