<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>call HTTP Callout subflow upon Stipulation record is submitted for Review (PD-2971)</description>
    <environments>Default</environments>
    <interviewLabel>Stipulation - Submitted for Review {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stipulation - Submitted for Review</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Submitted for Review</stringValue>
            </value>
        </filters>
        <object>Stipulations__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>HTTP_Callout</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>HTTP_Callout</name>
        <label>HTTP Callout</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <flowName>Http_Callout_Controller</flowName>
        <inputAssignments>
            <name>inputStipulationId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varCalloutType</name>
            <value>
                <stringValue>stipulationUpdate</stringValue>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
