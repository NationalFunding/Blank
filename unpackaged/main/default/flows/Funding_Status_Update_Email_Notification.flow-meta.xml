    <decisions>
        <name>Notify_Oppo_Owner</name>
        <label>Notify Oppo Owner?</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Get_External_Lender_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Notify_Oppo_Owner</name>
            <conditionLogic>1 AND (2 OR 3 OR 4) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lender_ID__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>National Funding</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lender_ID__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Quick Bridge</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MLP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Owner.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email</targetReference>
            </connector>
            <label>Yes, Notify Oppo Owner</label>
        </rules>
    </decisions>
