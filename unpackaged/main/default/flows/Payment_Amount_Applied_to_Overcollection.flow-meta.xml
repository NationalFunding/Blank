    <sourceTemplate>cmbls__Payment_Amount_Applied_to_Overcollection</sourceTemplate>
    <start>
        <locationX>386</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_Amount_Applied_to_Overcollection_Formula_Value</targetReference>
        </connector>
        <filterFormula>
            AND(
            OR(ISNEW(), ISCHANGED({!$Record.cmbls__Amount_Applied_to_Overcollection_Reserve__c})),
            {!$Record.cmbls__Amount_Applied_to_Overcollection_Reserve__c} != 0
