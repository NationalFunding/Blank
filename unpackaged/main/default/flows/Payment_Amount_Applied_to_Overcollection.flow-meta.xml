<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <decisions>
        <name>Evaluate_Amount_Applied_to_Overcollection_Formula_Value</name>
        <label>Evaluate Amount Applied to Overcollection Formula Value</label>
        <locationX>512</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Increase_Value</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Increase Balance</defaultConnectorLabel>
        <rules>
            <name>Is_Reversal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.cmbls__Reversal_Of__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Evaluate_Reversal</targetReference>
            </connector>
            <label>Is Reversal</label>
        </rules>
        <rules>
            <name>Decrease_Balance</name>
            <conditionLogic>(5 AND 6 AND 7 AND 8) OR (1 AND 2 AND (3 OR 4))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Credit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.cmbls__Transaction_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reserve</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.cmbls__Sub_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Overpayment Refund</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.cmbls__Sub_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reserve Reallocation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Debit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.cmbls__Transaction_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Payment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.cmbls__Transaction_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Payoff</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.cmbls__Reversal_Of__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decrease_Value</targetReference>
            </connector>
            <label>Decrease Balance</label>
        </rules>
    </decisions>
    <decisions>
        <name>Evaluate_Reversal</name>
        <label>Evaluate Reversal</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Update_Reversal_Payment_Increased</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Increase</defaultConnectorLabel>
        <rules>
            <name>Deacrease</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.cmbls__Reversal_Of__r.cmbls__Amount_Applied_to_Overcollection_Formula__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Reversal_Payment_Decrese</targetReference>
            </connector>
            <label>Deacrease</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DecreaseAmount</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.cmbls__Amount_Applied_to_Overcollection_Reserve__c} * -1</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RelatedReversalAmountDecreased</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.cmbls__Reversal_Of__r.cmbls__Amount_Applied_to_Overcollection_Reserve__c} * -1</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Payment - Amount Applied to Overcollection {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Payment - Amount Applied to Overcollection</label>
    <processMetadataValues>
