        <locationY>539</locationY>
        <inputAssignments>
            <field>cmbls__Amount_Applied_to_Overcollection_Formula__c</field>
            <value>
                <elementReference>$Record.cmbls__Reversal_Of__r.cmbls__Amount_Applied_to_Overcollection_Reserve__c</elementReference>
            </value>
