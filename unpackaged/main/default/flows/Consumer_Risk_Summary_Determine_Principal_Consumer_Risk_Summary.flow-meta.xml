    <decisions>
        <description>Is the existing Principal Consumer Risk Summary expired?</description>
        <name>Existing_PCRS_Expired</name>
        <label>Existing PCRS Expired?</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Triggering_CRS_Completed_Date_PCRS_Completed_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Existing_PCRS_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Principal_Consumer_Risk_Summary.Expiration_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Triggering_CRS</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is the Principal Consumer Risk Summary populated for the Lead or Contact associated with the triggering Consumer Risk Summary?</description>
        <name>PCRS_Populated</name>
        <label>PCRS Populated?</label>
        <locationX>292</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Use_Triggering_CRS</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_PCRS_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Existing_Principal_Consumer_Risk_Summary</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Principal_Consumer_Risk_Summary</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is the Completed Date/Time of the triggering Consumer Risk Summary more recent than the Completed Date/Time of the existing Consumer Risk Summary?</description>
        <name>Triggering_CRS_Completed_Date_PCRS_Completed_Date</name>
        <label>Triggering CRS Completed Date &gt; PCRS Completed Date?</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Use_Existing_PCRS</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Triggering_CRS_Completed_Date_PCRS_Completed_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Triggering_Consumer_Risk_Summary.Completed_Date_Time__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Triggering_Consumer_Risk_Summary.Success_Date_Time__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Triggering_CRS</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
