    <description>Recipient update PD5008</description>
    <environments>Default</environments>
    <formulas>
        <name>formEmailRecipientNewRecord</name>
        <dataType>String</dataType>
        <expression>IF(
ISPICKVAL({!$Record.Offer_Made_By__c},&quot;Local Counsel&quot;), {!Get_Custom_Setting_Recipients.NF_Contact_for_Local_Counsel_Offers__c},
IF(
    ISPICKVAL({!$Record.Offer_Made_By__c},&quot;Defendant&quot;),{!Get_Custom_Setting_Recipients.NF_Contact_for_Defendant_Offers__c},
  IF(
      AND(
            ISPICKVAL({!$Record.Offer_Made_By__c},&quot;National Funding&quot;),
            ISPICKVAL({!$Record.advpm__Originating_Offer_And_Demand__r.Offer_Made_By__c},&quot;Local Counsel&quot;)
),
      {!Get_Custom_Setting_Recipients.Local_Counsel_Contact_for_NF_Offers__c},
{!Get_Custom_Setting_Recipients.Attorney_Team_Recipient__c}
)))</expression>
    </formulas>
    <formulas>
        <name>formEmailRecipientStatusUpdate</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!$Record.Offer_Made_By__c},&quot;Local Counsel&quot;),
    {!Get_Custom_Setting_Recipients.Local_Counsel_Contact_for_NF_Offers__c},
  IF(
      ISPICKVAL({!$Record.Offer_Made_By__c},&quot;Defendant&quot;),
    {!Get_Custom_Setting_Recipients.Attorney_Team_Recipient__c},
  IF(
     AND(ISPICKVAL({!$Record.Offer_Made_By__c},&quot;National Funding&quot;), ISPICKVAL({!$Record.advpm__Originating_Offer_And_Demand__r.Offer_Made_By__c},&quot;Local Counsel&quot;), ISPICKVAL({!$Record.advpm__Status__c},&quot;Approved&quot;)
             ),
      {!Get_Custom_Setting_Recipients.NF_Contact_for_Local_Counsel_Offers__c},
  IF(
      AND(
ISPICKVAL({!$Record.Offer_Made_By__c},&quot;National Funding&quot;), NOT(ISPICKVAL({!$Record.advpm__Originating_Offer_And_Demand__r.Offer_Made_By__c},&quot;Local Counsel&quot;)),
ISPICKVAL({!$Record.advpm__Status__c},&quot;Approved&quot;)
),
      {!Get_Custom_Setting_Recipients.NF_Contact_for_Defendant_Offers__c},&quot;&quot;
))))</expression>
    </formulas>
    <formulas>
        <name>formIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>formMatterStatus</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
        ISPICKVAL({!$Record.advpm__Status__c},&quot;Approved&quot;),
        NOT(ISPICKVAL({!$Record.Offer_Made_By__c},&quot;Local Counsel&quot;)), 
        NOT(ISPICKVAL({!$Record.advpm__Originating_Offer_And_Demand__r.Offer_Made_By__c},&quot;Local Counsel&quot;))
),
 &quot;Settlement&quot;,
IF( 
AND(
         ISPICKVAL({!$Record.advpm__Status__c},&quot;Approved&quot;), 
         OR(ISPICKVAL({!$Record.Offer_Made_By__c},&quot;Local Counsel&quot;),
                 ISPICKVAL({!$Record.advpm__Originating_Offer_And_Demand__r.Offer_Made_By__c},&quot;Local Counsel&quot;))),
&quot;Local Counsel&quot;,
  TEXT({!$Record.advpm__Matter__r.advpm__Status__c}
)))</expression>
    </formulas>
    <formulas>
        <name>formulaMatterStage</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(ISPICKVAL({!$Record.advpm__Status__c},&quot;Approved&quot;), 
OR(ISPICKVAL({!$Record.Offer_Made_By__c},&quot;Local Counsel&quot;),
ISPICKVAL({!$Record.advpm__Originating_Offer_And_Demand__r.Offer_Made_By__c},&quot;Local Counsel&quot;))),
 &quot;Settled with Local Counsel&quot;,
 IF(
   AND(ISPICKVAL({!$Record.advpm__Status__c},&quot;Approved&quot;), NOT(ISPICKVAL({!$Record.Offer_Made_By__c},&quot;Local Counsel&quot;)),
NOT(ISPICKVAL({!$Record.advpm__Matter__r.advpm__Status__c},&quot;Local Counsel&quot;))),
  &quot;Draft Agreement&quot;,
  TEXT({!$Record.advpm__Matter__r.advpm__Stage__c})
))</expression>
    </formulas>
