        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(Text(DATEVALUE(NOW()))+ &quot; &quot; +MID( TEXT( NOW() ), 12, 2) +&apos;:00:00&apos;)-(VALUE({!Distribution_Cutoff_Time.Distribution_Cutoff_Time__c})/24)</expression>
