    <description>Disqualifies duplicate leads when WC or EF Qualification is changed to a disqualified status PD-1095

Last Update: Removing status update to House because it was causing issues with Experiture leads</description>
    <environments>Default</environments>
    <formulas>
        <name>disqualified_reason</name>
        <dataType>String</dataType>
        <expression>IF(
	OR(
		ISPICKVAL({!$Record.Initial_Product_Interest__c},&apos;Lease&apos;),
		ISPICKVAL({!$Record.Initial_Product_Interest__c},&apos;Equipment Leasing&apos;)
		),
	TEXT({!$Record.EF_Qualification__c}),
	TEXT({!$Record.WC_Qualification__c})
	)</expression>
    </formulas>
