    <description>Updated to reflect Referral Partner deals. Assigns owner based on Submission Type in Broker Input</description>
    <formulas>
        <description>Returns userID of Account Owner if Submission Type is Referral, returns portaluserID of Broker if Submission Type is Broker.</description>
        <name>FormulaOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(
ISPICKVAL(
{!svarBrokerInputRecord.Submission_Type__c},&apos;Broker&apos;),
{!varBrokerPortalUserId},{!varBrokerAccountOwnerId}
)</expression>
    </formulas>
    <formulas>
        <description>Takes % Ownership G1 from input screen and multiplies by 10000 so the percentage is displayed correctly on the Contact record.</description>
        <name>PercentageOwnershipG1</name>
        <dataType>Number</dataType>
        <expression>{!svarBrokerInputRecord.G1_Ownership__c}*10000</expression>
        <scale>10</scale>
    </formulas>
    <formulas>
        <description>Takes % Ownership G2 from input screen and multiplies by 10000 so the percentage is displayed correctly on the Contact record.</description>
        <name>PercentageOwnershipG2</name>
        <dataType>Number</dataType>
        <expression>{!svarBrokerInputRecord.G2_Ownership__c}*10000</expression>
        <scale>10</scale>
    </formulas>
    <formulas>
        <description>Takes % Ownership G3 from input screen and multiplies by 10000 so the percentage is displayed correctly on the Contact record.</description>
        <name>PercentageOwnershipG3</name>
        <dataType>Number</dataType>
