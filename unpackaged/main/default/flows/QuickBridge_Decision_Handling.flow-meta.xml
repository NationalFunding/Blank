    <decisions>
        <description>Decision element when QuickBridge Funding Record is updated.</description>
        <name>QB_Decision_Routing</name>
        <label>QB Decision Routing</label>
        <locationX>613</locationX>
        <locationY>193</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>QB_Declined_NF_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputFundingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conDeclined</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conNFApproved</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Alert_Analyst</targetReference>
            </connector>
            <label>QB Declined &amp; NF Approved</label>
        </rules>
        <rules>
            <name>QB_Approved_NF_Declined</name>
            <conditionLogic>1 AND (2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>inputFundingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conLenderApproved</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conDeclined</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conWithdrawn</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varExistingFundingApproved</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_QB_Funding_to_Approved</targetReference>
            </connector>
            <label>QB Approved &amp; NF Declined or Withdrawn</label>
        </rules>
        <rules>
            <name>QB_Approved_NF_Model_Declined</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputFundingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conLenderApproved</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conDeclined</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formulaModelDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conModelDecline</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>QB_Approve_NF_Auto_Decline_Alert</targetReference>
            </connector>
            <label>QB Approved &amp; NF Model Declined</label>
        </rules>
        <rules>
            <name>QB_Declined_NF_Declined</name>
            <conditionLogic>((1 OR 2) AND (3 OR 7)) OR ((1 OR 2) AND (4 AND 5 AND 6 AND 8))</conditionLogic>
            <conditions>
                <leftValueReference>inputFundingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conDeclined</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputFundingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conPending</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conDeclined</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formulaModelDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conModelDecline</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conDeclined</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conNFApproved</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conWithdrawn</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCRStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conWithdrawn</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_to_Syndication</targetReference>
            </connector>
            <label>QB Declined or Pending &amp; NF Declined or Model Declined or Withdrawn</label>
        </rules>
    </decisions>
    <formulas>
        <name>formulaModelDecision</name>
        <dataType>String</dataType>
        <expression>IF(
OR(
{!varDecisionRecommendation}=&apos;Approvable&apos;,
{!varDecisionRecommendation}=&apos;Approve&apos;,
{!varDecisionRecommendation}=&apos;Model Review&apos;,
{!varDecisionRecommendation}=&apos;Starter Loan Approvable&apos;),
&apos;Approvable&apos;, 
IF(
ISBLANK({!varDecisionRecommendation}),
&apos;&apos;,
&apos;Model Decline&apos;
))</expression>
    </formulas>
