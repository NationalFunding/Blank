<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>Payment - {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Payment - Origination Fee Payment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Transaction_Amount_reset</name>
        <label>Transaction Amount reset</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>cmbls__Transaction_Amount__c</field>
            <value>
                <elementReference>$Record__Prior.cmbls__Transaction_Amount__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Transaction_Amount_reset</targetReference>
        </connector>
        <filterFormula>AND(
{!$Record.RecordType.DeveloperName} = &apos;Debit&apos;,
ISPICKVAL({!$Record.cmbls__Transaction_Type__c} , &apos;Payment&apos;),
ISPICKVAL({!$Record.cmbls__Sub_Type__c}, &apos;Origination Fee&apos;),
ISPICKVAL({!$Record.cmbls__Status__c}, &apos;Settled&apos;),
{!$Record.cmbls__Transaction_Amount__c} = 0,
ISCHANGED({!$Record.cmbls__Transaction_Amount__c})
)</filterFormula>
        <object>cmbls__Payment__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
