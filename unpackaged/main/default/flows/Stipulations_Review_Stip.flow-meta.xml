    <formulas>
        <name>CommentsIsBlankFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(
LEN({!Add_Comments})=0, 
TRUE,
 FALSE
)</expression>
    </formulas>
    <formulas>
        <name>formulaCleared</name>
        <dataType>Boolean</dataType>
        <expression>IF(
{!Stip_Status}={!Cleared},
TRUE,
FALSE)</expression>
    </formulas>
    <formulas>
        <name>formulaClearedBy</name>
        <dataType>String</dataType>
        <expression>IF(
{!Stip_Status}={!Cleared},
{!$User.Full_Name__c},
&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formulaClearedDate</name>
        <dataType>DateTime</dataType>
        <expression>IF(
{!Stip_Status}={!Cleared},
NOW(), 
null
)</expression>
    </formulas>
    <formulas>
        <name>formulaConvertDateTimetoPST</name>
        <dataType>String</dataType>
        <expression>IF ( DATEVALUE({!$Flow.CurrentDateTime}) &gt;=
DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),3,1)
+
(
14-
CASE( MOD(DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),3,1) - DATE (1900,1,7),7) ,
0,7,MOD(DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),3,1) - DATE (1900,1,7),7))
)
&amp;&amp;
DATEVALUE({!$Flow.CurrentDateTime}) &lt;
DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),11,1)
+
(
7-
CASE( MOD(DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),11,1) - DATE (1900,1,7),7) ,
0,7,MOD(DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),11,1) - DATE (1900,1,7),7))
),
LEFT ( TEXT ({!$Flow.CurrentDateTime}- 7/24 ), 16),
LEFT ( TEXT ({!$Flow.CurrentDateTime}- 8/24), 16)
)</expression>
    </formulas>
    <formulas>
        <name>formulaDocumentName</name>
        <dataType>String</dataType>
        <expression>&quot;[Stip Document - &quot;  + {!varStipRecord.Stip_Description__c} + &quot;] &quot; + SUBSTITUTE(SUBSTITUTE({!varDocumentName}, &quot;[&quot;, &quot;&quot;), &quot;]&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaLineBreak</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!txtLineBreak},&quot;~&quot;,&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaStipComments</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        ISBLANK({!varStipRecord.Comments__c}),
        {!CommentsIsBlankFormula}=FALSE),
        {!formulaConvertDateTimetoPST} + &quot; [&quot; + {!$User.Full_Name__c} + &quot;] - &quot; + {!Add_Comments}, 
        IF(
            AND(
                NOT(ISBLANK({!varStipRecord.Comments__c})),
                {!CommentsIsBlankFormula}=FALSE),
            {!varStipRecord.Comments__c} + {!formulaLineBreak} + {!formulaConvertDateTimetoPST} + &quot; [&quot; + {!$User.Full_Name__c} + &quot;] - &quot; + {!Add_Comments},
            IF(
                AND(
                    NOT(ISBLANK({!varStipRecord.Comments__c})),
                    {!CommentsIsBlankFormula}=TRUE),
                {!varStipRecord.Comments__c},
                &apos;&apos;
            )))</expression>
    </formulas>
    <formulas>
        <name>formulaTransferStip</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
ISPICKVAL({!varStipRecord.Stip_Type__c},&quot;Credit&quot;),
{!varTransferStip}=TRUE
), 
&quot;Funding&quot;,
IF(
AND(
ISPICKVAL({!varStipRecord.Stip_Type__c},&quot;Funding&quot;),
{!varTransferStip}=TRUE
), 
&quot;Credit&quot;,
TEXT({!varStipRecord.Stip_Type__c})
))</expression>
    </formulas>
    <formulas>
        <name>formulaTransferStipRemoveUser</name>
        <dataType>String</dataType>
        <expression>IF(
{!varTransferStip}=TRUE,
&apos;&apos;,
{!varStipRecord.Assigned_To__c}
)</expression>
    </formulas>
    <interviewLabel>Stipulations - Review Stip {!$Flow.CurrentDateTime}</interviewLabel>
