<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_House_Account_as_Lead_Owner</name>
        <label>Assign House Account as Lead Owner</label>
        <locationX>440</locationX>
        <locationY>684</locationY>
        <assignmentItems>
            <assignToReference>var_lead.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Record_Assignments.Lead__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_lead.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Record_Assignments.Distribution_User__r.User__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_lead_to_update_col</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_lead</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_lead_ids_col</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Record_Assignments.Lead__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Record_Assignments</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>This_Lead_Already_In_Col</name>
        <label>This Lead Already In Col?</label>
        <locationX>352</locationX>
        <locationY>576</locationY>
        <defaultConnector>
            <targetReference>Assign_House_Account_as_Lead_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_This_Lead_Already_In_Col</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_lead_ids_col</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Record_Assignments.Lead__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Record_Assignments</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Last Update: 5/13/2025 - CRD-405, update lead owner to house account if it&apos;s still assigned to holding queue after 10 days + set max for get records</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_10_days_ago</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 10</expression>
    </formulas>
    <formulas>
        <description>Trim the 18 character ID to 15 character to match with lead owner ID</description>
        <name>formula_queue_id_trimmed</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_PreQual_Result_Holding_Queue_ID.Id}, 15)</expression>
    </formulas>
    <interviewLabel>&quot;PreQual Lead Routing Scheduled Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PreQual Lead Routing Scheduled Flow</label>
    <loops>
        <name>Loop_Record_Assignments</name>
        <label>Loop Record Assignments</label>
        <locationX>176</locationX>
        <locationY>468</locationY>
        <collectionReference>Get_PreQual_Lead_Record_Assignments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>This_Lead_Already_In_Col</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Leads</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_PreQual_Lead_Record_Assignments</name>
        <label>Get PreQual Lead Record Assignments</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Record_Assignments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Lead__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Assigned__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>formula_10_days_ago</elementReference>
            </value>
        </filters>
        <filters>
            <field>Campaign_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PreQual</stringValue>
            </value>
        </filters>
        <filters>
            <field>Routing_Definition_Name__c</field>
            <operator>EndsWith</operator>
            <value>
                <stringValue>PreQual Holding Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Lead_Owner_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>formula_queue_id_trimmed</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>150.0</numberValue>
        </limit>
        <object>Record_Assignment__c</object>
        <sortField>Assigned__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_PreQual_Result_Holding_Queue_ID</name>
        <label>Get PreQual Result Holding Queue ID</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_PreQual_Lead_Record_Assignments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PreQual_Result_Holding_Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Leads</name>
        <label>Update Leads</label>
        <locationX>176</locationX>
        <locationY>960</locationY>
        <inputReference>var_lead_to_update_col</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_PreQual_Result_Holding_Queue_ID</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-05-05</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_lead</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>var_lead_ids_col</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_lead_to_update_col</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
</Flow>
