            </value>
        </inputAssignments>
        <object>Referral_Actions__c</object>
    </recordCreates>
    <recordLookups>
        <name>Lookup_Referral_Action_with_Oppty_Stage</name>
        <label>Lookup Referral Action with Oppty Stage</label>
        <locationX>494</locationX>
        <locationY>279</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_Referral_Action_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity_Stage__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputOpptyStage</elementReference>
            </value>
        </filters>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputOpptyId</elementReference>
            </value>
        </filters>
        <object>Referral_Actions__c</object>
        <outputAssignments>
            <assignToReference>varReferralActionWithMatchingStageId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Lookup_Referral_Source</name>
        <label>Lookup Referral Source</label>
        <locationX>177</locationX>
        <locationY>104</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Referral_Valid</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varReferralSourceId</elementReference>
            </value>
        </filters>
        <object>Referral_Sources__c</object>
        <outputAssignments>
            <assignToReference>varSourceDaysReferralValid</assignToReference>
            <field>Days_Referral_Valid__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varSourceOpptyTypes</assignToReference>
            <field>Opportunity_Types__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Lookup_Referral_Summary</name>
        <label>Lookup Referral Summary</label>
        <locationX>41</locationX>
        <locationY>31</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lookup_Referral_Source</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputAccountId</elementReference>
            </value>
        </filters>
        <object>Referral_Summary__c</object>
        <outputAssignments>
            <assignToReference>varDaysSinceReferral</assignToReference>
            <field>Days_Since_Referral__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varReferralSummaryId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varReferralSourceId</assignToReference>
            <field>Referral_Sources__c</field>
        </outputAssignments>
        <sortField>Referral_DateTime__c</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <startElementReference>Lookup_Referral_Summary</startElementReference>
