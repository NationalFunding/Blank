<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <constants>
        <name>con60Days</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>60.0</numberValue>
        </value>
    </constants>
    <constants>
        <name>conStop</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Stop</stringValue>
        </value>
    </constants>
    <constants>
        <name>emails</name>
        <dataType>String</dataType>
        <value>
            <stringValue>trover727@gmail.com</stringValue>
        </value>
    </constants>
    <constants>
        <name>Subject</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Variables List</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Does_Referral_Action_Exist</name>
        <label>Does Referral Action Exist?</label>
        <locationX>643</locationX>
        <locationY>371</locationY>
        <defaultConnector>
            <targetReference>Approved_Referral_Action</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue</defaultConnectorLabel>
        <rules>
            <name>Referral_Action_Exists_Stop</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varReferralActionWithMatchingStageId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Referral Action Exists - Stop</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Referral_Valid</name>
        <label>Is Referral Valid</label>
        <locationX>320</locationX>
        <locationY>184</locationY>
        <defaultConnector>
            <targetReference>Lookup_Referral_Action_with_Oppty_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue</defaultConnectorLabel>
        <rules>
            <name>Referral_Not_Valid_Time</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDaysSinceReferral</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varSourceDaysReferralValid</elementReference>
                </rightValue>
            </conditions>
            <label>Referral Not Valid - Time</label>
        </rules>
        <rules>
            <name>Referral_Not_Valid_Oppty_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formOpptyTypeDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conStop</elementReference>
                </rightValue>
            </conditions>
            <label>Referral Not Valid - Oppty Type</label>
        </rules>
    </decisions>
    <formulas>
        <name>formOpptyTypeDecision</name>
        <dataType>String</dataType>
        <expression>IF(
{!varSourceOpptyTypes} = &apos;All&apos;, &apos;Continue&apos;,
IF(
{!varSourceOpptyTypes} = &apos;New&apos; &amp;&amp; {!inputOpptyType} = &apos;NEW&apos;, &apos;Continue&apos;, &apos;Stop&apos;))</expression>
    </formulas>
    <interviewLabel>Referral Process - Oppty Funded {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Referral Process - Oppty Funded</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Approved_Referral_Action</name>
        <label>Approved Referral Action</label>
        <locationX>807</locationX>
        <locationY>470</locationY>
        <inputAssignments>
            <field>Action_Type__c</field>
            <value>
                <stringValue>Funded</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity_Stage__c</field>
