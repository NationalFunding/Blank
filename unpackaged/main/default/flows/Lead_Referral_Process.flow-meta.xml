        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
    $User.User_Developer_Name__c != &apos;dbampnf&apos;,
    ISCHANGED([Lead].Referral_Date_Time__c),
    [Lead].Referral_Source_Name__c = &apos;DLP&apos;,
    NOT(ISBLANK([Lead].Referral_Value_1__c)),
    NOT(ISBLANK([Lead].Referral_Value_2__c)),
    NOT(ISBLANK([Lead].Referral_Value_3__c))
)

 </stringValue>
