    {!myVariable_current.Referral_Source_Name__c} = &apos;DLP&apos;,
    NOT(ISBLANK({!myVariable_current.Referral_Value_1__c})),
    NOT(ISBLANK({!myVariable_current.Referral_Value_2__c})),
    NOT(ISBLANK({!myVariable_current.Referral_Value_3__c}))
)</expression>
    </formulas>
    <formulas>
