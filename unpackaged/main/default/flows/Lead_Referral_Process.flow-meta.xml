            <name>originalFormula</name>
            <value>
                <stringValue>AND(
    $User.User_Developer_Name__c != &apos;dbampnf&apos;,
    OR(
        ISPICKVAL([Lead].Annual_Sales__c, &apos;Tier 2&apos;),
        ISPICKVAL([Lead].Annual_Sales__c, &apos;Tier 3&apos;),
        [Lead].AnnualRevenue &gt;= 250000
    )
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
