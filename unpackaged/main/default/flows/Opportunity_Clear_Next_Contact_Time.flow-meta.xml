    <assignments>
        <name>Assign_Next_Contact_Time_to_Blank</name>
        <label>Assign Next Contact Time to Blank</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.NextContactTime__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Still_Year_4000</name>
        <label>Still Year 4000?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Still_Year_4000</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NextContactTime__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <dateTimeValue>4000-01-01T08:00:00.000Z</dateTimeValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Next_Contact_Time_to_Blank</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Last Update: 8/8/2025 - SPR-471, clear next contact time when it&apos;s set to year 4000 by Vonage</description>
    <environments>Default</environments>
