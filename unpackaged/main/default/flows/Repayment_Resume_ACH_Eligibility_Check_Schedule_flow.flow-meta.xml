    <decisions>
        <name>eligibility_check</name>
        <label>eligibility check</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Eligible</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>formulaWeekdayToday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>7.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formulaWeekdayToday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Internal_Funding_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Funded</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Account.Pending_Chargeoff__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <label>Not Eligible</label>
        </rules>
        <rules>
            <name>Proceed</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.cmbls__Payee_Account__r.Collections_Stage__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Default</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.cmbls__Payee_Account__r.Collections_Stage__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Charge Off</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Last_Payment_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formulaLastPaymentNdaysAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Most_Recent_Bounce_Case</targetReference>
            </connector>
            <label>Proceed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Eligible_Bounce_type</name>
        <label>Eligible Bounce type</label>
        <locationX>182</locationX>
        <locationY>468</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NSF</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Most_Recent_Bounce_Case.Returned_Payment_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Insufficient</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Most_Recent_Bounce_Case.Returned_Payment_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Uncollected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Most_Recent_Bounce_Case.Returned_Payment_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Non-transaction</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Most_Recent_Bounce_Case.Returned_Payment_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Nontransaction</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Accounting_Instruction</targetReference>
            </connector>
            <label>NSF</label>
        </rules>
    </decisions>
    <description>Schedule flow to check if Paused Repayment is eligible for Resuming ACH
+If last payment is over 20 days and last bounce is NSF in the Chargeoff/Default band (PD-2563)</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaLastPaymentNdaysAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY()-{!$Setup.Case_Custom_Settings__c.ACH_Resume_Check_Last_Payment_Days__c}</expression>
    </formulas>
    <formulas>
        <name>formulaNotifyUserEmail</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Most_Recent_Bounce_Case.Owner:User.IsActive}=TRUE,{!Get_Most_Recent_Bounce_Case.Owner:User.Email},
{!Get_Most_Recent_Bounce_Case.Owner:User.Manager.Email})</expression>
    </formulas>
    <formulas>
        <name>formulaWeekdayToday</name>
        <dataType>Number</dataType>
        <expression>WEEKDAY(TODAY())</expression>
        <scale>0</scale>
    </formulas>
