    <decisions>
        <description>Checks to see if the opportunity has a National Funding approval within the last thirty days. If it is, stop the process so the deal doesn&apos;t get withdrawn downstream.</description>
        <name>NF_Approval_within_30_days</name>
        <label>NF Approval within 30 days?</label>
        <locationX>1221</locationX>
        <locationY>43</locationY>
        <defaultConnector>
            <targetReference>Loop_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_approval_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Opportunities.Lender_Account__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>National Funding - Platinum WC Funding</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Opportunities.Approval_Expiration_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formula30DaysAgo</elementReference>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_a_dupe_opportunity_found</name>
        <label>Was a dupe opportunity found?</label>
        <locationX>1090</locationX>
        <locationY>239</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_dupe_opp_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDupeOppsCollection</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Opportunities</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow will withdraw duplicate deals submitted by the same broker (SD-4957)
+exclude Stage=Withdrawn by Broker when getting duplicate deal (PD-1147)</description>
    <environments>Default</environments>
    <formulas>
        <name>formula30DaysAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY()-30</expression>
    </formulas>
    <formulas>
        <name>formulaPhoneTrim</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Account.Phone_Trim__c}</expression>
        <scale>1</scale>
    </formulas>
    <interviewLabel>Opportunity - Withdraw Duplicate Broker Deals {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Withdraw Duplicate Broker Deals</label>
    <loops>
        <name>Loop_Accounts</name>
        <label>Loop Accounts</label>
        <locationX>912</locationX>
        <locationY>237</locationY>
        <collectionReference>Get_Matching_Accounts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
