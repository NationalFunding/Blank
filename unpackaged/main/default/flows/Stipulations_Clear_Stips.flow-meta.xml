<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <assignments>
        <name>Add_First_Stip_to_Collection</name>
        <label>Add First Stip to Collection</label>
        <locationX>685</locationX>
        <locationY>50</locationY>
        <assignmentItems>
            <assignToReference>varColStipstoUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varSingleStipRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Counter_Size</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_First_Stip_to_Stip_Record</name>
        <label>Add First Stip to Stip Record</label>
        <locationX>499</locationX>
        <locationY>50</locationY>
        <assignmentItems>
            <assignToReference>varSingleStipRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaSingleStipSelected</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingleStipRecord.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cleared</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingleStipRecord.Cleared_By__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaUserName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingleStipRecord.Cleared_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_First_Stip_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Selected_Stip_ID_s_to_Variable</name>
        <label>Assign Selected Stip ID&apos;s to Variable</label>
        <locationX>318</locationX>
        <locationY>50</locationY>
        <assignmentItems>
            <assignToReference>varSelectedStips</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Select_Stips_to_Clear</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_First_Stip_to_Stip_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Remove_Created_Stip_ID_from_List</name>
        <label>Remove Created Stip ID from List</label>
        <locationX>500</locationX>
        <locationY>219</locationY>
        <assignmentItems>
            <assignToReference>varSelectedStips</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaRemainingSelectedStips</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_First_Stip_to_Stip_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Counter_Size</name>
        <label>Check Counter Size</label>
        <locationX>676</locationX>
        <locationY>227</locationY>
        <defaultConnector>
            <targetReference>Update_Stips</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Counter is &lt;1</defaultConnectorLabel>
        <rules>
            <name>Greater_than_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaNumberofStipsSelected</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Created_Stip_ID_from_List</targetReference>
            </connector>
            <label>Greater than 1</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>varStipRecords</name>
        <dataType>String</dataType>
        <displayField>Stip_Description__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Funding__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputFundingId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cleared</stringValue>
            </value>
        </filters>
        <object>Stipulations__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <formulas>
        <name>formulaLength</name>
        <dataType>Number</dataType>
        <expression>LEN({!varSelectedStips})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaNumberofStipsSelected</name>
        <dataType>Number</dataType>
        <expression>CEILING({!formulaLength}/20)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaRemainingSelectedStips</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT({!varSelectedStips},({!formulaLength}-20)))</expression>
    </formulas>
    <formulas>
        <name>formulaSingleStipSelected</name>
        <dataType>String</dataType>
        <expression>LEFT({!varSelectedStips},18)</expression>
    </formulas>
    <formulas>
        <name>formulaUserName</name>
        <dataType>String</dataType>
        <expression>{!$User.Full_Name__c}</expression>
    </formulas>
    <interviewLabel>Stipulations - Clear Stips {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stipulations - Clear Stips</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_Stips</name>
        <label>Update Stips</label>
        <locationX>897</locationX>
        <locationY>229</locationY>
        <inputReference>varColStipstoUpdate</inputReference>
    </recordUpdates>
    <screens>
        <name>Clear_Stips</name>
        <label>Clear Stips</label>
        <locationX>185</locationX>
        <locationY>50</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Assign_Selected_Stip_ID_s_to_Variable</targetReference>
        </connector>
        <fields>
            <name>Select_Stips_to_Clear</name>
            <choiceReferences>varStipRecords</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select Stips to Clear</fieldText>
            <fieldType>MultiSelectCheckboxes</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>Clear_Stips</startElementReference>
    <status>Active</status>
    <variables>
        <name>inputFundingId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varColStipstoUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Stipulations__c</objectType>
    </variables>
    <variables>
        <name>varSelectedStipId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varSelectedStips</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varSingleStipRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Stipulations__c</objectType>
    </variables>
</Flow>
