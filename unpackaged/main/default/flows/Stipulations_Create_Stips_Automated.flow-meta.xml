    <description>Added Path if Bank Verification Stip Already Exists and sorted Stips by description to reduce loop cycles.</description>
    <formulas>
        <name>formulaBankVerification</name>
        <dataType>Boolean</dataType>
        <expression>    IF(
        OR(
            AND(
                {!inputFundingAmount}&gt;100000,
                {!inputOpptyRecordType}={!conOpptyRecordTypeBroker},
                OR(
                    {!inputOpptyType}={!conOpptyTypeConcurrent}, 
                    {!inputOpptyType}={!conOpptyTypeNew}
                )
            ),
            
            AND (
                {!inputFundingAmount}&gt;100000,
                {!inputOpptyRecordType}={!conOpptyRecordTypeDirect},
                {!inputOpptyType}={!conOpptyTypeNew}   
            )
        ),
        TRUE, 
        FALSE
    )</expression>
    </formulas>
    <formulas>
        <name>formulaCurrentUser</name>
        <dataType>String</dataType>
        <expression>{!$User.Full_Name__c}</expression>
    </formulas>
    <formulas>
        <name>formulaDocsInReview</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(
{!inputOpptyRecordType}={!conOpptyRecordTypeBroker},
{!inputFundingAmount}&gt;50000,
OR(
{!inputOpptyType}={!conOpptyTypeConcurrent}, 
{!inputOpptyType}={!conOpptyTypeNew}
) 
),
TRUE, 
FALSE
)</expression>
    </formulas>
