    <decisions>
        <name>Payment_Behind_Schedule_Decision</name>
        <label>Payment Behind Schedule Decision</label>
        <locationX>390</locationX>
        <locationY>51</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Payment_is_Behind_Schedule</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>F_CurrentlyBehindSchedule</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_Currently_Behind</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_Currently_Behind</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Payment_Agreement_Record</targetReference>
            </connector>
            <label>Payment is Behind Schedule</label>
        </rules>
        <rules>
            <name>Payment_No_Longer_Behind_Schedule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_CurrentlyBehindSchedule</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_Currently_Behind</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Payment_Agreement</targetReference>
            </connector>
            <label>Payment No Longer Behind Schedule</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_we_Send_the_Payment_Agreement_Email</name>
        <label>Should we Send the Payment Agreement Email?</label>
        <locationX>878</locationX>
        <locationY>232</locationY>
        <defaultConnector>
            <targetReference>Update_Payment_Agreement</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_CurrentlyBehindSchedule</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_PaymentAgreement_OptOut</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_MatterRecord.Local_Counsel__r.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Record_PaymentAgreement.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Payment_Alert_Email</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>+update Lead Attorney look up to reference Email Notification custom setting (PD-5008)</description>
    <environments>Default</environments>
    <formulas>
        <name>F_CurrentlyBehindSchedule</name>
        <dataType>Boolean</dataType>
        <expression>IF( {!Var_BalancePaid} &lt; {!Var_totalExpectedBalance}, TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>F_EmailRecipients</name>
        <dataType>String</dataType>
        <expression>{!Var_LeadAttorneyEmail}+&quot;,&quot;+{!Var_LeadCounselEmail}</expression>
    </formulas>
