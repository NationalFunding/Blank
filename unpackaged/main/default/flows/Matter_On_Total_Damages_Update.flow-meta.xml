    <description>Last Update: 6/26/2025 - BAU-551, update attorney fee (judgment cost) calculation on total damages population.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_judgment_cost</name>
        <dataType>Currency</dataType>
        <expression>{!var_matter_judgment_fee_setting.Baseline_Fees_Recoverable__c} + (({!$Record.Total_Damages__c} -{!var_matter_judgment_fee_setting.Percent_Excess_of_Amount__c})*{!var_matter_judgment_fee_setting.Percent_Excess__c}/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_judgment_cost_sd</name>
        <dataType>Currency</dataType>
        <expression>{!var_matter_judgment_fee_setting.Baseline_Fees_Recoverable__c} + (({!$Record.Total_Damages__c} -{!var_matter_judgment_fee_setting.Percent_Excess_of_Amount__c})*{!var_matter_judgment_fee_setting.Percent_Excess__c}/100)
+ IF({!$Record.Total_Damages__c} &lt;= 50000, 0, 
       IF({!$Record.Total_Damages__c} &gt; 100000, 1000, 
           500))</expression>
        <scale>2</scale>
    </formulas>
