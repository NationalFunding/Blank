    <decisions>
        <name>San_Diego_Court</name>
        <label>San Diego Court?</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Get_Matter_Judgment_Fee_Settings_Other</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_San_Diego_Court</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.advpm__Court__r.advpm__Venue__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>San Diego</stringValue>
                </rightValue>
            </conditions>
            <connector>
