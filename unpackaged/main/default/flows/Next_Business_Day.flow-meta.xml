    <formulas>
        <name>formNextBusinessDay</name>
        <dataType>Date</dataType>
        <expression>CASE(
MOD( {!varInputDate}- DATE(1900, 1, 7), 7),
0, {!varInputDate}+1, /*if varInputDate is Sun,varInputDate+1=Monday */
1, {!varInputDate}+1, /*if varInputDate is Mon,varInputDate+1=Tuesday */
2, {!varInputDate}+1, /*if varInputDate is Tues,varInputDate+1=Wednesday */
3, {!varInputDate}+1, /*if varInputDate is Wed,varInputDate+1=Thursday*/
4, {!varInputDate}+1, /*if varInputDate is Thurs,varInputDate+1=Friday */
5,{!varInputDate}+3, /*if varInputDate is Fri,varInputDate+3=Monday next week */
6,{!varInputDate}+2, /*if varInputDate is Sat,varInputDate+2=Monday next week */

{!varInputDate})</expression>
    </formulas>
    <interviewLabel>Next Business Day {!$Flow.CurrentDateTime}</interviewLabel>
