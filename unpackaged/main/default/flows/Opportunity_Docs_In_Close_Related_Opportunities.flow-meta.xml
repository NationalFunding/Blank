    <decisions>
        <name>Should_the_Oppty_be_Closed</name>
        <label>Should the Oppty be Closed?</label>
        <locationX>1108</locationX>
        <locationY>205</locationY>
        <defaultConnector>
            <targetReference>Loop_Related_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Close</name>
            <conditionLogic>1 AND 2 AND (3 OR 4 OR 5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Related_Opportunities.Opportunity__r.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Related_Opportunities.Opportunity__r.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NEW</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Related_Opportunities.Opportunity__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conBroker_WC_Oppty</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Related_Opportunities.Opportunity__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conBroker_FRPSA</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Related_Opportunities.Opportunity__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conFRPSA</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Related_Opportunities.Opportunity__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conMCA_Oppty</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity</targetReference>
            </connector>
            <label>Yes - Close</label>
        </rules>
    </decisions>
    <description>Requested by underwriting to automatically close all in-progress deals for a customer once the first one reaches docs-in (Won deal)
JIRA: SD-5814
+ Add Opportunity Id to LogMessage PD-4121</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaNFBRErrorCode</name>
        <dataType>String</dataType>
        <expression>IF({!Error} = True, &quot;Invoke_NFBR_ROS.varErrorCode&quot;, &quot;N/A&quot;)</expression>
    </formulas>
    <formulas>
        <description>Holds the record types used in various decision elements</description>
        <name>formulaRecordTypes</name>
        <dataType>Boolean</dataType>
        <expression>IF(
	OR(
		{!Loop_Related_Opportunities.Opportunity__r.RecordType.DeveloperName} = &apos;Broker WC Oppty&apos;,
		{!Loop_Related_Opportunities.Opportunity__r.RecordType.DeveloperName} = &apos;Broker FRPSA&apos;,
		{!Loop_Related_Opportunities.Opportunity__r.RecordType.DeveloperName} = &apos;MCA_Oppty&apos;,
		{!Loop_Related_Opportunities.Opportunity__r.RecordType.DeveloperName} = &apos;FRPSA&apos;
		),
	TRUE,
	FALSE
)</expression>
    </formulas>
