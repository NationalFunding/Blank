    <formulas>
        <name>formulaCRStatus</name>
        <dataType>String</dataType>
        <expression>IF(
{!varOpptyRecordType}=&apos;Broker_WC_Oppty&apos;,
{!conNFDecline},
{!conDeclined}
)</expression>
    </formulas>
    <formulas>
        <name>formulaDeclinedDate</name>
        <dataType>DateTime</dataType>
        <expression>IF(
{!varOpptyRecordType}=&apos;Broker_WC_Oppty&apos;,
{!$Flow.CurrentDateTime},
null
)</expression>
    </formulas>
    <formulas>
        <name>formulaDeclineReasonsBroker</name>
        <dataType>String</dataType>
        <expression>IF(
{!varOpptyRecordType}=&apos;Broker_WC_Oppty&apos;,
{!varDeclineReason},
&apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>formulaDeclineReasonsWC</name>
        <dataType>String</dataType>
        <expression>IF(
{!varOpptyRecordType}=&apos;MCA_Oppty&apos;,
{!varDeclineReason},
&apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>formulaeNoahProcessingComplete</name>
        <dataType>Boolean</dataType>
        <expression>IF(
ISBLANK({!vareNoahCompleteDate}),
false,
true
)</expression>
    </formulas>
    <formulas>
        <name>formulaInternalDeclineDate</name>
        <dataType>DateTime</dataType>
        <expression>IF(
AND(
{!varOpptyRecordType}=&apos;MCA_Oppty&apos;,
{!varExitPath}&lt;&gt;&apos;C.3&apos;),
{!$Flow.CurrentDateTime},
null
)</expression>
    </formulas>
    <formulas>
        <name>formulaNFDeclineDate</name>
        <dataType>DateTime</dataType>
        <expression>IF(
AND(
{!varOpptyRecordType}=&apos;MCA_Oppty&apos;,
{!varExitPath}=&apos;C.3&apos;),
{!$Flow.CurrentDateTime},
null
)</expression>
    </formulas>
    <formulas>
        <description>If Broker Opportunity, update stage to Declined. If Working Capital, update stage to NF Decline.</description>
        <name>formulaOpptyStage</name>
        <dataType>String</dataType>
        <expression>IF(
{!varOpptyRecordType}=&apos;Broker_WC_Oppty&apos;,
{!conDeclined},
IF(
AND(
{!varOpptyRecordType}=&apos;MCA_Oppty&apos;,
{!varExitPath}=&apos;C.3&apos;),
{!conNFDecline},
{!conInternalDecline}
))</expression>
    </formulas>
    <formulas>
        <name>formulaProcessStep</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
{!varProcessStepNumber}=1, 
{!varStep1Status}&lt;&gt;{!conContinue}),
{!varStep1},
IF(
AND(
{!varProcessStepNumber}=2, 
{!varStep2Status}&lt;&gt;{!conContinue}),
{!varStep2},
{!conFinish}
))</expression>
    </formulas>
    <formulas>
        <name>formulaProcessStepNumber</name>
        <dataType>Number</dataType>
        <expression>IF(
{!varProcessStepNumber}&lt;{!varTotalSteps},
({!varProcessStepNumber}+1),
{!varProcessStepNumber}
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaProcessStepResult</name>
        <dataType>String</dataType>
        <expression>IF(
{!varProcessStepNumber}=1,
{!varStep1Status},
IF(
{!varProcessStepNumber}=2,
{!varStep2Status},
{!conContinue}
))</expression>
    </formulas>
    <formulas>
        <description>If Working Capital, update Send to Syndication to TRUE. If Broker, leave as FALSE.</description>
        <name>formulaSendtoSyndication</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(
{!varOpptyRecordType}=&apos;MCA_Oppty&apos;,
{!varExitPath}=&apos;C.3&apos;),
TRUE,
FALSE)</expression>
    </formulas>
    <formulas>
        <name>formulaStep1Result</name>
        <dataType>String</dataType>
        <expression>IF(
{!varProcessStepNumber}=1,
{!varProcessStepResult},
{!varStep1Status}
)</expression>
    </formulas>
    <formulas>
        <name>formulaStep2Result</name>
        <dataType>String</dataType>
        <expression>IF(
{!varProcessStepNumber}=2,
{!varProcessStepResult},
{!varStep2Status}
)</expression>
    </formulas>
