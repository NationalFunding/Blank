    <formulas>
        <name>formula_brand</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!Get_Opportunity.Brand_Experience__c}, &apos;Quick Bridge&apos;), &apos;Quick Bridge&apos;, &apos;National Funding&apos;)</expression>
    </formulas>
    <formulas>
        <name>formula_DefaultPricingDefMethodValue</name>
        <dataType>String</dataType>
        <expression>IF(
CONTAINS(UPPER(TEXT({!varFundingRecord.Opportunity__r.Type})),&quot;RENEWAL&quot;),
&quot;0&quot;,
&quot;A&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formula_OriginalPricingDefinitionValue</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK(LEFT({!varFundingRecord.Pricing_Definition__r.Method_Value__c},1)),{!formula_DefaultPricingDefMethodValue},
LEFT({!varFundingRecord.Pricing_Definition__r.Method_Value__c},1)
)</expression>
    </formulas>
    <formulas>
        <name>formula_PricingDefChannel</name>
        <dataType>String</dataType>
        <expression>IF(
CONTAINS(UPPER(TEXT({!varFundingRecord.Opportunity__r.Type})),&quot;RENEWAL&quot;),&quot;Renewal&quot;,
&quot;Direct&quot;)</expression>
    </formulas>
