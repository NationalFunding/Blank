    <decisions>
        <name>Account_Id_Exists</name>
        <label>Account Id Exists</label>
        <locationX>153</locationX>
        <locationY>341</locationY>
        <defaultConnectorLabel>Null</defaultConnectorLabel>
        <rules>
            <name>Account_ID_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Matter_Record.advpm__Primary_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Charged_Off_Opportunities</targetReference>
            </connector>
            <label>Account ID Not Null</label>
        </rules>
    </decisions>
    <decisions>
        <description>Add Charge Off Amount if Matter Record Type is Litigation or Enforcement, otherwise do not add to the total amount.</description>
        <name>Add_Charge_Off_Amount</name>
        <label>Add Charge Off Amount</label>
        <locationX>621</locationX>
        <locationY>534</locationY>
        <defaultConnector>
            <targetReference>Loop_Matters</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip</defaultConnectorLabel>
        <rules>
            <name>Add_Charge_Off_Amount_0</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>loopVarMatterSumAmount.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Litigation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopVarMatterSumAmount.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enforcement</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopVarMatterSumAmount.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>External_Collection</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Amount_to_Charge_of_Total</targetReference>
            </connector>
            <label>Add Charge Off Amount</label>
        </rules>
    </decisions>
    <interviewLabel>Matter - Sum Total Charge Off Deals for Customer {!$Flow.CurrentDateTime}</interviewLabel>
