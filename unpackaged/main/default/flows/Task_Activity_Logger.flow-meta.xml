<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Invokes the activity logger sub flow to populate activity fields based on this task</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_activity_description</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!$Record.Five9__Five9SessionId__c})),
    &quot;Disposition:&quot;&amp;{!$Record.CallDisposition}&amp;&quot;. &quot;&amp;{!$Record.Description},
    {!$Record.Description}
)</expression>
    </formulas>
    <formulas>
        <name>formula_record_id</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!$Record.WhatId})),
    {!$Record.WhatId},
    {!$Record.WhoId}
)</expression>
    </formulas>
    <interviewLabel>Task - Activity Logger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task - Activity Logger</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>(1 OR 2) AND 3 AND 4</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>WhoId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>TaskSubtype</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Task</stringValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Log_Activity</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Log_Activity</name>
        <label>Log Activity</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <flowName>Activity_Logger</flowName>
        <inputAssignments>
            <name>var_activity_datetime</name>
            <value>
                <elementReference>$Record.CompletedDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>var_activity_description</name>
            <value>
                <elementReference>formula_activity_description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>var_activity_type</name>
            <value>
                <elementReference>$Record.TaskSubtype</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>var_record_id</name>
            <value>
                <elementReference>formula_record_id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
