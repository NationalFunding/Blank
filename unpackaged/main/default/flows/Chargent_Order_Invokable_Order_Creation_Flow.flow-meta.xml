    <description>invokable flow to create one time or recurring Chargent Order with Payment Request link
-utilized by Case Catch Up Drip (PD-4226)</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_charge_amount</name>
        <dataType>Currency</dataType>
        <expression>IF({!var_payment_stop}=&quot;Balance Due&quot;,
{!input_case_record.Opportunity__r.Actual_Daily_Payment__c},
ROUND(({!input_case_record.Opportunity__r.Past_Due_Balance__c}/{!var_payment_count}),2)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_payment_template</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!input_case_record.Originating_Lender_formula__c},&quot;National Funding&quot;),&quot;NF_Payment_Request&quot;,
 IF(CONTAINS({!input_case_record.Originating_Lender_formula__c},&quot;Quick Bridge&quot;),&quot;QB_Payment_Request&quot;,&quot;&quot;))</expression>
    </formulas>
