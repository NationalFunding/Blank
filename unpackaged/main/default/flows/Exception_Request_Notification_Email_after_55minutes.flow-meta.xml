    <description>Notifies Bryan Timmons and the assigned approver of an Exception Request that is not cleared after 55minutes post-submission.

Request from Sandra Otero: https://nationalfunding.atlassian.net/browse/SD-4633</description>
    <formulas>
        <name>formulaDealType</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        OR(
            {!$Record.Opportunity__r.RecordType.DeveloperName} = &quot;MCA_Oppty&quot;,
            {!$Record.Opportunity__r.RecordType.DeveloperName} = &quot;FRPSA&quot;
        ),
        OR(
            ISPICKVAL({!$Record.Opportunity__r.Type}, &quot;Concurrent&quot;),
            ISPICKVAL({!$Record.Opportunity__r.Type}, &quot;New&quot;)
        )
    ),
        &quot;Direct&quot;,
        IF(
            AND(
                OR(
                    {!$Record.Opportunity__r.RecordType.DeveloperName} = &quot;Broker_FRPSA&quot;,
                    {!$Record.Opportunity__r.RecordType.DeveloperName} = &quot;Broker_WC_Oppty&quot;
                ),
                OR(
                    ISPICKVAL({!$Record.Opportunity__r.Type}, &quot;Concurrent&quot;),
                    ISPICKVAL({!$Record.Opportunity__r.Type}, &quot;New&quot;)
                )
            ), 
        &quot;Broker&quot;,
        IF(
            OR(
                NOT(ISPICKVAL({!$Record.Opportunity__r.Type}, &quot;Concurrent&quot;)),
                NOT(ISPICKVAL({!$Record.Opportunity__r.Type}, &quot;New&quot;))
            ),
        &quot;Renewal&quot;, null
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>formulaExceptionCleared</name>
        <dataType>Boolean</dataType>
        <expression>OR (
ISPICKVAL({!$Record.Status__c}, &quot;Approved&quot;),
ISPICKVAL({!$Record.Status__c}, &quot;Rejected Level 1&quot;),
ISPICKVAL({!$Record.Status__c}, &quot;Rejected Final&quot;)
)</expression>
    </formulas>
