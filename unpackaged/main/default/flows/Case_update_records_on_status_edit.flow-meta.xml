    <description>update Account broker refresh status
update case dates when closed</description>
    <formulas>
        <name>formulaAcctRefreshApprovedBy</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Broker_Refresh_Status__c},&quot;Broker Refresh Completed&quot;),{!formulaCaseApprovedBy},{!$Record.Account.Refresh_Approved_By__c})</expression>
    </formulas>
    <formulas>
        <name>formulaAcctRefreshCompletedDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISPICKVAL({!$Record.Broker_Refresh_Status__c},&quot;Broker Refresh Completed&quot;), {!formulaCaseCompletedDate},{!$Record.Broker_Refresh_Completed__c})</expression>
    </formulas>
    <formulas>
        <name>formulaCaseApprovedBy</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Refresh_Approved_by__c}),{!$User.Id},{!$Record.Refresh_Approved_by__c})</expression>
    </formulas>
    <formulas>
        <name>formulaCaseCompletedDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.Broker_Refresh_Completed__c}), {!$Flow.CurrentDate}, {!$Record.Broker_Refresh_Completed__c})</expression>
    </formulas>
    <formulas>
        <name>formulaNextRefreshDue</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.Next_Broker_Refresh_Due__c}),{!formulaCaseCompletedDate}+365,{!$Record.Next_Broker_Refresh_Due__c})</expression>
    </formulas>
    <formulas>
        <name>formulaRefreshDue</name>
        <dataType>Date</dataType>
        <expression>IF(ISPICKVAL({!$Record.Broker_Refresh_Status__c},&quot;Broker Refresh Completed&quot;),{!formulaNextRefreshDue},{!$Record.Account.Broker_Refresh_Due__c})</expression>
    </formulas>
