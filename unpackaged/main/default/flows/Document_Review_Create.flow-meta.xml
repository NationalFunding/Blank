    <formulas>
        <name>formulaCreditReviewCompletedByUser</name>
        <dataType>String</dataType>
        <expression>IF( 
ISBLANK({!CreditReviewSObject.Pt_Rev_Completed_By__c}),
{!$User.FirstName} &amp; &apos; &apos; &amp; {!$User.LastName},
{!CreditReviewSObject.Pt_Rev_Completed_By__c}
)</expression>
    </formulas>
    <formulas>
        <name>formulaCreditReviewCompletedDate</name>
        <dataType>DateTime</dataType>
        <expression>IF( 
ISBLANK({!CreditReviewSObject.PT_Rev_Completed_Date__c}),
{!$Flow.CurrentDateTime},
{!CreditReviewSObject.PT_Rev_Completed_Date__c}
)</expression>
    </formulas>
    <formulas>
        <name>formulaCreditReviewStatus</name>
        <dataType>String</dataType>
        <expression>IF(
ISPICKVAL({!CreditReviewSObject.Status__c}, &apos;Approved&apos;), &apos;Withdrawn&apos;,
IF(
{!CreditReviewSObject.Opportunity__r.RecordType.DeveloperName} = &apos;Broker_WC_Oppty&apos;, &apos;NF Decline&apos;,
&apos;Declined&apos;
))</expression>
    </formulas>
