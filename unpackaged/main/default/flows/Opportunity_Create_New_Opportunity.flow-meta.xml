        &quot;E&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;F&quot;,
        &quot;F&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;G&quot;,
        &quot;G&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;H&quot;,
        &quot;H&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;I&quot;,
        &quot;I&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;J&quot;,
        &quot;J&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;K&quot;,
        &quot;K&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;L&quot;,
        &quot;L&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;M&quot;,
        &quot;M&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;N&quot;,
        &quot;N&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;O&quot;,
        &quot;O&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;P&quot;,
        &quot;P&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;Q&quot;,
        &quot;Q&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;R&quot;,
        &quot;R&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;S&quot;,
        &quot;S&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;T&quot;,
        &quot;T&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;U&quot;,
        &quot;U&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;V&quot;,
        &quot;V&quot;, LEFT( {!var_funded_renewal_merchant_number} , LEN({!var_funded_renewal_merchant_number})- 1) &amp; &quot;W&quot;,
