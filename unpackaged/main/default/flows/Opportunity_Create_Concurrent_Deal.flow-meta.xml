    <formulas>
        <name>formula_Amount</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Opportunity.Approval_Amount__c}-{!Get_Opportunity.ACTUAL_AMT_OFFERED__c}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formula_BrokerAccount</name>
        <dataType>Boolean</dataType>
        <expression>IF(
 OR(
  ISBLANK({!Get_Opportunity.Broker_Account__c}),ISNULL({!Get_Opportunity.Broker_Account__c})), FALSE, TRUE)</expression>
    </formulas>
    <formulas>
        <name>formula_CloseDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+14</expression>
    </formulas>
    <formulas>
        <name>formula_Name</name>
        <dataType>String</dataType>
        <expression>{!Get_Opportunity.Account.Name} &amp; &quot; - &quot; &amp; {!Get_Opportunity.RecordType.Name} &amp;&quot; &quot;&amp;{!formula_TypeForName}&amp;&quot; # &quot;&amp; TEXT({!varTypeCount}+1)</expression>
    </formulas>
    <formulas>
        <name>formula_NewMerchantNumber</name>
        <dataType>String</dataType>
        <expression>{!Get_Opportunity.Merchant_Number__c}&amp;&quot;- 1&quot;</expression>
    </formulas>
    <formulas>
        <name>formula_NextActivityDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()+1</expression>
    </formulas>
    <formulas>
        <name>formula_OpportunityType</name>
        <dataType>String</dataType>
        <expression> IF(
    AND(
     ISPICKVAL({!Get_Opportunity.Type},&quot;NEW&quot;), (DATEVALUE({!Get_Opportunity.Fund_Date_For_Actual__c})+30) &gt;=TODAY()
       ), &quot;CONCURRENT&quot;,
&quot;RENEWAL CONCURRENT&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_TypeForName</name>
        <dataType>String</dataType>
        <expression>IF({!formula_OpportunityType}=&quot;CONCURRENT&quot;, &quot;Concurrent&quot;, &quot;Renewal Concurrent&quot;)</expression>
    </formulas>
