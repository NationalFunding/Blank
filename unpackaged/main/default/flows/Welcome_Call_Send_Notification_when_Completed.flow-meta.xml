<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Welcome_Call_Notification_Broker</name>
        <label>Send Welcome Call Notification - Broker</label>
        <locationX>314</locationX>
        <locationY>455</locationY>
        <actionName>Welcome_Call__c.Welcome_Call_Completed_Notification</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Welcome_Call__c.Welcome_Call_Completed_Notification</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <actionCalls>
        <name>Send_Welcome_Call_Notification_Direct</name>
        <label>Send Welcome Call Notification - Direct</label>
        <locationX>50</locationX>
        <locationY>455</locationY>
        <actionName>Welcome_Call__c.Welcome_Call_Completed_Notification_Direct</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Welcome_Call__c.Welcome_Call_Completed_Notification_Direct</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <apiVersion>54.0</apiVersion>
    <decisions>
        <description>Per Bryan Timmons - Welcome call email notifications should not go to the broker preferred email if the deal is a renewal or if its an MLP</description>
        <name>Send_Email_to_Broker</name>
        <label>Send Email to Broker?</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Send_Welcome_Call_Notification_Broker</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>1 OR 2 OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Type</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>RENEWAL</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Direct_MLP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Broker_FRPSA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Broker_WC_Oppty</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Welcome_Call_Notification_Direct</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>Sends an email notification to the opportunity owner and broker (if applicable) when a welcome call is completed. Previously a workflow rule for broker deals but refactoring to include all deal types.

Requested by operations to include all deals but exclude broker notifications if deal is a Renewal or MLP --&gt; SD-5752</description>
    <interviewLabel>Welcome Call - Send Notification when Complete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Welcome Call - Send Notification when Completed</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Email_to_Broker</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WC_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Complete</stringValue>
            </value>
        </filters>
        <object>Welcome_Call__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
