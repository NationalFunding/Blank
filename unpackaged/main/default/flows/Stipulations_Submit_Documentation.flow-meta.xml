    <formulas>
        <name>CommentsIsBlankFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(
LEN({!varNewComments})=0, 
TRUE,
 FALSE
)</expression>
    </formulas>
    <formulas>
        <name>formulaConvertDateTimetoPST</name>
        <dataType>String</dataType>
        <expression>IF ( DATEVALUE({!$Flow.CurrentDateTime}) &gt;=
DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),3,1)
+
(
14-
CASE( MOD(DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),3,1) - DATE (1900,1,7),7) ,
0,7,MOD(DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),3,1) - DATE (1900,1,7),7))
)
&amp;&amp;
DATEVALUE({!$Flow.CurrentDateTime}) &lt;
DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),11,1)
+
(
7-
CASE( MOD(DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),11,1) - DATE (1900,1,7),7) ,
0,7,MOD(DATE ( YEAR (DATEVALUE({!$Flow.CurrentDateTime})),11,1) - DATE (1900,1,7),7))
),
LEFT ( TEXT ({!$Flow.CurrentDateTime}- 7/24 ), 16),
LEFT ( TEXT ({!$Flow.CurrentDateTime}- 8/24), 16)
)</expression>
    </formulas>
    <formulas>
        <name>formulaDocumentName</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;[Stip Document - &quot;  + LEFT({!varStipDescription}, 100) + &quot;] &quot; + SUBSTITUTE(SUBSTITUTE({!Loop_Uploaded_Files.Title}, &quot;[&quot;, &quot;&quot;), &quot;]&quot;, &quot;&quot;), 255)</expression>
    </formulas>
    <formulas>
        <name>formulaLineBreak</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!txtLineBreak},&quot;~&quot;,&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaOwnershipSuggestedDocuments</name>
        <dataType>String</dataType>
        <expression>IF(
CONTAINS({!varStipDescription},&quot;Ownership&quot;),
{!txtOwnershipSuggestedDocs},
&quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaStipComments</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        ISBLANK({!varStipComments}),
        {!CommentsIsBlankFormula}=FALSE),
        {!formulaConvertDateTimetoPST} + &quot; [&quot; + {!$User.Full_Name__c} + &quot;] - &quot; + {!varNewComments}, 
        IF(
            AND(
                NOT(ISBLANK({!varStipComments})),
                {!CommentsIsBlankFormula}=FALSE),
            {!varStipComments} + {!formulaLineBreak} + {!formulaConvertDateTimetoPST} + &quot; [&quot; + {!$User.Full_Name__c} + &quot;] - &quot; + {!varNewComments},
            IF(
                AND(
                    NOT(ISBLANK({!varStipComments})),
                    {!CommentsIsBlankFormula}=TRUE),
                {!varStipComments},
                &apos;&apos;
            )))</expression>
    </formulas>
    <formulas>
        <name>formulaSubmittedDate</name>
        <dataType>DateTime</dataType>
        <expression>IF(ISBLANK({!varSubmittedDate}),{!$Flow.CurrentDateTime},{!varSubmittedDate})</expression>
    </formulas>
