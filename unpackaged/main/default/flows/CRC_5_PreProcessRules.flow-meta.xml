    <description>+ Broker Addendum signature check for Opportunities in NY PD-2162</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaAGSLimit</name>
        <dataType>Currency</dataType>
        <expression>IF(
{!varPreprocessingMdtAGS}&gt;0,{!varPreprocessingMdtAGS},
{!Get_Default_AGS_Limit.AGS_Limit__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaDeclineReasons</name>
        <dataType>String</dataType>
        <expression>CASE(
{!varExitPath},
&apos;PPR.2&apos;,&apos;Banks - Low Deposits&apos;,
&apos;PPR.3&apos;,&apos;Restricted Industry&apos;,
&apos;PPR.4&apos;,&apos;Restricted Industry; Banks - Low Deposits&apos;,
&apos;PPR.5&apos;,&apos;Other&apos;,
&apos;PPR.6&apos;,&apos;Industry Parameters&apos;,
null
)</expression>
    </formulas>
    <formulas>
        <name>formulaExitPath</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
{!varAGSResult}=&apos;Pass&apos;,
{!varSICResult}=&apos;Pass&apos;
),
&apos;PPR.1&apos;,
IF(
AND(
{!varAGSResult}=&apos;Fail&apos;,
{!varSICResult}=&apos;Pass&apos;
),
&apos;PPR.2&apos;,
IF(
AND(
{!varAGSResult}=&apos;Pass&apos;,
{!varSICResult}=&apos;Fail&apos;
),
&apos;PPR.3&apos;,
IF(
AND(
{!varAGSResult}=&apos;Fail&apos;,
{!varSICResult}=&apos;Fail&apos;
),
&apos;PPR.4&apos;,
IF(
{!varBrokerEligibilityCheck} = &apos;Fail&apos;,
&apos;PPR.5&apos;,
IF(
{!varSICHomeBasedResult} = &apos;Fail&apos;,
&apos;PPR.6&apos;,
null
))))))</expression>
    </formulas>
    <formulas>
        <name>formulaHomeAddress</name>
        <dataType>String</dataType>
        <expression>UPPER({!Credit_Review.PG1__r.OtherStreet})</expression>
    </formulas>
    <formulas>
        <name>formulaPhysicalAddress</name>
        <dataType>String</dataType>
        <expression>UPPER({!Credit_Review.Opportunity__r.Addr_Bill1__r.Address_1__c})</expression>
    </formulas>
    <formulas>
        <name>formulaResult</name>
        <dataType>String</dataType>
        <expression>CASE(
{!varExitPath},
&apos;PPR.1&apos;,&apos;Continue&apos;,
&apos;PPR.2&apos;,&apos;Stop&apos;,
&apos;PPR.3&apos;,&apos;Stop&apos;,
&apos;PPR.4&apos;,&apos;Stop&apos;,
&apos;PPR.5&apos;,&apos;Stop&apos;,
&apos;PPR.6&apos;,&apos;Stop&apos;,
&apos;PPR.Error1&apos;,&apos;Manual Review&apos;,
&apos;Error&apos;)</expression>
    </formulas>
    <formulas>
        <name>formulaSyndicate</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(
