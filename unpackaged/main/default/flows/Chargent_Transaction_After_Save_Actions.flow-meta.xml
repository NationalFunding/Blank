    <formulas>
        <name>formula_billing_name</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.ChargentOrders__Credit_Card_Name__c} != NULL, 
{!$Record.ChargentOrders__Credit_Card_Name__c}, {!$Record.ChargentOrders__Billing_First__c} + &apos; &apos; + {!$Record.ChargentOrders__Billing_Last__c})</expression>
    </formulas>
    <formulas>
        <name>formula_card_type</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.ChargentOrders__Payment_Method__c},

&quot;Check&quot;, &quot;Check&quot;,

&quot;Credit Card&quot;, CASE({!$Record.ChargentOrders__Credit_Card_Type__c},

&quot;Visa&quot;, &quot;Visa&quot;,

&quot;Mastercard&quot;, &quot;Mastercard&quot;,

&quot;Discover&quot;, &quot;Discover&quot;,

&quot;American Express&quot;, &quot;American Express&quot;,

&quot;AMEX&quot;, &quot;American Express&quot;,

&quot;MC Eurocard&quot;, &quot;MC Eurocard&quot;,

&quot;UK Maestro&quot;, &quot;UK Maestro&quot;,

&quot;JCB Card&quot;, &quot;JCB Card&quot;,

&quot;Solo&quot;, &quot;Solo&quot;,

&quot;Electron&quot;, &quot;Electron&quot;,

&quot;&quot;),

&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaDeclineDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.ChargentOrders__Gateway_Date__c}</expression>
    </formulas>
    <formulas>
        <name>formulaRecurring</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.ChargentOrders__Recurring__c}=TRUE,&quot;Recurring&quot;,&quot;&quot;)</expression>
    </formulas>
