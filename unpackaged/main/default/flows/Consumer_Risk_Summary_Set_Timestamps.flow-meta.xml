        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Which_Field_to_Timestamp</targetReference>
        </connector>
        <filterFormula>OR(
	ISNEW() &amp;&amp; ISPICKVAL({!$Record.Model_Status__c} , &quot;Processing&quot;),
	ISCHANGED({!$Record.Model_Status__c}) &amp;&amp; 
	(
		ISPICKVAL({!$Record.Model_Status__c} , &quot;Processing&quot;) || 
		ISPICKVAL({!$Record.Model_Status__c} , &quot;Success&quot;) || 
		ISPICKVAL({!$Record.Model_Status__c} ,  &quot;Error&quot;)
	)
)</filterFormula>
        <object>Consumer_Risk_Summary__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
