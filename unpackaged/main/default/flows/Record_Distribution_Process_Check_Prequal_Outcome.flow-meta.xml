    <decisions>
        <name>Tier_2</name>
        <label>Tier 2?</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_AGS_Tier_2</name>
            <conditionLogic>1 OR 2 OR (3 AND 4) OR (5 AND 6)</conditionLogic>
            <conditions>
                <leftValueReference>var_lead_response_journal.AGS_Range__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>$250K-$999K</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_lead_response_journal.Distribution_Tier__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tier 2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_lead_response_journal.Submitted_AGS_Max__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>999999.99</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_lead_response_journal.Submitted_AGS_Min__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>250000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_lead_response_journal.Annual_Revenue__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>999999.99</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_lead_response_journal.Annual_Revenue__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>250000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_No_Prequal_Tier_2_RD</targetReference>
            </connector>
            <label>Yes, AGS = Tier 2</label>
        </rules>
    </decisions>
