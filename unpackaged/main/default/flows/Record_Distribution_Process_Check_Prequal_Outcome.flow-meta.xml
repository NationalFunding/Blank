    <decisions>
        <name>Check_Prequal</name>
        <label>Check Prequal</label>
        <locationX>908</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Assign_Unhandled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_PreQual</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_lead.Principal_Consumer_Risk_Summary__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_PreQual_Outcome</targetReference>
            </connector>
            <label>No PreQual</label>
        </rules>
        <rules>
            <name>Waterfall_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_lead.Principal_Consumer_Risk_Summary__r.Final_Routing__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Waterfall</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Waterfall_RD_Name</targetReference>
            </connector>
            <label>Waterfall Eligible</label>
        </rules>
        <rules>
            <name>SBL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_lead.Principal_Consumer_Risk_Summary__r.Final_Routing__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SBL</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_SBL_RD_Name</targetReference>
            </connector>
            <label>SBL</label>
        </rules>
        <rules>
            <name>Other_OBS_Decline</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_lead.Principal_Consumer_Risk_Summary__r.Final_Routing__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NOT_ELIGIBLE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_lead.Principal_Consumer_Risk_Summary__r.Decisioning_Risk_Rule_Result__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Prequal_RD_Name_with_Rule_Name</targetReference>
            </connector>
            <label>Other OBS Decline</label>
        </rules>
        <rules>
            <name>OBS_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_lead.Principal_Consumer_Risk_Summary__r.Final_Routing__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NF_QB</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_OBS_Eligible</targetReference>
            </connector>
            <label>OBS Eligible</label>
        </rules>
    </decisions>
