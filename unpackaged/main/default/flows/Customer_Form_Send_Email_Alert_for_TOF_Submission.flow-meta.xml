<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <assignments>
        <name>Assign_Matched_Lenders</name>
        <label>Assign Matched Lenders</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_lender_names</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>f_LenderDisplayLine</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Matched_Lenders</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Email_Key</name>
        <label>Set Email Key</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_email_key</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_UTM_Campaign_mdt.Email_Configuration_Key__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Matched_Lender_Opportunities</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Matched_Lender_Opportunities_Found</name>
        <label>Matched Lender Opportunities Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Matched_Lender_Opportunities_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matched_Lender_Opportunities</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Matched_Lenders</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>UTM_Campaign_Metadata_Found</name>
        <label>UTM Campaign Metadata Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_UTM_Campaign_Metadata_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_UTM_Campaign_mdt</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Email_Key</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>SBL-1243 - Adding &apos;not yet started&quot; to the email template if the value is selected.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_LenderDisplayLine</name>
        <dataType>String</dataType>
        <expression>&quot;- &quot; &amp; {!Matched_Lenders.Lender_Profile__r.Lender_Profile_Code__c} &amp; BR()</expression>
    </formulas>
    <formulas>
        <description>Display Date or &quot;not yet started&quot; if null.</description>
        <name>f_TIB</name>
        <dataType>String</dataType>
        <expression>IF(
  TEXT({!$Record.Date_Established_Question__c}) = &quot;Not yet started&quot;,
  &quot;Not yet started&quot;,
  TEXT({!$Record.Date_Established__c})
)</expression>
    </formulas>
    <interviewLabel>Customer Form - Send Email Alert for TOF Submission {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Customer Form - Send Email Alert for TOF Submission</label>
    <loops>
        <description>Get matched lender list</description>
        <name>Matched_Lenders</name>
        <label>Matched Lenders</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Matched_Lender_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Matched_Lenders</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Send_Email_0</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Matched_Lender_Opportunities</name>
        <label>Get Matched Lender Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Matched_Lender_Opportunities_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Open_Opportunity__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Matched_Lender_Opportunity__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_UTM_Campaign_mdt</name>
        <label>Get UTM Campaign mdt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>UTM_Campaign_Metadata_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>MasterLabel</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UTM_Campaign__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email_Configuration_Key__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UTM_Campaign__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_UTM_Campaign_mdt</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Open_Opportunity__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>UTM_Campaign__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>Customer_Form__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Send_Email_0</name>
        <label>Send Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Send_Email</flowName>
        <inputAssignments>
            <name>var_body</name>
            <value>
                <elementReference>tt_EmailBody</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>var_email_key</name>
            <value>
                <elementReference>var_email_key</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>var_subject</name>
            <value>
                <elementReference>tt_EmailSubject</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>tt_EmailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>DBA: {!$Record.Business_Name__c}
AGS: {!$Record.Self_Reported_Annual_Revenue__c}
TIB: {!f_TIB}
Credit: {!$Record.Self_Reported_Credit_Score_Range__c}
Matched Lenders Names
{!var_lender_names}</text>
    </textTemplates>
    <textTemplates>
        <name>tt_EmailSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.UTM_Campaign__c} / {!$Record.Business_Name__c}</text>
    </textTemplates>
    <variables>
        <name>var_email_key</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_lender_names</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
