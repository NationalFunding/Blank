        <locationX>702</locationX>
        <locationY>128</locationY>
        <defaultConnector>
            <targetReference>Get_WC_Credit_Decision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Concurrent</defaultConnectorLabel>
        <rules>
            <name>Concurrent_Deal</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varOpptyRecord.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CONCURRENT</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpptyRecord.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RENEWAL CONCURRENT</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Working_Cap_Oppty_RecordType_Id</targetReference>
            </connector>
            <label>Concurrent Deal</label>
        </rules>
