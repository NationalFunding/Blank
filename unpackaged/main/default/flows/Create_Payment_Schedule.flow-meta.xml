    <formulas>
        <name>formulaBankChangeSummary</name>
        <dataType>String</dataType>
        <expression>&quot;Bank Account: &quot; + {!BankName} + &quot;. Account Number: &quot; + {!Account_Number} + &quot;| Routing Number: &quot; + {!Routing_Number} + {!formulaLineBreak}</expression>
    </formulas>
    <formulas>
        <name>formulaLineBreak</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!txtLineBreak},&quot;~&quot;,&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaSettlementAgreementSummaryAdd</name>
        <dataType>String</dataType>
        <expression>{!varActgInstructionComments} + {!formulaLineBreak} + TEXT({!varPaymentTotal}) + &quot; &quot; + {!varFrequency} + &quot; payments of $&quot; + TEXT({!varAmount}) + &quot; starting &quot; + TEXT({!varStartDate})</expression>
    </formulas>
    <formulas>
        <name>formulaSettlementAgreementSummaryFirst</name>
        <dataType>String</dataType>
        <expression>{!formulaBankChangeSummary}+ &quot;Settlement Agreement: $&quot; + TEXT({!varTotalSettlementAmount}) + {!formulaLineBreak} + TEXT({!varPaymentTotal}) + &quot; &quot; + {!varFrequency} + &quot; payments of $&quot; + TEXT({!varAmount}) + &quot; starting &quot; + TEXT({!varStartDate})</expression>
    </formulas>
