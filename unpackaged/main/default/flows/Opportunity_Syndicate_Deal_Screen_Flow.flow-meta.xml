    <decisions>
        <name>Syndicate</name>
        <label>Syndicate?</label>
        <locationX>614</locationX>
        <locationY>332</locationY>
        <defaultConnector>
            <targetReference>No_Permission_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Check_Eligibility_to_Syndicate.var_eligible_for_syndication</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Check_Eligibility_to_Syndicate.var_user_exception</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Trigger_Syndication</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
        <rules>
            <name>No_and_cannot_be_overriden</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Eligibility_to_Syndicate.var_not_eligible_message</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Declined_Stage</targetReference>
            </connector>
            <label>No, and cannot be overriden</label>
        </rules>
    </decisions>
    <decisions>
        <name>Syndication_Result</name>
        <label>Syndication Result</label>
        <locationX>1014</locationX>
        <locationY>331</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resubmit</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Success_Screen</targetReference>
            </connector>
            <label>Success</label>
        </rules>
        <rules>
            <name>No_Eligible_Lenders</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Declined</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Eligible_Lenders_Screen</targetReference>
            </connector>
            <label>No Eligible Lenders</label>
        </rules>
        <rules>
            <name>Inelligible_Decline_Reason</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal Decline</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Inelligble_Decline_Reason_Screen</targetReference>
            </connector>
            <label>Inelligible Decline Reason</label>
        </rules>
    </decisions>
