                <rightValue>
                    <stringValue>NEW</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lender_Name_Workflow__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>National Funding</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Syndicate</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
