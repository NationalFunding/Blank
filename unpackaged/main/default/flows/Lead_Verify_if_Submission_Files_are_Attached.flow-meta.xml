    <decisions>
        <description>Check to see if both required documents are uploaded</description>
        <name>Both_Documents_Attached</name>
        <label>Both Documents Attached?</label>
        <locationX>182</locationX>
        <locationY>2042</locationY>
        <defaultConnector>
            <targetReference>Update_Lead_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Attached</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>varCount_BankStatement</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCount_CreditApplication</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.FCRA_Accepted_Date_Time__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead</targetReference>
            </connector>
            <label>Yes - Attached</label>
        </rules>
    </decisions>
    <decisions>
        <description>Set the count to indicate we found a correct document</description>
        <name>Check_for_Correct_Attached_Docs</name>
        <label>Check for Correct Attached Docs</label>
        <locationX>534</locationX>
        <locationY>458</locationY>
        <defaultConnector>
