        <rules>
            <name>Credit_Application</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_attachments.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>[Credit Application]</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Count_Credit_Attachments</targetReference>
            </connector>
            <label>Credit Application</label>
        </rules>
        <rules>
            <name>Bank_Statement</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_attachments.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>[Bank Statement]</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_attachments.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>[Business Bank Statements]</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Count_Bank_Attachments</targetReference>
            </connector>
            <label>Bank Statement</label>
        </rules>
    </decisions>
