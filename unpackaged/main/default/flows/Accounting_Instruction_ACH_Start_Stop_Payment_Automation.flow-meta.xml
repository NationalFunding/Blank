    <formulas>
        <name>fomulaNextWeeklyPaymentDate</name>
        <dataType>Date</dataType>
        <expression>IF(
{!Get_Default_Repayment_Schedule.Repayment_Day_of_Week__c}&gt;=(WEEKDAY({!varACHonDate})-1),
{!varACHonDate}+({!Get_Default_Repayment_Schedule.Repayment_Day_of_Week__c}-WEEKDAY({!varACHonDate})+1),
{!varACHonDate}+7-(WEEKDAY({!varACHonDate})-1-{!Get_Default_Repayment_Schedule.Repayment_Day_of_Week__c})
)</expression>
    </formulas>
    <formulas>
        <name>formulaCalculatedACHDate</name>
        <dataType>Date</dataType>
        <expression>IF(
OR(ISNULL({!Loop_ACH_Actions.ACH_Date__c}),
    {!Loop_ACH_Actions.ACH_Date__c}=TODAY(),
       {!Loop_ACH_Actions.ACH_Date__c}&lt;TODAY()),
TODAY(),
IF(
    AND(({!Loop_ACH_Actions.ACH_Date__c}-1)={!$Record.Case__r.Repayment__r.cmbls__Next_Hit_Date__c},
           TEXT({!Get_Default_Repayment_Schedule.cmbls__Preset__c})=&quot;Weekly&quot;),
{!Loop_ACH_Actions.ACH_Date__c},
{!Loop_ACH_Actions.ACH_Date__c}-1))</expression>
    </formulas>
    <formulas>
        <name>formulaNextDailyPaymentDate</name>
        <dataType>Date</dataType>
        <expression>IF(
{!varACHonDate}=TODAY()+1,
{!varNextBusinessDay},
{!varACHonDate})</expression>
    </formulas>
    <formulas>
        <name>formulaRepaymentOnStatus</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Case__r.Opportunity__r.Internal_Funding_Status__c})=&quot;Funded&quot;, &quot;Active&quot;,&quot;Recovery&quot;)</expression>
    </formulas>
