    <description>+ bug fix to multiple bounce cases consolidation created on the same day PD-2220</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_CaseSubject</name>
        <dataType>String</dataType>
        <expression>{!formula_NewCase_AgreementNumber}+&apos; &apos;+{!$Record.cmbls__Repayment__r.Opportunity__r.Legal_Name__c}+&apos; ACH Bounce&apos;</expression>
    </formulas>
    <formulas>
        <name>formula_CaseUpdate_MultipleBounces</name>
        <dataType>String</dataType>
        <expression>IF({!var_ReversalPaymentCounter}&gt;1, {!var_CombinedMultipleBounces}, {!formula_FormattedReversalEffectiveDate}+&quot;. $&quot;+TEXT({!$Record.cmbls__Transaction_Amount__c})+&quot;. Auth Pmt &quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_ExceptionMessage</name>
        <dataType>String</dataType>
        <expression>&apos;No bounce case created for PyamentId:&apos; +{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>formula_FormattedReversalEffectiveDate</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!$Record.cmbls__Reversal_Of__r.cmbls__Effective_Date__c}))+&quot;/&quot;+TEXT(DAY({!$Record.cmbls__Reversal_Of__r.cmbls__Effective_Date__c}))+&quot;/&quot;+TEXT(YEAR({!$Record.cmbls__Reversal_Of__r.cmbls__Effective_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>formula_InsertMultipleBounces</name>
        <dataType>String</dataType>
        <expression>IF({!var_ReversalPaymentCounter}&gt;1, {!var_CombinedMultipleBounces}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_MultipleBounceInsertFirstLine</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!varCaseCreatedToday.Date_of_Bounce__c}))+&quot;/&quot; +TEXT(DAY({!varCaseCreatedToday.Date_of_Bounce__c}))+&quot;/&quot; +TEXT(YEAR({!varCaseCreatedToday.Date_of_Bounce__c}))+&apos;. $&apos;+TEXT({!varCaseCreatedToday.Debit_Amount__c})+&apos;. &apos;+{!varCaseCreatedToday.Payment_Type__c}</expression>
    </formulas>
    <formulas>
        <name>formula_MultipleBouncesToAdd</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!Loop_Through_Payments.cmbls__Reversal_Of__r.cmbls__Effective_Date__c}))+&quot;/&quot;+TEXT(DAY({!Loop_Through_Payments.cmbls__Reversal_Of__r.cmbls__Effective_Date__c}))+&quot;/&quot;+TEXT(YEAR({!Loop_Through_Payments.cmbls__Reversal_Of__r.cmbls__Effective_Date__c}))+&quot;. $&quot;+TEXT({!Loop_Through_Payments.cmbls__Transaction_Amount__c})+&quot;. Auth Pmt &quot;</expression>
    </formulas>
    <formulas>
        <name>formula_NewCase_AgreementNumber</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!$Record.cmbls__Repayment__r.Opportunity__r.Merchant_Number__c}), {!$Record.cmbls__Repayment__r.Opportunity__r.Lease_Number__c},
{!$Record.cmbls__Repayment__r.Opportunity__r.Merchant_Number__c}
)</expression>
    </formulas>
    <formulas>
        <name>formula_PaymentCreatedToday</name>
        <dataType>Boolean</dataType>
        <expression>IF(DATEVALUE({!Loop_Through_Payments.CreatedDate})=TODAY(), TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>formula_Yesterday</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY()-1)</expression>
    </formulas>
    <formulas>
        <name>formulaCaseIsCreatedToday</name>
        <dataType>Boolean</dataType>
        <expression>IF(DATEVALUE({!Loop_Cases.CreatedDate})=TODAY(), TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>formulaLogMessage</name>
        <dataType>String</dataType>
        <expression>&quot;An Exception was encountered on Create New Bounce Case Flow. Record ID: &quot; + {!$Record.Id}</expression>
    </formulas>
