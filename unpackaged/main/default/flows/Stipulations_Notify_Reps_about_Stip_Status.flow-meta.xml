    <environments>Default</environments>
    <formulas>
        <name>formulaDealType</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        OR(
            {!$Record.Oppty_Name__r.RecordType.DeveloperName} = &quot;MCA_Oppty&quot;,
            {!$Record.Oppty_Name__r.RecordType.DeveloperName} = &quot;FRPSA&quot;
        ),
        OR(
            {!$Record.Opportunity_Type__c} = &quot;Concurrent&quot;,
            {!$Record.Opportunity_Type__c} = &quot;New&quot;
        )
    ),
        &quot;Direct&quot;,
        IF(
            AND(
                OR(
                    {!$Record.Oppty_Name__r.RecordType.DeveloperName} = &quot;Broker_FRPSA&quot;,
                    {!$Record.Oppty_Name__r.RecordType.DeveloperName} = &quot;Broker_WC_Oppty&quot;
                ),
                OR(
                    {!$Record.Opportunity_Type__c} = &quot;Concurrent&quot;,
                    {!$Record.Opportunity_Type__c} = &quot;New&quot;
                )
            ), 
        &quot;Broker&quot;,
        IF(
            OR(
                {!$Record.Opportunity_Type__c} != &quot;Concurrent&quot;,
                {!$Record.Opportunity_Type__c} != &quot;New&quot;
            ),
        &quot;Renewal&quot;, null
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>formulaStatusCleared</name>
        <dataType>Boolean</dataType>
        <expression>OR (
ISPICKVAL({!$Record.Status__c}, &quot;Cleared&quot;),
ISPICKVAL({!$Record.Status__c}, &quot;Waived&quot;),
ISPICKVAL({!$Record.Status__c}, &quot;Rejected&quot;)
)</expression>
    </formulas>
