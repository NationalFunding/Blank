    <description>- Campaign Member Decision &amp; Creation</description>
    <formulas>
        <name>formulaAGSTier</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
{!inputAGS}&gt;=0,
{!inputAGS}&lt;{!varT1LendingTreeLimit}
),&apos;T1&apos;,
IF(
OR(
ISBLANK({!inputAGS}),
AND(
{!inputAGS}&gt;={!varT1LendingTreeLimit},
{!inputAGS}&lt;{!varT2LendingTreeLimit}
)
),&apos;T2&apos;,
IF(
{!inputAGS}&gt;={!varT2LendingTreeLimit},
&apos;T3&apos;,
&apos;T3&apos;
)))</expression>
    </formulas>
    <formulas>
        <name>formulaRoundRobinFlow</name>
        <dataType>String</dataType>
        <expression>IF(
{!formulaAGSTier}=&apos;T2&apos;,{!conT2LendingTree},{!conT3LendingTree})</expression>
    </formulas>
    <formulas>
        <name>formulaSweepDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+215</expression>
    </formulas>
    <formulas>
        <name>formulaUpdateAutoAssignCounter</name>
        <dataType>Number</dataType>
        <expression>IF({!varAutoAssignCounter}&lt;=({!varMaxAutoAssignNumber}-1),({!varAutoAssignCounter}+1),1)</expression>
        <scale>2</scale>
    </formulas>
