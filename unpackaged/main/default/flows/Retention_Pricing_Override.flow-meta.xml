    <formulas>
        <name>F_Comments_Section_for_Override</name>
        <dataType>String</dataType>
        <expression>&quot;Original Pricing Definition - &quot; + {!Get_Funding_Approval.Pricing_Definition__c} +BR()+
&quot;New Pricing Definition - &quot; + {!varPricingDefinitionRecord.Id} +BR()+
{!Comments}</expression>
    </formulas>
    <formulas>
        <name>f_DefaultPricingDefValue</name>
        <dataType>String</dataType>
        <expression>IF(
CONTAINS(UPPER(TEXT({!Get_Funding_Approval.Opportunity__r.Type})),&quot;RENEWAL&quot;),
&quot;0&quot;,
&quot;A&quot;
)</expression>
    </formulas>
    <formulas>
        <name>F_Original_Pricing_Def_Id</name>
        <dataType>String</dataType>
        <expression>RIGHT(LEFT({!Get_Opportunity_Retention_Override.Comments__c}, 48),18)</expression>
    </formulas>
    <formulas>
        <name>f_OriginalPricingDefinitionValue</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK(LEFT({!Get_Funding_Approval.Pricing_Definition__r.Method_Value__c},1)),{!f_DefaultPricingDefValue},
LEFT({!Get_Funding_Approval.Pricing_Definition__r.Method_Value__c},1)
)</expression>
    </formulas>
    <formulas>
        <name>f_PricingDefChannel</name>
        <dataType>String</dataType>
        <expression>IF(
CONTAINS(UPPER(TEXT({!Get_Funding_Approval.Opportunity__r.Type})),&quot;RENEWAL&quot;),&quot;Renewal&quot;,
&quot;Direct&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_len_approver_id</name>
        <dataType>Number</dataType>
        <expression>LEN({!collApproverId})</expression>
        <scale>0</scale>
    </formulas>
