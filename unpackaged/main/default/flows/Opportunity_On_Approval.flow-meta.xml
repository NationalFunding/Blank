    <description>Last Update: 7/21/2025 - SPR-367, distribute oppty on approval for deals owned by MCO reps + notifications w/ originating brand</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_assignment_counted_date</name>
        <dataType>Date</dataType>
        <expression>IF(
{!$Flow.CurrentDateTime} &gt; {!formula_distribution_counter_cutoff_time},
{!$Flow.CurrentDate},
{!$Flow.CurrentDate}-1
)</expression>
    </formulas>
    <formulas>
        <name>formula_distribution_counter_cutoff_time</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(Text(DATEVALUE(NOW()))+ &quot; &quot; +MID( TEXT( NOW() ), 12, 2) +&apos;:00:00&apos;)-(VALUE({!Get_Distribution_Cutoff_Time.Distribution_Cutoff_Time__c})/24)</expression>
    </formulas>
    <formulas>
        <name>formula_signor_pref_language</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!Get_Signor_Contact.Contact.Pref_Language__c}, &apos;Spanish&apos;), &apos;Spanish&apos;, &apos;&apos;)</expression>
    </formulas>
