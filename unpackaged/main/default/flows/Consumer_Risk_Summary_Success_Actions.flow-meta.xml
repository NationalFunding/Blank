    <description>Populates attributes on Consumer Risk Summary when updated to Success in addition to scheduled processes.</description>
    <environments>Default</environments>
    <formulas>
        <name>form_Decline_Email_Scheduled_Date</name>
        <dataType>DateTime</dataType>
        <expression>IF(
	NOT(ISCHANGED({!$Record.Decline_Email_Scheduled_Date__c})),
	DATETIMEVALUE(DATEVALUE({!$Record.Completed_Date_Time__c}) + {!$Setup.Automation_Custom_Settings__c.PreQual_Decline_Email_Days__c}),
	DATETIMEVALUE({!$Record.Decline_Email_Scheduled_Date__c})
)</expression>
    </formulas>
    <formulas>
        <name>form_Decline_Email_Sent_Date_Time_Error</name>
        <dataType>String</dataType>
        <expression>&quot;Email not sent as Decline Email Sent Date/Time was already populated as of &quot; &amp; TEXT({!$Flow.CurrentDateTime})</expression>
    </formulas>
    <formulas>
        <name>form_Error_Message</name>
        <dataType>String</dataType>
        <expression>LEFT(
IF(
	NOT(ISBLANK({!$Flow.FaultMessage})),
	{!$Flow.FaultMessage},
	{!form_No_Records_Returned}
),
32768)</expression>
    </formulas>
    <formulas>
        <name>form_Exception_Object</name>
