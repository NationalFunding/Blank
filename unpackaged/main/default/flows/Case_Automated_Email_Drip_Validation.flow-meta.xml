    <decisions>
        <name>CatchUpDrip_Status_Check</name>
        <label>Catch Up Drip Status Check</label>
        <locationX>490</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Set_Validation_Status_to_Ineligible</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CU_Eligible</name>
            <conditionLogic>NOT 1 AND NOT 2 AND NOT 3 AND NOT 4 AND (5 OR 6) AND NOT 7</conditionLogic>
            <conditions>
                <leftValueReference>inputCaseRecord.Account.Collections_Stage__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Default</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Account.Collections_Stage__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Charge Off</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Account.Collections_Stage__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Modification</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Account.Collections_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>CU Scheduled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Catch_Up_Drip_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Eligible</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Catch_Up_Drip_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Account.Collections_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FRPSA - Recon</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Validation_Status_to_Eligible</targetReference>
            </connector>
            <label>CU Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Charge_Off_Drip_Status_Check</name>
        <label>Charge Off Drip Status Check</label>
        <locationX>930</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Set_Validation_Status_to_Ineligible</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Eligible_Charge_Off</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>inputCaseRecord.Charge_Off_Drip_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Eligible</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Charge_Off_Drip_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Collections_Stage__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Charge Off</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Opportunity__r.Termination_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Third_Party_Debt_Collector__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Validation_Status_to_Eligible</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Drip_Status_Check</name>
        <label>Drip Status Check</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Set_Validation_Status_to_Ineligible</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Eligible</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4 AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>inputCaseRecord.NCCI_Legal_Demand_Drip_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Eligible</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.NCCI_Legal_Demand_Drip_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formula_FRPSA_Default_or_Non_FRPSA</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Collections_Stage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Charge Off</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Collections_Stage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Paying</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inputCaseRecord.Collections_Stage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Modification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Validation_Status_to_Eligible</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Input_Drip</name>
        <label>Input Drip</label>
        <locationX>666</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Log</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NCCI</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputDrip</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NCCI</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Drip_Status_Check</targetReference>
            </connector>
            <label>NCCI</label>
        </rules>
        <rules>
            <name>Catch_Up</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputDrip</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Catch_Up</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CatchUpDrip_Status_Check</targetReference>
            </connector>
            <label>Catch Up</label>
        </rules>
        <rules>
            <name>Charge_Off</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputDrip</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Charge_Off</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Charge_Off_Drip_Status_Check</targetReference>
            </connector>
            <label>Charge Off</label>
        </rules>
    </decisions>
    <description>+ BAU-427 3rd Party Debt Collector Check
