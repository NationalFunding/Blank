    <description>+check if Broker new deal is submitted within the Last X days for Broker Renewal Deal&apos;s Commission eligibility (PD-2601)
+update Get New Broker deals criteria to Actual Fund Date (PD-2799)</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_Actaul_FPC_Margin_RenewalBrokerDeals</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Opportunity.ACTUAL_AMT_OFFERED__c}* ({!Get_Opportunity.Actual_Ratio__c}- {!Get_Opportunity.Broker_Buy_Ratio__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_Actual_FPC_Margin_NewBrokerDeals</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Opportunity.ACTUAL_AMT_COLLECTED__c} - {!Get_Opportunity.ACTUAL_AMT_OFFERED__c} - ({!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * ({!Get_Opportunity.Actual_Ratio__c}- {!Get_Opportunity.Broker_Buy_Ratio__c}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_Bad_Debt_Cost</name>
        <dataType>Currency</dataType>
        <expression>IF( ISNULL({!Get_Opportunity.FPC_Bad_Debt_Fee__c}), VALUE({!$Label.Margin_Fee}), {!Get_Opportunity.FPC_Bad_Debt_Fee__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_Broker_Commission_NewBrokerDeals</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * ({!Get_Opportunity.Actual_Ratio__c}- {!Get_Opportunity.Broker_Buy_Ratio__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_Broker_Commission_RenewalBrokerDeals</name>
        <dataType>Currency</dataType>
        <expression>IF( 
   AND(
            NOT(ISNULL({!$Setup.National_Funding_Settings__c.Broker_Commission_Eligibility_Days__c})),
              OR(ISNULL({!Get_Eligible_Broker_New_Submission.Id}),
                        ISBLANK({!Get_Eligible_Broker_New_Submission.Id}))),0,
{!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * (VALUE({!$Label.Calculate_Commissions_Broker_Commission})/100)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This formula applies special commission percentage rate for defined brokers. Special commission rate is stored in the Calculate_Commissions_Broker_mtd custom metadata type.</description>
        <name>formula_Broker_Special_Commission_RenewalBrokerDeal</name>
        <dataType>Currency</dataType>
        <expression> IF(
AND(
           NOT(ISNULL({!$Setup.National_Funding_Settings__c.Broker_Commission_Eligibility_Days__c})),
              OR(ISNULL({!Get_Eligible_Broker_New_Submission.Id}),
                        ISBLANK({!Get_Eligible_Broker_New_Submission.Id}))),0,
{!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * ({!Get_Broker_Accounts_with_Special_Commissions.Special_Commission_Rate__c}/100)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_NF_Rep_Margin_ConcurrentNFDeal</name>
        <dataType>Currency</dataType>
        <expression>IF(
{!Get_Opportunity.Actual_Origination_Fee_percent__c}&gt;2, ({!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * ({!Get_Opportunity.Actual_Points_Earned__c} + ({!Get_Opportunity.Actual_Origination_Fee_percent__c}-2))/100), 
({!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * {!Get_Opportunity.Actual_Points_Earned__c}/100) 
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Formula to set the NF_Rep_Margin__c field when the Lender is Quick Bridge</description>
        <name>formula_NF_Rep_Margin_LenderIsQB</name>
        <dataType>Currency</dataType>
        <expression>IF (ISPICKVAL({!Get_Opportunity.Type}, &apos;New&apos;),
(({!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * ({!Get_Opportunity.Actual_Points_Earned__c}/100)) - VALUE({!$Label.Margin_Fee})),
({!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * ({!Get_Opportunity.Actual_Points_Earned__c}/100))
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_NF_Rep_Margin_NewNFDeal</name>
        <dataType>Currency</dataType>
        <expression>IF(
{!Get_Opportunity.Actual_Origination_Fee_percent__c}&gt;2, ({!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * ({!Get_Opportunity.Actual_Points_Earned__c} + ({!Get_Opportunity.Actual_Origination_Fee_percent__c}-2))/100 - VALUE( {!$Label.Margin_Fee})), 
({!Get_Opportunity.ACTUAL_AMT_OFFERED__c} * {!Get_Opportunity.Actual_Points_Earned__c}/100) - VALUE({!$Label.Margin_Fee})
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_NF_Rep_Margin_RenewalDirectDeal</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Opportunity.ACTUAL_AMT_OFFERED__c}*({!Get_Opportunity.Actual_Points_Earned__c}/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaBrokerSubmissionEligibleDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()-{!$Setup.National_Funding_Settings__c.Broker_Commission_Eligibility_Days__c}</expression>
    </formulas>
    <formulas>
        <name>formulaNetToCustomer</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Opportunity.ACTUAL_AMT_OFFERED__c}-{!varTotalPayoffAmount}-{!Get_Opportunity.Actual_Origination_Fee__c}</expression>
        <scale>2</scale>
    </formulas>
