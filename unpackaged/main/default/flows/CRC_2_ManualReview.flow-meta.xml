    <description>Credit Review Controller - Manual Review</description>
    <formulas>
        <name>formulaDateSubbed</name>
        <dataType>DateTime</dataType>
        <expression>IF(
OR(
{!varOpptyRecordTypeId}={!conBrokerWCRecordTypeId},
{!varOpptyRecordTypeId}={!conWCRecordTypeId}
),
{!varOpptyStmtsInDate},
{!varOpptyCreditSubDate}
)</expression>
    </formulas>
    <formulas>
        <name>formulaMRStep1Result</name>
        <dataType>String</dataType>
        <expression>IF(
{!varProcessStepNumber}=1,
{!varManualReviewResult},
{!varStep1Status}
)</expression>
    </formulas>
    <formulas>
        <name>formulaMRStep2Result</name>
        <dataType>String</dataType>
        <expression>IF(
{!varProcessStepNumber}=2,
{!varManualReviewResult},
{!varStep2Status}
)</expression>
    </formulas>
    <formulas>
        <name>formulaOpptyLink</name>
        <dataType>String</dataType>
        <expression>&quot;https://nf.my.salesforce.com/&quot; &amp; {!varOpptyId}</expression>
    </formulas>
    <formulas>
        <name>formulaProcessStepNumber</name>
        <dataType>Number</dataType>
        <expression>IF(
{!varProcessStepNumber}&lt;{!varTotalSteps},
({!varProcessStepNumber}+1),
{!varProcessStepNumber}
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaRecordTypeName</name>
        <dataType>String</dataType>
        <expression>CASE({!varOpptyRecordTypeId},
{!conBrokerWCRecordTypeId},{!conBrokerWorkingCapital},
{!conWCRecordTypeId},{!conWorkingCapital},
{!conLease}
)</expression>
    </formulas>
    <formulas>
        <name>formulaROSIdIsBlank</name>
        <dataType>Boolean</dataType>
        <expression>IF(
ISNULL({!varROSId}),
TRUE,
FALSE
)</expression>
    </formulas>
