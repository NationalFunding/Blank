    <decisions>
        <name>Status_is_Final</name>
        <label>Status is Final</label>
        <locationX>574</locationX>
        <locationY>51</locationY>
        <defaultConnectorLabel>Status not Final</defaultConnectorLabel>
        <rules>
            <name>Status_is_Final_Decision</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>loopVarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopVarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Declined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopVarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Withdraw</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopVarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Older Approval</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopVarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lender Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopVarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopVarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Eligible</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Funding_Records</targetReference>
            </connector>
            <label>Status is Final</label>
        </rules>
    </decisions>
