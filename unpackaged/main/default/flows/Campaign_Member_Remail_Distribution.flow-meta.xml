    <description>+ Exclude records where card is activated by reps PD-2840</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_Last30Days</name>
        <dataType>Date</dataType>
        <expression>TODAY()-30</expression>
    </formulas>
    <formulas>
        <name>formulaLeadOrAccountId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.ContactId}), {!$Record.Lead.Id}, {!$Record.Contact.Account.Id})</expression>
    </formulas>
    <formulas>
        <name>formulaLeadOrAccountOwnerEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.ContactId}), {!$Record.Lead.Owner:User.Email}, {!$Record.Contact.Account.Owner.Email})</expression>
    </formulas>
