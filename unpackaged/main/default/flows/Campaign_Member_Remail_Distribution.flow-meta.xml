    <decisions>
        <name>Check_Activities</name>
        <label>Check Activities</label>
        <locationX>314</locationX>
        <locationY>684</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Lead_or_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Greater Than 30 days</defaultConnectorLabel>
        <rules>
            <name>Within_30_Days</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead.Last_Activity_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formula_Last30Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lead.Activation_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formula_Last30Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact.Account.Last_Activity_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formula_Last30Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact.Account.Activation_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formula_Last30Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Rep</targetReference>
            </connector>
            <label>Within 30 Days</label>
        </rules>
    </decisions>
