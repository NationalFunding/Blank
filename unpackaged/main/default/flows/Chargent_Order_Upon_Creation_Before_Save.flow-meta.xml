<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>+Update Case lookup if Chargent record is created from Payment Agreements (PD-3352)</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_Case_Lookup</name>
        <dataType>String</dataType>
        <expression>IF(
AND(NOT(ISNULL({!$Record.Payment_Agreement__r.Id})), NOT(ISBLANK({!$Record.Payment_Agreement__r.Id}))),
{!$Record.Payment_Agreement__r.Matter__r.Case__r.Id},{!$Record.Case__r.Id})</expression>
    </formulas>
    <interviewLabel>Chargent Order - Upon Creation Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Chargent Order - Upon Creation Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Payment_Request_Template</name>
        <label>Get Payment Request Template</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Chargent_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Lender_Account_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__r.Opportunity__r.Lender_Account__r.Name</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Chargent_Payment_Request_Lender_Template__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Chargent_Order</name>
        <label>Update Chargent Order</label>
        <locationX>176</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Case__c</field>
            <value>
                <elementReference>formula_Case_Lookup</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ChargentOrders__Invoice_Number__c</field>
            <value>
                <elementReference>$Record.Case__r.Merchant_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ChargentOrders__Payment_Template__c</field>
            <value>
                <elementReference>Get_Payment_Request_Template.Payment_Request_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Repayment__c</field>
            <value>
                <elementReference>$Record.Case__r.Repayment__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Payment_Request_Template</targetReference>
        </connector>
        <object>ChargentOrders__ChargentOrder__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
