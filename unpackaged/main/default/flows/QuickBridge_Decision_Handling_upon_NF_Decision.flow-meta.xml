<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <constants>
        <name>conDeclined</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Declined</stringValue>
        </value>
    </constants>
    <constants>
        <name>conemailAddress</name>
        <dataType>String</dataType>
        <value>
            <stringValue>aburdick@nationalfunding.com</stringValue>
        </value>
    </constants>
    <constants>
        <name>conEmailSubject</name>
        <dataType>String</dataType>
        <value>
            <stringValue>QB Decision Flow - Upon NF Decision</stringValue>
        </value>
    </constants>
    <constants>
        <name>conLenderApproved</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Lender Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>conLenderPendInfo</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Lender Pend Info</stringValue>
        </value>
    </constants>
    <constants>
        <name>conQBLenderccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Quick Bridge Funding</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Approved_Funding_Record_Already_Exists</name>
        <label>Approved Funding Record Already Exists</label>
        <locationX>461</locationX>
        <locationY>269</locationY>
        <defaultConnector>
            <targetReference>Update_QB_Funding_to_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFundingIdApproved</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>QB_Decision_Routing</name>
        <label>QB Decision Routing</label>
        <locationX>462</locationX>
        <locationY>77</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>QB_Declined_or_Pend</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varFundingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conDeclined</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varFundingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conLenderPendInfo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_to_Syndication</targetReference>
            </connector>
            <label>QB Declined or Pend</label>
        </rules>
        <rules>
            <name>QB_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFundingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conLenderApproved</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Lookup_Approved_Funding_Records</targetReference>
            </connector>
            <label>QB Approved</label>
        </rules>
    </decisions>
    <interviewLabel>QuickBridge Decision Handling upon NF Decision {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QuickBridge Decision Handling upon NF Decision</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Lookup_Approved_Funding_Records</name>
        <label>Lookup Approved Funding Records</label>
        <locationX>462</locationX>
        <locationY>179</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Approved_Funding_Record_Already_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputOpptyId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>FPC_Funding_del__c</object>
        <outputAssignments>
            <assignToReference>varFundingIdApproved</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Lookup_QB_Funding_Record</name>
        <label>Lookup QB Funding Record</label>
        <locationX>150</locationX>
        <locationY>78</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>QB_Decision_Routing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Lender_Name_Workflow__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>conQBLenderccount</elementReference>
            </value>
        </filters>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputOpptyId</elementReference>
            </value>
        </filters>
        <object>FPC_Funding_del__c</object>
        <outputAssignments>
            <assignToReference>varFundingId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varFundingStatus</assignToReference>
            <field>Status__c</field>
        </outputAssignments>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity_to_Syndication</name>
        <label>Update Opportunity to Syndication</label>
        <locationX>731</locationX>
        <locationY>77</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputOpptyId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Send_to_Syndication__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_QB_Funding_to_Approved</name>
        <label>Update QB Funding to Approved</label>
        <locationX>462</locationX>
        <locationY>375</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varFundingId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <object>FPC_Funding_del__c</object>
    </recordUpdates>
    <startElementReference>Lookup_QB_Funding_Record</startElementReference>
    <status>Active</status>
    <textTemplates>
        <name>EmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>!inputCRID: {!inputCRID}
!inputOpptyId: {!inputOpptyId}
!varFundingId: {!varFundingId}
!varFundingStatus: {!varFundingStatus}</text>
