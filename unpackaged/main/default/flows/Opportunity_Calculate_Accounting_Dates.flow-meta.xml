    <description>Last Update: 3/13/2025 - BAU-284, fix fund date after 4pm cutoff
+Maturity Date (PD-4815)</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_datevalue_fund_date</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.Fund_Date__c})</expression>
    </formulas>
    <formulas>
        <name>formula_frequency</name>
        <dataType>String</dataType>
        <expression>IF(
	ISBLANK(TEXT({!$Record.Docs_Payment_Frequency__c})),
	TEXT({!Get_Selected_Funding_Option.Payment_Frequency__c}),
	&apos;Error&apos;
)</expression>
    </formulas>
    <formulas>
        <name>formula_input_for_ACHstartDate</name>
        <dataType>Date</dataType>
        <expression>IF(
	{!var_payment_frequency} = &apos;Monthly&apos;,
	ADDMONTHS({!varLoanStartDate},1)-1,
	IF(
		{!var_payment_frequency} = &apos;Weekly&apos;,
		{!varLoanStartDate} +6,
		IF(
			{!var_payment_frequency} = &apos;Daily&apos;,
			{!varLoanStartDate} ,
			null
			)
		)
	)</expression>
    </formulas>
    <formulas>
        <name>formula_next_business_day</name>
        <dataType>DateTime</dataType>
        <expression>CASE(
MOD( DATEVALUE({!varInputDate})- DATE(1900, 1, 7), 7),
0, {!varInputDate}+1, /*if varInputDate is Sun,varInputDate+1=Monday */
1, {!varInputDate}+1, /*if varInputDate is Mon,varInputDate+1=Tuesday */
2, {!varInputDate}+1, /*if varInputDate is Tues,varInputDate+1=Wednesday */
3, {!varInputDate}+1, /*if varInputDate is Wed,varInputDate+1=Thursday*/
4, {!varInputDate}+1, /*if varInputDate is Thurs,varInputDate+1=Friday */
5,{!varInputDate}+3, /*if varInputDate is Fri,varInputDate+3=Monday next week */
6,{!varInputDate}+2, /*if varInputDate is Sat,varInputDate+2=Monday next week */

{!varInputDate})</expression>
    </formulas>
    <formulas>
        <name>formulaActualFundDate_offset</name>
        <dataType>DateTime</dataType>
        <expression>{!varActualFundDate} + (15/24)</expression>
    </formulas>
    <formulas>
        <name>formulaMaturityDate</name>
        <dataType>Date</dataType>
        <expression>IF(
	{!var_payment_frequency} = &apos;Monthly&apos;,
	ADDMONTHS({!varLoanStartDate},120),
	IF(
		{!var_payment_frequency} = &apos;Weekly&apos;,
		{!varLoanStartDate} + (VALUE({!$Record.ACTUAL_MCA_TERM__c}) * 7),
		IF(
			{!var_payment_frequency} = &apos;Daily&apos;,
			{!varLoanStartDate} + ROUND(((VALUE({!$Record.ACTUAL_MCA_TERM__c})/5) * 7) + 0.499,0),
			null
			)
		)
	)</expression>
    </formulas>
