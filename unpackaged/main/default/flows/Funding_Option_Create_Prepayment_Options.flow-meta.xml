    <formulas>
        <name>prepayment_amount_text</name>
        <dataType>String</dataType>
        <expression>IF(
	{!Loop_Pricing_Rates_by_Rate.Term__c} = {!min_term},
	&quot;- Within the period prior to &quot; + {!term_to_text_upper_bound} + &quot; months, after the date of funding, the payoff will be $&quot; + {!repayment_value_text},
	&quot;- Within the period between &quot; + {!term_to_text_lower_bound} + &quot; months and &quot; + {!term_to_text_upper_bound} + &quot; months, after the date of funding, the payoff will be $&quot; + {!repayment_value_text}
)</expression>
    </formulas>
    <formulas>
        <name>repayment_value_calculation_create</name>
        <dataType>Number</dataType>
        <expression>IF(
	{!$Record.Funding_Amount__c}*{!sell_rate_calculation_create}&gt;{!$Record.Funding_Repayment_Amount__c},
{!$Record.Funding_Repayment_Amount__c},
      {!$Record.Funding_Amount__c}*{!sell_rate_calculation_create})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>repayment_value_text</name>
        <dataType>String</dataType>
        <expression>IF( 
  {!repayment_value_calculation_create}&gt;= 1000000, 
  TEXT(FLOOR({!repayment_value_calculation_create}/ 1000000)) &amp; &quot;,&quot;, 
  &quot;&quot;) &amp; 
IF( 
  {!repayment_value_calculation_create}&gt;= 1000, 
  RIGHT(TEXT(FLOOR({!repayment_value_calculation_create}/ 1000)), 3) &amp; &quot;,&quot;, 
  &quot;&quot;) &amp; 
RIGHT(TEXT(FLOOR({!repayment_value_calculation_create})), 3) &amp; &quot;.&quot; &amp; 
IF( 
  MOD({!repayment_value_calculation_create}, 1) * 100 &lt; 10, 
  &quot;0&quot; &amp; TEXT(ROUND(MOD({!repayment_value_calculation_create}, 1), 2) * 100), 
  TEXT(MIN(ROUND(MOD({!repayment_value_calculation_create}, 1), 2) * 100, 99)) 
)</expression>
    </formulas>
    <formulas>
        <name>sell_rate_calculation_create</name>
        <dataType>Number</dataType>
        <expression>IF(
	({!Loop_Pricing_Rates_by_Rate.Rate__c}+({!$Record.Margin_Points__c}/100)) &lt; {!sell_rate_floor}, 
	{!sell_rate_floor}, 
        IF(
        {!Loop_Pricing_Rates_by_Rate.Flat_Rate__c} = TRUE, {!Loop_Pricing_Rates_by_Rate.Rate__c},
	{!Loop_Pricing_Rates_by_Rate.Rate__c}+({!$Record.Margin_Points__c}/100)
)
)</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>term_to_text_lower_bound</name>
        <dataType>String</dataType>
        <expression>CASE(
	{!Loop_Pricing_Rates_by_Rate.Term__c},
	1, &quot;zero&quot;,
	2, &quot;one&quot;,
	3, &quot;two&quot;,
	4, &quot;three&quot;,
	5, &quot;four&quot;,
	6, &quot;five&quot;,
	7, &quot;six&quot;,
	8, &quot;seven&quot;,
	9, &quot;eight&quot;,
	10, &quot;nine&quot;,
	11, &quot;ten&quot;,
	12, &quot;eleven&quot;,
	13, &quot;twelve&quot;,
	14, &quot;thirteen&quot;,
	15, &quot;fourteen&quot;,
	16, &quot;fifteen&quot;,
	17, &quot;sixteen&quot;,
	18, &quot;seventeen&quot;,
	19, &quot;eighteen&quot;,
	20, &quot;nineteen&quot;,
	&quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>term_to_text_upper_bound</name>
        <dataType>String</dataType>
        <expression>CASE(
	{!Loop_Pricing_Rates_by_Rate.Term__c},
	1, &quot;one&quot;,
	2, &quot;two&quot;,
	3, &quot;three&quot;,
	4, &quot;four&quot;,
	5, &quot;five&quot;,
	6, &quot;six&quot;,
	7, &quot;seven&quot;,
	8, &quot;eight&quot;,
	9, &quot;nine&quot;,
	10, &quot;ten&quot;,
	11, &quot;eleven&quot;,
	12, &quot;twelve&quot;,
	13, &quot;thirteen&quot;,
	14, &quot;fourteen&quot;,
	15, &quot;fifteen&quot;,
	16, &quot;sixteen&quot;,
	17, &quot;seventeen&quot;,
	18, &quot;eighteen&quot;,
	19, &quot;nineteen&quot;,
	20, &quot;twenty&quot;,
	&quot;&quot;
)</expression>
    </formulas>
