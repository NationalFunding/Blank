<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <decisions>
        <name>OB_Prequal_Status_Check</name>
        <label>OB Prequal Status Check</label>
        <locationX>438</locationX>
        <locationY>155</locationY>
        <defaultConnectorLabel>Is Not Null</defaultConnectorLabel>
        <rules>
            <name>Is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.QB_Prequal_Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Syndicate_to_QB</targetReference>
            </connector>
            <label>Is Null</label>
        </rules>
    </decisions>
    <description>Record triggered flow to send a deal to QB once preprocessing is complete

JIRA: https://nationalfunding.atlassian.net/browse/SD-4919</description>
    <environments>Default</environments>
    <interviewLabel>Credit Review - Syndicate to Quick Bridge {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Credit Review - Syndicate to Quick Bridge</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>32</locationX>
        <locationY>59</locationY>
        <connector>
            <targetReference>OB_Prequal_Status_Check</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PreProcessing_Complete_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Deal_Origination__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>MCA_Oppty</stringValue>
            </value>
        </filters>
        <filters>
            <field>Deal_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>NEW</stringValue>
            </value>
        </filters>
        <filters>
            <field>PG_1_Credit_Score__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>PG_1_Credit_Score__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>0</stringValue>
            </value>
        </filters>
        <filters>
            <field>PG_1_Credit_Score__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>-1</stringValue>
            </value>
        </filters>
        <object>Credit_Review__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Syndicate_to_QB</name>
        <label>Syndicate to QB</label>
        <locationX>619</locationX>
        <locationY>154</locationY>
        <flowName>Send_to_QB_500k</flowName>
        <inputAssignments>
            <name>inputOpptyId</name>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
