    <decisions>
        <name>Is_Account_Enabled_To_Submit_Deals</name>
        <label>Is Account Enabled To Submit Deals</label>
        <locationX>38</locationX>
        <locationY>156</locationY>
        <defaultConnector>
            <targetReference>Account_Not_Able_to_Submit</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Account Disabled</defaultConnectorLabel>
        <rules>
            <name>Account_Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varBrokerAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Concurrent_Entry</targetReference>
            </connector>
            <label>Account Enabled</label>
        </rules>
    </decisions>
    <description>Updated flow with screen to not allow Disabled Brokers to progress.</description>
