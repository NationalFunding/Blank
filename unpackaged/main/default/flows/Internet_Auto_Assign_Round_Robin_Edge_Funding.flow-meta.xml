    <description>Update 12.28.17 - Both T2 &amp; T3 decision outcomes changed to one path. Distribution will not be based on AGS to different rep groups.</description>
    <formulas>
        <name>formulaAGSTier</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
{!inputAGS}&gt;=0,
{!inputAGS}&lt;{!varT1EdgeLimit}
),&apos;T1&apos;,
IF(
OR(
ISBLANK({!inputAGS}),
AND(
{!inputAGS}&gt;={!varT1EdgeLimit},
{!inputAGS}&lt;{!varT2EdgeLimit}
)
),&apos;T2&apos;,
IF(
{!inputAGS}&gt;={!varT2EdgeLimit},
&apos;T3&apos;,
&apos;T3&apos;
)))</expression>
    </formulas>
    <formulas>
        <name>formulaRoundRobinFlow</name>
        <dataType>String</dataType>
        <expression>IF(
{!formulaAGSTier}=&apos;T2&apos;,{!conT2EdgeFunding},{!conT3EdgeFunding})</expression>
    </formulas>
    <formulas>
        <name>formulaUpdateAutoAssignCounter</name>
        <dataType>Number</dataType>
        <expression>IF({!varAutoAssignCounter}&lt;=({!varMaxAutoAssignNumber}-1),({!varAutoAssignCounter}+1),1)</expression>
        <scale>2</scale>
    </formulas>
