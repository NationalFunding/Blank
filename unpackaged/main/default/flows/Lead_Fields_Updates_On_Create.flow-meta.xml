                <elementReference>formula_InitialResponseChannelAndRep</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Initial_Response_Rep__c</field>
            <value>
                <elementReference>formula_InitialResponseChannelAndRep</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Activity_Description__c</field>
            <value>
                <elementReference>formula_LastActivityDescription_Regarding</elementReference>
