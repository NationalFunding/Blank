<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <description>Lead.Initial_Lead_Source__c = BusinessLoanAnalyst.com OR BusinessLoans.com OR FunderaAPI OR LendingTree</description>
    <formulas>
        <name>formula_CasesafeID</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!$Record.Id})</expression>
    </formulas>
    <formulas>
        <name>formula_InitialResponseChannelAndRep</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Response_Channel__c})</expression>
    </formulas>
    <formulas>
        <name>formula_LastActivityDescription_Regarding</name>
        <dataType>String</dataType>
        <expression>{!$Record.Initial_Lead_Source__c}</expression>
    </formulas>
    <formulas>
        <name>formula_MobileNumber</name>
        <dataType>String</dataType>
        <expression>IF(
   AND(
           NOT(ISBLANK({!$Record.Phone})), 
           ISBLANK({!$Record.MobilePhone})
           ), 
{!$Record.Phone}, 
{!$Record.MobilePhone}
)</expression>
    </formulas>
    <interviewLabel>Lead_Fields_Updates_On_Create - {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Fields Updates On Create</label>
    <processMetadataValues>
