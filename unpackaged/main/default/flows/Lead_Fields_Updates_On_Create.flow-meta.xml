    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Fields</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Initial_Lead_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BusinessLoanAnalyst.com</stringValue>
            </value>
        </filters>
        <filters>
            <field>Initial_Lead_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BusinessLoans.com</stringValue>
            </value>
        </filters>
        <filters>
            <field>Initial_Lead_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>FunderaAPI</stringValue>
            </value>
        </filters>
        <filters>
            <field>Initial_Lead_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>LendingTree</stringValue>
            </value>
        </filters>
        <object>Lead</object>
