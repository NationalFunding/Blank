        </filters>
        <object>advpm__Matter__c</object>
        <outputReference>svarcolMatters</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>advpm__Status__c</queriedFields>
        <queriedFields>advpm__Stage__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Chargeoff_Summary</name>
        <label>Update Chargeoff Summary</label>
        <locationX>307</locationX>
        <locationY>321</locationY>
        <filterLogic>and</filterLogic>
        <filters>
