<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <assignments>
        <name>AssignPaidStatus</name>
        <label>AssignPaidStatus</label>
        <locationX>306</locationX>
        <locationY>81</locationY>
        <assignmentItems>
            <assignToReference>varPaidStage</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Matters</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Matter_is_Closed</name>
        <label>Matter is Closed</label>
        <locationX>542</locationX>
        <locationY>191</locationY>
        <defaultConnectorLabel>Open</defaultConnectorLabel>
        <rules>
            <name>Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LoopVarMatters.advpm__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stage_is_Paid</targetReference>
            </connector>
            <label>Closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Stage_is_Paid</name>
        <label>Stage is Paid</label>
        <locationX>542</locationX>
        <locationY>81</locationY>
        <defaultConnector>
            <targetReference>Loop_Matters</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Paid</defaultConnectorLabel>
        <rules>
            <name>Paid</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>LoopVarMatters.advpm__Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid in Full</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LoopVarMatters.advpm__Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid as Agreed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignPaidStatus</targetReference>
            </connector>
            <label>Paid</label>
        </rules>
    </decisions>
    <description>Loops through all Matters related to a Loan and updates the Chargeoff Summary Status if all Matters are closed.</description>
    <formulas>
        <name>formulaChargeoffSummaryStatus</name>
        <dataType>String</dataType>
        <expression>IF(
{!varPaidStage}=TRUE, 
&apos;Paid&apos;,
&apos;Uncollectable&apos;
)</expression>
    </formulas>
    <interviewLabel>Matter - Update Chargeoff Summary {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Matter - Update Chargeoff Summary</label>
    <loops>
        <name>Loop_Matters</name>
        <label>Loop Matters</label>
        <locationX>306</locationX>
        <locationY>192</locationY>
        <assignNextValueToReference>LoopVarMatters</assignNextValueToReference>
        <collectionReference>svarcolMatters</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Matter_is_Closed</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Chargeoff_Summary</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
