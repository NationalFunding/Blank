        <defaultConnector>
            <targetReference>Evaluate_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Approved</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>loopvarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopvarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Older Approval</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loopvarFundingRecord.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lender Approved</stringValue>
                </rightValue>
            </conditions>
            <label>Approved</label>
        </rules>
    </decisions>
    <formulas>
        <name>formulaReasonClosed</name>
        <dataType>String</dataType>
        <expression>IF(
{!varFundingStatusOpenDeclined}=&apos;Open&apos;,
&apos;Customer Lost Interest&apos;,
null
)</expression>
    </formulas>
    <formulas>
        <name>formulaStageName</name>
        <dataType>String</dataType>
        <expression>IF(
{!varFundingStatusOpenDeclined}=&apos;Open&apos;,
&apos;Offer(s) Not Accepted&apos;,
&apos;Declined&apos;
)</expression>
    </formulas>
    <formulas>
        <name>formulaStatus</name>
        <dataType>String</dataType>
        <expression>CASE({!loopvarFundingRecord.Status__c},
&apos;Submitted&apos;,&apos;Open&apos;,
&apos;Lender Pend Info&apos;,&apos;Open&apos;,
&apos;Declined&apos;
)</expression>
    </formulas>
