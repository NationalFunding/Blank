    <decisions>
        <name>Send_to_Quickbridge</name>
        <label>Send to Quickbridge</label>
        <locationX>233</locationX>
        <locationY>220</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varBrokerDeclineReason</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conDeclineReason</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formulaAvgDepositsEligible</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formulaFICOEligible</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varROSExitPath</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conROSExitPathB7</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varROSExitPath</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conROSExitPathC1</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSICCode</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conSIC8351</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSICCode</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>conSIC6732</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Send_to_Quickbridge</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <formulas>
        <name>formula1PG</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(
ISBLANK({!varPG2Id}), 
NOT(ISBLANK({!varPG1Id}))),
FALSE, 
TRUE
)</expression>
    </formulas>
    <formulas>
        <name>formulaAvgDepositsEligible</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(
NOT(ISBLANK({!varCRBankSummaryId})),
(({!varCRBankSummarySumCounterDeposits}+{!varCRBankSummarySumOtherDeposits})/{!varCRBankSummaryMonthsReviewed})&lt;5000), 
FALSE, 
TRUE
)</expression>
    </formulas>
    <formulas>
        <name>formulaFICOEligible</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(
ISBLANK({!varPG2Id}),
{!formulaPG1FicoNumber}&gt;=0,
{!formulaPG1FicoNumber}&lt;500),
FALSE, 
TRUE)</expression>
    </formulas>
    <formulas>
        <name>formulaPG1FicoNumber</name>
        <dataType>Number</dataType>
        <expression>VALUE({!varPG1EQFScore})</expression>
        <scale>0</scale>
    </formulas>
