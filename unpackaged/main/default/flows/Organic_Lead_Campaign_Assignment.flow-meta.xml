<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <constants>
        <name>conCampaignMemberStatusResponded</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Responded</stringValue>
        </value>
    </constants>
    <constants>
        <name>conCampaignMemberStatusSent</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Sent</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Does_a_Campaign_Member_Already_Exist</name>
        <label>Does a Campaign Member Already Exist?</label>
        <locationX>476</locationX>
        <locationY>382</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Campaign_Member_Does_Not_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCampaignMemberId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCampaignID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Campaign_Member</targetReference>
            </connector>
            <label>Campaign Member Does Not Exist</label>
        </rules>
        <rules>
            <name>No_Campaign_Match_Do_Nothing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCampaignID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No Campaign Match - Do Nothing</label>
        </rules>
        <rules>
            <name>Campaign_Member_Exists_Status_Sent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCampaignMemberId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCampaignMemberStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conCampaignMemberStatusSent</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Campaign_Member_to_Responded</targetReference>
            </connector>
            <label>Campaign Member Exists - Status = Sent</label>
        </rules>
        <rules>
            <name>Campaign_Member_Exists_Status_Responded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCampaignID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCampaignMemberStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>conCampaignMemberStatusResponded</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCMFirstRespondedDate</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Existing_Campaign_Member</targetReference>
            </connector>
            <label>Campaign Member Exists - Status = Responded</label>
        </rules>
    </decisions>
    <formulas>
        <name>OrganicSearchSource</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!varDACameFrom}, &quot;google&quot;), &quot;Organic Google&quot;, 
IF(CONTAINS({!varDACameFrom}, &quot;bing&quot;), &quot;Organic Bing&quot;, 
IF(CONTAINS({!varDACameFrom}, &quot;yahoo&quot;), &quot;Organic Yahoo&quot;, 
&quot;Organic Other&quot;
)))</expression>
    </formulas>
    <interviewLabel>Organic Lead Campaign Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Organic Lead Campaign Assignment</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Campaign_Member</name>
        <label>Create Campaign Member</label>
        <locationX>288</locationX>
        <locationY>504</locationY>
        <inputAssignments>
            <field>CampaignId</field>
            <value>
                <elementReference>varCampaignID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LeadId</field>
            <value>
                <elementReference>inputLeadId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>conCampaignMemberStatusResponded</elementReference>
            </value>
        </inputAssignments>
        <object>CampaignMember</object>
    </recordCreates>
    <recordDeletes>
        <name>Delete_Existing_Campaign_Member</name>
        <label>Delete Existing Campaign Member</label>
        <locationX>477</locationX>
        <locationY>729</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCampaignMemberId</elementReference>
            </value>
        </filters>
        <object>CampaignMember</object>
    </recordDeletes>
    <recordLookups>
        <name>Lookup_Campaign_Member</name>
        <label>Lookup Campaign Member</label>
        <locationX>475</locationX>
        <locationY>257</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_a_Campaign_Member_Already_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCampaignID</elementReference>
            </value>
        </filters>
        <filters>
            <field>LeadId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputLeadId</elementReference>
            </value>
        </filters>
        <object>CampaignMember</object>
        <outputAssignments>
            <assignToReference>varCMFirstRespondedDate</assignToReference>
            <field>FirstRespondedDate</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varCampaignMemberId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varCampaignMemberStatus</assignToReference>
            <field>Status</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Lookup_Lead</name>
        <label>Lookup Lead</label>
        <locationX>476</locationX>
        <locationY>33</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lookup_Organic_Campaign</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputLeadId</elementReference>
            </value>
        </filters>
        <object>Lead</object>
        <outputAssignments>
            <assignToReference>varDACameFrom</assignToReference>
            <field>DaddyAnalytics__DA_Referrer_Website__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Lookup_Organic_Campaign</name>
        <label>Lookup Organic Campaign</label>
        <locationX>476</locationX>
        <locationY>142</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lookup_Campaign_Member</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Analytics_Campaign_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>OrganicSearchSource</elementReference>
            </value>
        </filters>
        <object>Campaign</object>
        <outputAssignments>
            <assignToReference>varCampaignID</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Campaign_Member_to_Responded</name>
        <label>Update Campaign Member to Responded</label>
        <locationX>737</locationX>
        <locationY>553</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCampaignMemberId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>conCampaignMemberStatusResponded</elementReference>
            </value>
        </inputAssignments>
        <object>CampaignMember</object>
    </recordUpdates>
    <startElementReference>Lookup_Lead</startElementReference>
    <status>Active</status>
    <variables>
        <name>inputLeadId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varCampaignID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varCampaignMemberId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varCampaignMemberStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varCMFirstRespondedDate</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varDACameFrom</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
