    <description>-change entry criteria to remove requirement for EDR/Prior Product Status, update to TC if Previous Funded Deal is paid in full (PD-450)</description>
    <environments>Default</environments>
    <formulas>
        <name>F_CurrentMonth</name>
        <dataType>Number</dataType>
        <expression>MONTH({!$Flow.CurrentDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>F_CurrentYear</name>
        <dataType>Number</dataType>
        <expression>YEAR({!$Flow.CurrentDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>F_EDR_to_TC</name>
        <dataType>Boolean</dataType>
        <expression>IF(
        OR(
            {!Var_CurrentMonth} &gt; {!Var_EligibilityMonth},
            {!Var_CurrentYear} &gt; {!Var_EligibilityYear}
          ), TRUE, FALSE
)</expression>
    </formulas>
    <formulas>
        <name>F_EligibilityMonth</name>
        <dataType>Number</dataType>
        <expression>MONTH({!$Record.Eligibility_Date__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>F_EligibilityYear</name>
        <dataType>Number</dataType>
        <expression>YEAR({!$Record.Eligibility_Date__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>F_PriorProductStatus</name>
        <dataType>Boolean</dataType>
        <expression>IF((MONTH({!$Record.Eligibility_Date__c}) = MONTH({!$Flow.CurrentDate})), TRUE, FALSE)</expression>
    </formulas>
