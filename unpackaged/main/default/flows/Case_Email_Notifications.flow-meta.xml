    <decisions>
        <name>Notification_Type</name>
        <label>Notification Type</label>
        <locationX>512</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Recon_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Recon_Request_Expires__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Recon_Request_Expires__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Recon_Request_Expires__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Run_Additional_Recon_Actions</targetReference>
            </connector>
            <label>Recon Expired</label>
        </rules>
        <rules>
            <name>NCCI</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaNCCI15days</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCCI_Sent__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Chargeoff_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Confirmed Chargeoff</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Email_Variables_0</targetReference>
            </connector>
            <label>NCCI</label>
        </rules>
    </decisions>
    <decisions>
        <name>Run_Additional_Recon_Actions</name>
        <label>Run Additional Recon Actions?</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Assign_Email_Variables_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_run_recon_actions</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Collections_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FRPSA - Recon</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Collections_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested - Bouncing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Expired_Recon_Actions</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Daily scheduled flow to check if case meets the criteria to send notification to user

Last Update: Removing Legal Demand Notification BAU-41</description>
    <environments>Default</environments>
