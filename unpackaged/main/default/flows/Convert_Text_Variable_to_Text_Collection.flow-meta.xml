    <decisions>
        <name>Other_Values_to_Parse</name>
        <label>Other Values to Parse?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Other_Values_to_Parse</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_input_text</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Assign_First_String_to_List</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Accepts a text variable and outputs a text collection</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_first_string</name>
        <dataType>String</dataType>
        <expression>TRIM(LEFT({!var_input_text}, FIND({!var_delimiter},{!var_input_text})-1))</expression>
    </formulas>
    <formulas>
        <name>formula_remove_first_string</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT({!var_input_text},LEN({!var_input_text}) - LEN({!formula_first_string}+{!var_delimiter})))</expression>
    </formulas>
    <interviewLabel>Convert Text Variable to Text Collection {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Convert Text Variable to Text Collection</label>
