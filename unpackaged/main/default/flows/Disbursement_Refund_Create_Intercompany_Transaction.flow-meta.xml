        <filterFormula>AND(
{!$Record.RecordType.DeveloperName} = &apos;Refund&apos;,
ISPICKVAL({!$Record.cmbls__Status__c}, &apos;Settled&apos;),
LEFT({!$Record.Cash_GL__c}, 2) &lt;&gt; {!$Record.cmbls__Repayment__r.cmbls__Primary_Fund__r.Chart_of_Accounts_Prefix__c},
