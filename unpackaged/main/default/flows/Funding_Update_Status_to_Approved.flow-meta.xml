<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <decisions>
        <name>Approved_Funding_Record_Exists</name>
        <label>Approved Funding Record Exists</label>
        <locationX>427</locationX>
        <locationY>52</locationY>
        <defaultConnectorLabel>Approved Funding Record Exists</defaultConnectorLabel>
        <rules>
            <name>No_Approved_Funding_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFundingRecord.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Funding_Status_to_Approved</targetReference>
            </connector>
            <label>No Approved Funding Record</label>
        </rules>
    </decisions>
    <description>Looks to see if any other funding record related to the Opportunity has status = Approved, if not, updates the input funding record status to Approved</description>
    <interviewLabel>Funding - Update Status to Approved {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Funding - Update Status to Approved</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Lookup_Funding_Records</name>
        <label>Lookup Funding Records</label>
        <locationX>213</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Approved_Funding_Record_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputOpptyId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>FPC_Funding_del__c</object>
        <outputReference>varFundingRecord</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <description>Updates the input funding record status to Approved - which will set the appropriate fields on the Opportunity (Lender, Max Approval, Expiration Date). Setting this field should trigger an existing workflow rules that sets those values on Opportunity</description>
        <name>Update_Funding_Status_to_Approved</name>
        <label>Update Funding Status to Approved</label>
        <locationX>437</locationX>
        <locationY>257</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputFundingId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <object>FPC_Funding_del__c</object>
    </recordUpdates>
    <startElementReference>Lookup_Funding_Records</startElementReference>
    <status>Active</status>
    <variables>
        <name>inputFundingId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputOpptyId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varFundingRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FPC_Funding_del__c</objectType>
    </variables>
</Flow>
