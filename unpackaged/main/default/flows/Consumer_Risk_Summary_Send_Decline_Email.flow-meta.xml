    <description>Sends Reg B or Notice of Incomplete Application for eligible Consumer Risk Summaries

Last Update: Adding brand for QB merge project. Query most recent customer event based on CRS completed datetime SPR-362</description>
    <environments>Default</environments>
    <formulas>
        <name>form_Error_Message</name>
        <dataType>String</dataType>
        <expression>LEFT(
IF(
	NOT(ISBLANK({!$Flow.FaultMessage})),
	{!$Flow.FaultMessage},
	IF(
		{!Yes_Email_Template_Returned} = FALSE,
		&quot;No Email Templates returned for Email Template: &quot; &amp; {!Get_Email_Template.DeveloperName},
		{!var_Consumer_Risk_Summary.Primary_Object__c} &amp; &quot; ID &quot; &amp; {!form_Primary_Object_Id} &amp; &quot; does not have a valid email.&quot;
	)
),
32768)</expression>
    </formulas>
    <formulas>
        <name>form_FICO_Score_Decline</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!var_Consumer_Risk_Summary.Decline_Email_Type__c}, &apos;Reg B Notice: FICO Score&apos;)</expression>
    </formulas>
    <formulas>
        <description>Due to a Salesforce limitation, EmailMessages from the Send Email Flow Core Action cannot be logged to both a Lead and a related record.</description>
        <name>form_Log_Email_on_Send</name>
        <dataType>Boolean</dataType>
        <expression>IF(
	{!var_Consumer_Risk_Summary.Primary_Object__c} = &apos;Contact&apos;,
	TRUE,
	FALSE
)</expression>
    </formulas>
    <formulas>
        <name>form_Primary_Object_Id</name>
        <dataType>String</dataType>
        <expression>IF(
	{!var_Consumer_Risk_Summary.Primary_Object__c} = &apos;Lead&apos;,
	{!var_Consumer_Risk_Summary.Lead__c},
	{!var_Consumer_Risk_Summary.Contact__c}
)</expression>
    </formulas>
    <formulas>
        <name>form_Primary_Object_State</name>
        <dataType>String</dataType>
        <expression>IF(
	{!var_Consumer_Risk_Summary.Primary_Object__c} = &apos;Lead&apos;,
	{!var_Consumer_Risk_Summary.Lead__r.State},
	{!var_Consumer_Risk_Summary.Contact__r.Account.BillingState}
)</expression>
    </formulas>
    <formulas>
        <name>form_Program</name>
        <dataType>String</dataType>
        <expression>IF(
	{!Get_Applicable_FRPSA_State.Id} &lt;&gt; NULL,
	&quot;FRPSA&quot;,
	&quot;WC&quot;
)</expression>
    </formulas>
    <formulas>
        <name>form_TemplateName_Incomplete_App</name>
        <dataType>String</dataType>
        <expression>IF(
    {!var_brand} = &apos;Quick Bridge&apos;,
    &apos;QB&apos;,
    &apos;NF&apos;
)
&amp;&quot;_&quot;&amp;{!con_TemplateName_Incomplete_Application}</expression>
    </formulas>
    <formulas>
        <name>formula_org_wide_address</name>
        <dataType>String</dataType>
        <expression>IF(
    {!var_brand} = &apos;Quick Bridge&apos;,
    &apos;info@quickbridge.com&apos;,
    &apos;info@nationalfunding.com&apos;
)</expression>
    </formulas>
