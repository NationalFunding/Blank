    <environments>Default</environments>
    <formulas>
        <name>formula_brand_message</name>
        <dataType>String</dataType>
        <expression>IF({!var_brand}=&apos;Quick Bridge&apos;,&apos;Could you take 60 seconds and share your experience?&apos;,&apos;Can you take a minute to share your experience?&apos; )</expression>
    </formulas>
    <formulas>
        <name>formula_fund_date_time_frame</name>
        <dataType>Number</dataType>
        <expression>(NOW()-{!$Record.Fund_Date__c})*24</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_NotifyRepEmail_LeadSource</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
OR(
{!$Record.Account.Initial_Lead_Source__c} = &apos;Lending Tree&apos;,
{!$Record.Account.Initial_Lead_Source__c} = &apos;LendingTree&apos;
),
NOT(ISPICKVAL({!$Record.Type}, &apos;RENEWAL&apos;)),
NOT(ISPICKVAL({!$Record.Type}, &apos;RENEWAL CONCURRENT&apos;))
),
&apos;Lending Tree&apos;, &apos;Google&apos;
)</expression>
    </formulas>
    <formulas>
        <name>formula_unformatted_phone</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE( TEXT( {!Get_Contact.MobilePhone_Trim__c}), &quot;,&quot; , &quot;&quot; )</expression>
    </formulas>
