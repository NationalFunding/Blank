    <decisions>
        <name>Notify_Funding</name>
        <label>Notify Funding</label>
        <locationX>132</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Notify_Funding</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Plaid_session_count</leftValueReference>
