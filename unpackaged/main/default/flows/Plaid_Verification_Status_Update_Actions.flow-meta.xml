                    <stringValue>failed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Eligible_Verification_Sessions</targetReference>
            </connector>
            <label>Pending Review/Failed</label>
        </rules>
    </decisions>
