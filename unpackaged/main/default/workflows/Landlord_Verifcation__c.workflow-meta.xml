<?xml version="1.0" encoding="utf-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Landlord_Verification_2nd_Review_Needed</fullName>
        <ccEmails>nrojas@fivepointcapital.com</ccEmails>
        <ccEmails>trover@fivepointcapital.com</ccEmails>
        <description>Landlord Verification - 2nd Review Needed</description>
        <protected>false</protected>
        <senderType>CurrentUser</senderType>
        <template>Operations_Workflow_Emails/Landlord_Verification_2nd_Review_Needed</template>
    </alerts>
    <alerts>
        <fullName>Landlord_Verification_Call_Attempted_Notification</fullName>
        <description>Landlord Verification Call Attempted Notification</description>
        <protected>false</protected>
        <recipients>
            <field>Broker_Preferred_Email__c</field>
            <type>email</type>
        </recipients>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Broker_Email_Templates/Landlord_Call_Attempted</template>
    </alerts>
    <alerts>
        <fullName>Landlord_Verification_Call_Completed_Notification</fullName>
        <description>Landlord Verification Call Completed Notification</description>
        <protected>false</protected>
        <recipients>
            <field>Broker_Preferred_Email__c</field>
            <type>email</type>
        </recipients>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Broker_Email_Templates/Landlord_Call_Completed</template>
    </alerts>
    <flowActions>
        <fullName>LLV_Update_Customer_s_Name</fullName>
        <flow>Update_Landlord_Verification</flow>
        <flowInputs>
            <name>inputLanlordVerificationId</name>
            <value>{!Id}</value>
        </flowInputs>
        <label>LLV - Update Customer's Name</label>
        <language>en_US</language>
        <protected>false</protected>
    </flowActions>
    <rules>
        <fullName>Landlord Verification - 2nd Approval</fullName>
        <actions>
            <name>Landlord_Verification_2nd_Review_Needed</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Landlord_Verifcation__c.LLV_Status__c</field>
            <operation>equals</operation>
            <value>Needs Second Review</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
