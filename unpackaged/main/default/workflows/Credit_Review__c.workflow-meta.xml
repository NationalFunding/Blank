    <rules>
        <fullName>Second Review is Complete</fullName>
        <actions>
            <name>Populate_Second_Review_By</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Populate_Second_Review_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Insert_2nd_Review_Analyst</name>
            <type>FlowAction</type>
        </actions>
        <active>true</active>
        <formula>AND (
ISPICKVAL(PRIORVALUE(Status__c),'Second Review'), 
OR( 
ISPICKVAL(Status__c, "Approved"),
ISPICKVAL(Status__c, "Declined"), 
ISPICKVAL(Status__c, "NF Decline")
))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
