    <rules>
        <fullName>Opportunity has been in NF Decline In for 2 Hours</fullName>
        <active>true</active>
        <description>Alert for when Opportunity has remained in NF Decline for an hour with no Internal Credit Analyst. This would indicate eNoah has not yet picked up the deal or completed mini-processing</description>
        <formula>AND(
ISPICKVAL(Opportunity__r.StageName, 'NF Decline'),
ISPICKVAL(Opportunity__r.Type , 'NEW'),
ISBLANK( Opportunity__r.Internal_Credit_Analyst__c),
NOT(
OR(
INCLUDES(Decline_Reasons__c,'Banks - Excessive NSF'),
INCLUDES(Decline_Reasons__c,'Banks - Low Balances'),
INCLUDES(Decline_Reasons__c,'Banks - Low Deposits'),
INCLUDES(Decline_Reasons__c,'Banks - Low Deposits')
))
)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Alert_Opportunity_has_been_in_NF_Decline_for_2_Hours</name>
                <type>Alert</type>
            </actions>
            <timeLength>2</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
