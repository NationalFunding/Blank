    <rules>
        <fullName>IMF - Update Split Funding Processed Info</fullName>
        <actions>
            <name>IMF_Split_Funding_Processed_By</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>IMF_Split_Funding_Processed_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Payment_Request__c.Split_Payment_Processed__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>This workflow will update the user that created the split funding record.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>New Payment Request Status is Not New</fullName>
        <actions>
            <name>Update_Payment_Request_Status_to_New</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Payment_Request__c.Status__c</field>
            <operation>notEqual</operation>
            <value>New</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Payment Request is Paid</fullName>
        <actions>
            <name>Notify_Ops_Payment_Request_Paid</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>Update_Status_to_Paid</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Payment_Request__c.Check_Number__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Payment_Request__c.Wire_Confirmation_Number__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Split Funding - Update Customer%27s Info</fullName>
        <actions>
            <name>SF_Update_Bank_Acct</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>SF_Update_Bank_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>SF_Update_Bank_Routing</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>SF_Update_Mailing_Addy</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>SF_Update_Mailing_City</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>SF_Update_Mailing_State</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>SF_Update_Mailing_Zip</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Payment_Request__c.Split_Funding_Recipient__c</field>
            <operation>equals</operation>
            <value>Customer</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
