    <rules>
        <fullName>Address - NCOA Fail Update if Address Changed %28Address Table%29</fullName>
        <actions>
            <name>Address_NCOA_Fail_Update_to_False</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>This work flow will update the NCOA fail field if a user updates an address after it was marked as failing the NCOA check.</description>
        <formula>AND(NCOA_Fail__c = True, 
OR(
ISCHANGED(Address_1__c),
ISCHANGED(City__c),
ISCHANGED(State__c),
ISCHANGED( Zip_Code__c)))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Address - Update For Equifax</fullName>
        <actions>
            <name>Address_Equifax_Update_Address_Number</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Address_Equifax_Update_Street_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>This workflow will update the Address Number and Street Name field for Equifax pulls.</description>
        <formula>OR( ISNEW(), AND(ISPICKVAL(Location_Type__c, 'Home Address'), ISCHANGED(Address_1__c)))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
