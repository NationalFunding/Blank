<?xml version="1.0" encoding="utf-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Manager_Override_Approval_Email</fullName>
        <description>Manager Override Approval Email</description>
        <protected>false</protected>
        <recipients>
            <field>Approver_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Manager_Override_Approval_Email_Template</template>
