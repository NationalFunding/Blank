        <actions>
            <name>Collections_Cases_Alert_Dave_when_Recovery_sent_to_Accounting</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Accounting_Instructions__c.Type__c</field>
