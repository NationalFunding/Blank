        <active>true</active>
        <criteriaItems>
            <field>Accounting_Instructions__c.Type__c</field>
            <operation>equals</operation>
            <value>Wire In</value>
        </criteriaItems>
        <criteriaItems>
            <field>Accounting_Instructions__c.Send_to_Accounting__c</field>
