<?xml version="1.0" encoding="utf-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Populate_Lease_Deposit_Amount_Received</fullName>
        <field>Lease_Deposit_Amount_Received__c</field>
        <formula>Amount__c</formula>
        <name>Populate Lease Deposit Amount Received</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Opportunity__c</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Populate_Lease_Deposit_Amount_Received_2</fullName>
        <field>Lease_Deposit_Amount_Received_2__c</field>
        <formula>Amount__c</formula>
        <name>Populate Lease Deposit Amount Received 2</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Opportunity__c</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Populate_Lease_Deposit_Received_Date</fullName>
        <field>Lease_Deposit_Check_Received_Date__c</field>
        <formula>Today()</formula>
        <name>Populate Lease Deposit Received Date</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Opportunity__c</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Populate_Lease_Deposit_Received_Date_2</fullName>
        <field>Lease_Deposit_Check_Received_Date_2__c</field>
        <formula>TODAY()</formula>
        <name>Populate Lease Deposit Received Date 2</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Opportunity__c</targetObject>
    </fieldUpdates>
    <rules>
        <fullName>ACH Debit Status is Completed</fullName>
        <actions>
            <name>Populate_Lease_Deposit_Amount_Received</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Populate_Lease_Deposit_Received_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>ACH_Debit__c.Status__c</field>
            <operation>equals</operation>
            <value>Completed</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Lease_Deposit_Check_Bounced__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <description>When the ACH Debit Status is Complete and a Lease Deposit Check has NOT Bounced, the Lease Deposit Check info will be populated with ACH Debit info</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>ACH Debit Status is Completed - Bounced Check</fullName>
        <actions>
            <name>Populate_Lease_Deposit_Amount_Received_2</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Populate_Lease_Deposit_Received_Date_2</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>ACH_Debit__c.Status__c</field>
            <operation>equals</operation>
            <value>Completed</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Lease_Deposit_Check_Bounced__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>When the ACH Debit Status is Complete and a Lease Deposit Check HAS Bounced, the Lease Deposit Check info will be populated with ACH Debit info</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
