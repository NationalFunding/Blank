    <rules>
        <fullName>CM - ACQ Update Resp Channel %28Inbound Call%29</fullName>
        <actions>
            <name>CM_ACQ_Response_Channel_Inbound_Call</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>CampaignMember.HasResponded</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Campaign.Prospect_Type__c</field>
            <operation>equals</operation>
            <value>Acquisition</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.Initial_Response_Channel__c</field>
            <operation>equals</operation>
            <value>Inbound Call</value>
        </criteriaItems>
        <criteriaItems>
            <field>CampaignMember.FirstRespondedDate</field>
            <operation>greaterOrEqual</operation>
            <value>2/7/2014</value>
        </criteriaItems>
        <criteriaItems>
            <field>CampaignMember.Response_Channel__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
