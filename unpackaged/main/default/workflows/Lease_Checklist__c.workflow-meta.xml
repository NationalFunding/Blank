    <rules>
        <fullName>Lease Ins - Update Fields After Insurance Complete %28cesmc%29 - Amanda F</fullName>
        <active>true</active>
        <description>Edited 12/29/16 - changed task to Sarah Bowlin after Amanda left company.</description>
        <formula>OR(  AND(ISBLANK(Previous_Insurance_Expiration_Date__c),       NOT(ISBLANK(Insurance_Expiration_Date__c)), Opportunity__r.Lender_Account__r.Name = "National Funding - Internal Lease Lender Record"),   AND(Previous_Insurance_Expiration_Date__c  &lt;= Insurance_Expiration_Date__c,  Opportunity__r.Lender_Account__r.Name = "National Funding - Internal Lease Lender Record")) &amp;&amp; (Funder__c = "Amanda Foust")</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <offsetFromField>Lease_Checklist__c.Insurance_Expiration_Date__c</offsetFromField>
            <timeLength>-2</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
