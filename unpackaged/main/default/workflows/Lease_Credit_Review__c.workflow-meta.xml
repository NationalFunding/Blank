    <rules>
        <fullName>Lease CR - Approval By%2FDateTime</fullName>
        <actions>
            <name>Lease_CR_Approved_By</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Lease_CR_Approved_Date_Time</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Lease_Credit_Review__c.Credit_Decision__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Lease CR - Approval Expiration Date</fullName>
        <actions>
            <name>Lease_CR_Update_Approval_Expiration</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>OR(  ISPICKVAL(Credit_Decision__c, "Approved"), AND( ISPICKVAL(Credit_Decision__c, "Approved"),  ISCHANGED( Approval_Date__c )))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
