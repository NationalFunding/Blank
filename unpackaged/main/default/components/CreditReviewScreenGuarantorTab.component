                       <!-- Text input-->
                       <div class="form-group">
                         <label class="col-md-4 control-label" for="textinput">PG #2 Alt Credit Score</label>
                         <div class="col-md-6">
                           <apex:inputField value="{!creditReviewObj.PG_2_EXP_Score__c}" styleClass="pg2Guarantor3 onlyInteger form-control" />
                         </div>
                       </div>
                       <!-- Text input-->
                       <div class="form-group">
                         <label class="col-md-4 control-label" for="textinput">PG #2 Previous BK</label>
                         <div class="col-md-6">
                           <apex:inputField value="{!creditReviewObj.PG_2_Previous_BK__c}" styleClass="pg2Guarantor4 form-control" />
                         </div>
                       </div>
                       <!-- Text input-->
                       <div class="form-group">
                         <label class="col-md-4 control-label" for="textinput">PG #2 BK Discharge Date</label>
                         <div class="col-md-6">
                           <apex:inputField value="{!creditReviewObj.PG_2_BK_Discharge_Date__c}" styleClass="pg2Guarantor5 form-control" />
                         </div>
                       </div>
                       <!-- Text input-->
                       <div class="form-group">
                         <label class="col-md-4 control-label" for="textinput">PG #2 Open Public Records (#)</label>
                         <div class="col-md-6">
                           <apex:inputField value="{!creditReviewObj.PG_2_Open_Public_Records__c}" styleClass="pg2Guarantor6 onlyInteger form-control" />
                         </div>
                       </div>
                       <!-- Text input-->
                       <div class="form-group">
                         <label class="col-md-4 control-label" for="textinput">PG #2 Open Public Record Balance ($)</label>
                         <div class="col-md-6">
                           <apex:inputField value="{!creditReviewObj.PG_2_Open_Public_Record_Balance__c}" styleClass="pg2Guarantor7 onlyInteger form-control" />
                         </div>
                       </div>
                      </apex:outputPanel>
                     <!-- Button (Double) -->
                     <div class="form-group">
                        <div class="col-md-4"> 
                              <button disabled="disabled" class="btn btn-block btn-primary" id="gua2-ssn"  onclick="$('#G-SSNsearchmodal').modal('show');searchContactSSN($('#gua2-ssn'),$('#guarantor2-contact_id').val(),'{!creditReviewObj.PG2Search__c}')" type="button">
                              <apex:outputPanel layout="none" rendered="{!creditReviewObj.PG2Search__c}">
                              <i class="fa fa-check-circle"></i>
                            </apex:outputPanel>
                            SSN Search</button> 
                          </div>
                          <div class="col-md-3"> 
                              <button class="btn btn-block btn-primary" onclick="savePgCreditResult('pg2')"  type="button">Save</button> 
                         </div>
                     </div><br/>
                     
                   </fieldset>
                 </form>
              </div>
              <div class="col-md-7">
                  <div class="row">


<!--2***************************************************************************************************************-->
                      <!-- Start Equifax Guarantor 2 Panel -->
