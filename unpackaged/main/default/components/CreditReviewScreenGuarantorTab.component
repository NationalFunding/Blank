<apex:attribute type="Consumer_Credit_Summary__c" name="signorCCS" description="Consumer Credit Summary"/>
<apex:attribute type="Consumer_Credit_Summary__c" name="g2CCS" description="Consumer Credit Summary"/>
<apex:attribute type="Consumer_Credit_Summary__c" name="g3CCS" description="Consumer Credit Summary"/>
<apex:attribute type="Boolean" name="signorHasNoCCS" description="Tells us if there are any CCS records for the guarantor"/>

