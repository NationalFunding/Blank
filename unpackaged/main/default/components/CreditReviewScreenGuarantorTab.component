                          </div>
                        </div>

                      <input id="guarantor2-contact_id" name="" disabled="disabled" class="form-control" type="text" style="display:none" value="{!creditReviewObj.PG2__c}" />
                      <input id="guarantor2-contact_ssn" name="" disabled="disabled" class="form-control" type="text" style="display:none" value="{!creditReviewObj.PG2__r.SSN_Encrypted__c}" />

                     <!-- Text input-->
                       <div class="form-group">
                         <label class="col-md-4 control-label" for="textinput">PG #2 Credit Score</label>
                         <div class="col-md-6">
                           <apex:inputField value="{!creditReviewObj.PG_2_EQF_Score__c}" styleClass="pg2Guarantor1 onlyInteger form-control" />
