<apex:component layout="none">
  <div id="newcontact" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
          <h3 id="myModalLabel">New Contact</h3>
        </div>
        <div class="modal-body"> 
          <input type="hidden" class="area" />
          <div class="row">
             <div class="col-sm-6">
                 <label>First Name</label>
                 <input type="text" class="form-control con-firstname"  />
             </div>
             <div class="col-sm-6">
                 <label>Last Name</label>
                 <input type="text" class="form-control con-lastname"  />
             </div>
          </div>
          <div class="row" style="margin-top:10px">
             <div class="col-sm-6">
                 <label>SSN Encrypted</label>
                 <input type="text" class="form-control con-ssn-encrpted"  />
             </div>
             <div class="col-sm-6">
                 <label>Ownership %</label>
                 <input type="text" class="form-control con-ownership-percentage onlyInteger" maxlength="3"  />
             </div>
          </div>
          <div class="row" style="margin-top:10px">
             <div class="col-sm-6">
                 <label>Title</label>
                 <input type="text" class="form-control con-title"  />
             </div>
             <div class="col-sm-6">
                 <label>Phone</label>
                 <input type="text" class="form-control con-phone"  />
             </div>
          </div>
        </div>
        <div class="modal-footer">
             <button class="btn btn-danger" onclick="$('#newcontact').modal('hide');$('#'+$('.area').val()+'-modal').modal('show')">Cancel</button>
             <button class="btn btn-success" onclick="saveNewContact()" >Save</button>
        </div>
      </div>
    </div>
  </div>
</apex:component>