    <script>
    function formatDollar(num) {
        if(num){
            var p = num.toFixed(2).split(".");
            return "$" + p[0].split("").reverse().reduce(function(acc, num, i, orig) {
                return  num + (i && !(i % 3) ? "," : "") + acc;
            }, "") + "." + p[1];
        }
        if(!num){
            return '-';
        }
    }
    function formatTerm(num) {
        if(num){
            return num + ' Months';
            }
        if(!num){
            return '-'
            }
        }
    function formatEdit(data){
        if(data)
            {
                return data
                }
        if(!data)
            {
                return ''
                }
        }
    function formatNA(data){
        if(data)
            { 
                return data
                }
        if(!data)
            {
                return '-'
                }
        }
    function formatBlank(data){
        if(data)
            {
                return data
            }
        if(!data)
            {
                return '-'
            }
        }
        function formatClear(data){
        if(data)
            {
                return data
            }
        if(!data)
            {
                return '-'
            }
        }
    function formatDate(data){
        if(data)
            {
                var date = new Date(data);
                   var year = date.getFullYear(),
        month = date.getMonth() + 1, // months are zero indexed
        day = date.getDate(),
        hour = date.getHours(),
        minute = date.getMinutes(),
        second = date.getSeconds(),
        hourFormatted = hour % 12 || 12, // hour returned in 24 hour format
        minuteFormatted = minute < 10 ? "0" + minute : minute,
        morning = hour < 12 ? "am" : "pm";

    return month + "/" + day + "/" + year;
                }
        if(!data){
            return 'N/A'
            }}
    </script>


<script type="text/javascript">
        function uploadFile1(parentId)
        {
            var input = document.getElementById("file-input");
            var filesToUpload = input.files;
            $("#loading-div-background").show();
            for(var i = 0, f; f = filesToUpload[i]; i++)
            {
                var reader = new FileReader();

                // Keep a reference to the File in the FileReader so it can be accessed in callbacks
                reader.file = f;

                reader.onload = function(e)
                {
                    var att = new sforce.SObject("Attachment");
                    att.Name = '[Exception] ' + this.file.name;
                    att.ContentType = this.file.type;
                    att.ParentId = parentId;

                    var binary = "";
                    var bytes = new Uint8Array(e.target.result);
                    var length = bytes.byteLength;

                    for (var i = 0; i < length; i++)
                    {
                        binary += String.fromCharCode(bytes[i]);
                    }

                    att.Body = (new sforce.Base64Binary(binary)).toString();

                    sforce.connection.create([att],
                    {
                        onSuccess : function(result, source)
                        {
                            if (result[0].getBoolean("success"))
                            {
                                alert("Your File Has Been Uploaded!");
                                console.log("new attachment created with id " + result[0].id);
                                     
                                $("#attachmentText").append(att.Name);
                                $( "#decision-tab" ).click();
                                $("#loading-div-background").hide();
                            }
                            else
                            {
                                console.log("failed to create attachment " + result[0]);
                            }
                        },
                        onFailure : function(error, source)
                        {
                            console.log("an error has occurred " + error);
                        }
                    });
                };
                
               $("#file-input").val("");
                reader.readAsArrayBuffer(f);
                
            }
        }
</script>
