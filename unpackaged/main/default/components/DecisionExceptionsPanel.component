    <script>
   function takeAction(data) {
        
        if(data){
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.Exception_ApprovalProcess.returnExceptions}',
                data,
                function(result, event){

                    swal.resetDefaults();
                    let id = result[0].Id;
                    swal({
                        title: 'Are you sure?',
                        input: 'textarea',
                        html:'<p style="line-height: 110%;"><b>Id:</b>' + result[0].Id + '<br/>' + ' <b>Step Approval Type:</b> '+ ' <b>Status:</b> ' + result[0].StepsAndWorkitems[1].StepStatus  +'</p>',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Approve Request',
                        cancelButtonText: 'Deny Request'
                    }).then( function(isConfirm) {
                        console.log(isConfirm);

                                var test = '';
                                if($('.swal2-textarea').val()){
                                    test = $('.swal2-textarea').val();
                                    console.log(test);
                                }
                                setApproval(result[0].TargetObjectId, test);
                                $("#remoteAcctId").empty();
                                $("#blockSection1").empty();
                                
                                swal(
                                    'Approved!',
                                    'Your request has been approved.',
                                    'success'
                                );
                        console.log('start rerender');
                                rerenderTopBlock();

 
                        },
                         function(dismiss){
                            var test = '';
                            if(dismiss === 'cancel'){
                                    test = $('.swal2-textarea').val();
                                    console.log(id + ' ' + test + '' + result[0].TargetObjectId);
                                    
                                    setDenial(result[0].TargetObjectId, test);
                                    $("#remoteAcctId").empty();

                                    swal(
                                        'Cancelled',
                                        'Your request is denied :(',
                                        'error'
                                    );
                                //    $( "#decision-tab" ).click();
                                rerenderTopBlock();
                                }
                             }
                    )
                    
                }
            )
        }
                               
    }
    </script>
