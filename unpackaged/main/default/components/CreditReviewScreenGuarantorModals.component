        },1000);
       removeCRSRelation2();
        removeCreditReviewRelation2();
    }
    if(type == 'PG3__c'){
        $(obj).remove();
        $('#'+prifix+'-ssn').attr('disabled','disabled');
        $('#'+prifix+'-ssn').next('button').attr('disabled','disabled');
