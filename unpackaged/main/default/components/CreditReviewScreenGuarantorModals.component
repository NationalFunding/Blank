               },{escape:true}
          );
        setTimeout(function(){
           reloadGuarantor();
        },1000);
        removeCRSRelation3();
        removeCreditReviewRelation3();
    }
  }
else{

    }
 }
  function fillContacts(prefix){
    Visualforce.remoting.Manager.invokeAction(
       'CreditreViewScreenController.getSSNContacts', 
           parentId,
           function(result, event) {
             var table='';
              if(result.length > 0){
                table ='<table class="table table-striped table-bordered table-hover">';
                  table +='<thead>';
                    table +='<tr>';
                      table +='<th>#</th>';
                      table +='<th>Name</th>';
                      table +='<th>Title</th>';
                      table +='<th>Ownership %</th>';
                      table +='<th>Email</th>';
                      table +='<th>Phone</th>';
                    table +='</tr>';
                  table +='</thead>';
                  table +='<tbody>';
                  for(var i=0; i < result.length ; i++){
                    var ssn = result[i].SSN_Encrypted__c !== undefined ? result[i].SSN_Encrypted__c:'N/A';
                    var title = result[i].Title !== undefined ?result[i].Title:'N/A';
                    var email = result[i].Email !== undefined ?result[i].Email:'N/A';
                    var phone = result[i].Phone !== undefined ?result[i].Phone:'N/A';
                    var percentage = result[i].Ownership_Percentage__c !==undefined ?result[i].Ownership_Percentage__c:'N/A';
                    table +='<tr>';
                      table +='<td>';
                        table +='<input type="hidden" class="ssn" value="'+ssn+'" />';
                        table +='<input  type="radio" value="'+result[i].Id+'" class="'+prefix+'-radio" name="'+prefix+'-radio" style="margin:0px" />';
                      table +='</td>';
                      table +='<td class="contact_name">'+result[i].Name+'</td>';
                      table +='<td>'+title+'</td>';
                      table +='<td class="contact_ownership">'+percentage+'</td>';
                      table +='<td>'+email+'</td>';
                      table +='<td>'+phone+'</td>';
                    table +='</tr>';
                  }
                  table +='</tbody>';
                table +='</table>';
              }else{
                table+='<center> No Record </center>';
              }
              $('#'+prefix+'-box').html(table);
           },{escape:true}
       )
  }
  </script>
  <!--Signor Modal Starts here-->
  <div id="signor-modal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
          <h3 id="myModalLabel">Signor</h3>
        </div>
        <div class="modal-body">
            <div style="max-height:350px;overflow-y:scroll" id="signor-box"> 
            </div>
        </div>
        <div class="modal-footer" style="text-align:center;">
          <button class="btn btn-primary" onClick="setSignorValue()" type="button">Save</button>
          <!-- <button class="btn btn-primary" onclick="$('.con-firstname,.con-lastname,.con-ssn-encrpted,.con-ownership-percentage,.con-title,.con-phone').val('');$('.area').val('signor');$('#newcontact').modal('show');$('#signor-modal').modal('hide')" type="button">New Contact</button> -->
        </div>
      </div>
    </div>
  </div>
  <script>
    function addRemoveButton(id,field,type){
     if(!$('#'+id).next('.delete-btn').length > 0){
        $('#'+id).after('<span class="input-group-addon delete-btn" onclick="removePg(this,\''+field+'\',\''+type+'\')" style="cursor:pointer"> <i class="glyphicon glyphicon-remove-sign"></i> </span>');
      } 
    }
    function setSignorValue(){
      if($('#signor-box').text().indexOf('No Record') != 1){
        if($('.signor-radio:checked').length < 1 ){
            alert('Please Select Row');
        }else{
            var obj = $('.signor-radio:checked');
            $('#signor-contact_id').val($(obj).val());
            $('#signor-contact_name').val($(obj).closest('tr').find('.contact_name').text());
            addRemoveButton('signor-contact_name','PG1__c','signor');
            var Ownership = $(obj).closest('tr').find('.contact_ownership').text() != 'N/A'?$(obj).closest('tr').find('.contact_ownership').text():'';
            $('#signor-ownership').val(Ownership);
            $('#signor-contact_ssn').val($(obj).closest('tr').find('.ssn').val());
            //$('#signor-ssn,#signor-ownership').removeAttr('disabled');
            if(pullCreditPermission =='true')
            $('.pull1').removeAttr('disabled'); 
            callSaveGuarantorInfo($(obj).val(),'1');
            $('#signor-modal').modal('hide');
            getGuarantorInfo();
           
        }
       }else{
        $('#signor-modal').modal('hide');
       } 
    }
  </script>
  <!--Signor Modal Ends here-->
