        $('#'+prifix+'-ssn').next('button').attr('disabled','disabled');
        $('#'+prifix+'-ssn').find('i').hide()
         Visualforce.remoting.Manager.invokeAction(
           'CreditreViewScreenController.deletePG',
               parentId,
