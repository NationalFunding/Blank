<apex:component layout="none">
<!--Gurantor SSN Search Starts here-->
  <div id="G-SSNsearchmodal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
          <h3 id="myModalLabel">SSN Search</h3>
        </div>
        <div class="modal-body">
          <!--<div class="row" id="ssn-textbox">
            <div class="col-md-12">
                <div class="col-md-offset-3 col-md-6" style="text-align:center;" >
                  <input type="hidden" id="came_from" />
                  <label class="col-md-12 text-center" for="textinput">Name to Search:</label>
                 <input type="text" id="gurantor-ssn-search" placeholder="Gurantor SSN Search" class="form-control con-sm-6" />
                 <br/><br />
                  <button class="btn btn-primary" type="button" onclick="searchSSNRecord()">Search</button>
                </div>
            </div>
            
          </div>-->
          <div class="row">
            <div class="row col-md-12" id="ssnloader" style="display:none">
              <div class="col-md-12">
                <div class="dataloader text-center col-md-12"> <br/>
                  Searching for contacts with an SSN matching <strong class="searchingOf">...</strong><br/>
                  <a href="#" id="clickloader">
                  <p style="margin-top:15px; display:inline-block;">
                    <apex:image url="{!URLFOR($Resource.CreditReviewScreen, 'images/dataloader.gif')}"/>
                  </p>
                  </a> </div>
              </div>
            </div>
            <div class="row col-md-12" style="display:none" id="ssnresults">
              <div class="text-center">Results for matching <strong class="searchingOf">...</strong></div>
              <br/>
              <div class="col-md-12"  id="ssnresultsBox">
                
              </div>
            </div>
            <div class="row col-md-12">
              <div class="col-md-12"> 
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="text-align:center;">
          <div class="row bottom-button1">
                <div align="center">
                    <button class="btn btn-danger" data-dismiss="modal"  aria-hidden="true">Cancel Search</button>
                </div>
          </div>
          <div class="row bottom-button2" style="display:none">
            <div class="col-sm-12">
                <div class="pull-left">
                    <button class="btn btn-danger" onclick="saveSSNAndClose()" data-dismiss="modal"  aria-hidden="true">Back</button>
                </div>
                <div class="pull-right">
                    <label><input name="" type="checkbox" id="ssn_complete" value="" /> SSN Search is Complete &nbsp;&nbsp;&nbsp;&nbsp;</label>
                    <button class="btn btn-success associate-btn" onclick="saveSSN()">Associate Selected</button>
                </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--Gurantor SSN Search Ends here-->
</apex:component>