       <apex:outputPanel id="pg1OutPut-decision">
         <h5 class="text-center">Equifax Results</h5>
           <apex:outputPanel rendered="{!creditReviewObj.PG1_EQF_Cons_Summary__c != NULL}" layout="none" >
                   <table width="100%" border="0" class="table" >
                    <apex:repeat value="{!$ObjectType.Consumer_Credit_Summary__c.Fieldsets.Credit_Review_Equifax_Fields}" var="fieldName">
                        <tr>
                           <td>{!fieldName.label}:</td>
                           <td>
                             <apex:outputText value="{0, date, MMM d','  yyyy}" rendered="{!fieldName.type =='date'}">
                                <apex:param value="{!CreditSummaryObj1[fieldName.FieldPath]}" /> 
                            </apex:outputText>
                            <apex:outputText value="{0,number,#,##0.##}" rendered="{!fieldName.type == 'double'}">
                              <apex:param value="{!CreditSummaryObj1[fieldName.FieldPath]}" />
                            </apex:outputText>
                            <apex:outputText value="{0,number,$#,##0.00}" rendered="{!fieldName.type == 'currency'}">
                              <apex:param value="{!CreditSummaryObj1[fieldName.FieldPath]}" />
                            </apex:outputText>
                            <apex:outputPanel rendered="{!fieldName.type !='date' && fieldName.type !='double' && fieldName.type !='currency'}">
                              {!CreditSummaryObj1[fieldName.FieldPath]}        
                           </apex:outputPanel>
                          </td>
                         </tr>
                    </apex:repeat>
                   </table>
                <div  style="text-align:center;"> <a href="{!creditReviewObj.PG1_EQF_Cons_Summary__r.URL_for_View_Link__c}" target="_blank" class="btn  btn-default">View Details</a> 
                  <a href="javascript:void(0)"  onclick="$('#guarantormodal').modal('show')" role="button" class="btn permissionDeny btn-default">Pull Credit</a> 
                </div>
           </apex:outputPanel>
           <apex:outputPanel rendered="{!creditReviewObj.PG1_EQF_Cons_Summary__c == NULL}"  layout="none">
            <div class="text-center">
                <p>Credit has not been pulled.</p>
                <a href="javascript:void(0)"  onclick="$('#guarantormodal').modal('show')" role="button" class="btn permissionDeny btn-default">Pull Credit</a> 
              </div>
           </apex:outputPanel>
        </apex:outputPanel>
     </div>
   </div>
