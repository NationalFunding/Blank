                                    {!CreditSummaryObj2[fieldName.FieldPath]}        
                                 </apex:outputPanel>
                               </td>
                             </tr>
                        </apex:repeat>
                      </table>
                  <div align="center"> <a  href="{!creditReviewObj.PG1_EXP_Cons_Summary__r.URL_for_View_Link__c}" target="_blank" class="btn  btn-default">View Details</a>
                  <a href="javascript:void(0)"  onclick="$('#guarantormodal').modal('show')" role="button" class="btn permissionDeny btn-default">Pull Credit</a> 
                   </div>
              </apex:outputPanel>
