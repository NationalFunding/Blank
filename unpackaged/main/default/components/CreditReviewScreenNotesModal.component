<apex:component layout="none">
<!--Note Information Modal Starts here-->
  <div id="notesmodel" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
          <h3 id="myModalLabel">New Note</h3>
        </div>
        <div class="modal-body"> 
            <div class="form-group">
                <label>Subject</label>
                <input type="text" id="notes-subject" class="form-control" placeholder="Subject" />   
            </div>
            <div class="form-group">
                <label>Note</label>
                <textarea class="form-control" id="notes-body" placeholder="Note" rows="10" style="resize: none;"></textarea>  
            </div>
        </div>
        <div class="modal-footer" style="text-align:center;">
          <input type="button" onclick="saveNotes()" value="Save Note" class="btn btn-primary" />
        </div>
      </div>
    </div>
  </div>
  <!--Note Information Modal End here-->
</apex:component>