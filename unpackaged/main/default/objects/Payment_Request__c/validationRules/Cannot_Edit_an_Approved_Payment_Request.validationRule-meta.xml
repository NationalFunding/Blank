<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Edit_an_Approved_Payment_Request</fullName>
    <active>true</active>
    <errorConditionFormula>(ISPICKVAL(Status__c, 'Approved') || ISPICKVAL(Status__c, 'Paid')) &amp;&amp; ($Profile.Name &lt;&gt; 'FPC - Accounting User') &amp;&amp; ($Profile.Name &lt;&gt; 'System Administrator')</errorConditionFormula>
    <errorMessage>Only Accounting can edit this record after it has been approved.</errorMessage>
</ValidationRule>
