<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>two_letter_abbreviation_reqd_g3state</fullName>
    <active>true</active>
    <description>Must enter state with 2 letter abbreviation</description>
    <errorConditionFormula>AND(!ISBLANK(G3_Home_State__c ), LEN(G3_Home_State__c ) != 2)</errorConditionFormula>
    <errorDisplayField>G3_Home_State__c</errorDisplayField>
    <errorMessage>Must enter state using 2 letter abbreviation</errorMessage>
</ValidationRule>
