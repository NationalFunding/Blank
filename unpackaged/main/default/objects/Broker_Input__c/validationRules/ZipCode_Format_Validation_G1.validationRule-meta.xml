<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ZipCode_Format_Validation_G1</fullName>
    <active>true</active>
    <description>Valid proper format for 5 or 9 digit US Zipcode</description>
    <errorConditionFormula>NOT(ISBLANK(G1_Home_Zip__c))&amp;&amp;
AND(NOT(REGEX(G1_Home_Zip__c, "\\d{5}(-\\d{4})?")))</errorConditionFormula>
    <errorDisplayField>G1_Home_Zip__c</errorDisplayField>
    <errorMessage>Zip code must be in 99999 or 99999-9999 format.</errorMessage>
</ValidationRule>
