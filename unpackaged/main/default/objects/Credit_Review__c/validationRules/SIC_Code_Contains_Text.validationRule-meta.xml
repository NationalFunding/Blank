<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SIC_Code_Contains_Text</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(ISNUMBER(LEFT(SIC_Code__c, 4))) &amp;&amp; NOT(ISBLANK(SIC_Code__c))</errorConditionFormula>
    <errorDisplayField>SIC_Code__c</errorDisplayField>
    <errorMessage>SIC Code can only contains numerical values</errorMessage>
</ValidationRule>
