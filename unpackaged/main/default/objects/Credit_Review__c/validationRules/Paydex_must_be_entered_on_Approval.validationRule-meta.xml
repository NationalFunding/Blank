<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Paydex_must_be_entered_on_Approval</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISBLANK(Paydex__c),
ISCHANGED(Status__c),
ISPICKVAL(Status__c, 'Approved') 
)</errorConditionFormula>
    <errorMessage>Paydex must be entered before Approval can be issued</errorMessage>
</ValidationRule>
