<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Avg_Deposits_Amount__c</fullName>
    <formula>IF(TEXT(Credit_Review_Version__c) = 'Version 2',  (Sum_of_Counter_Deposits_Amount_v2__c + Sum_of_Other_Deposits_Amount_v2__c) /  Number_of_Months_Reviewed_v2__c, 
(Sum_of_Counter_Deposits_Amount__c +  Sum_of_Other_Deposits_Amount__c) / Number_of_Months_Reviewed__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Avg Deposits ($)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
