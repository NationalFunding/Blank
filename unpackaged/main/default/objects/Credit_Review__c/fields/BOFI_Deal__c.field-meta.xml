<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BOFI_Deal__c</fullName>
    <description>This field will capture if a deal will be run through as a BofI deal.  The user will need to make a selection prior approving the deal.</description>
    <inlineHelpText>Please select if this transaction will be funded through BofI before approving the deal.</inlineHelpText>
    <label>BOFI Deal</label>
    <required>false</required>
    <trackHistory>true</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Yes</fullName>
                <default>false</default>
                <label>Yes</label>
            </value>
            <value>
                <fullName>No</fullName>
                <default>false</default>
                <label>No</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
