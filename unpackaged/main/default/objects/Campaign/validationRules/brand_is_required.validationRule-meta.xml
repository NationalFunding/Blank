<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>brand_is_required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISNEW(),
ISBLANK(TEXT(Brand__c)), $Setup.ValidationRules__c.Allow_Campaign_Creation_With_no_Brand__c = false 
)</errorConditionFormula>
    <errorMessage>Brand is required.</errorMessage>
</ValidationRule>
