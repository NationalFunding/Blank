<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Time_to_Close__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISNULL( Date_Activity_Logged__c ),null,(Date_Activity_Logged__c - CreatedDate )*24*60)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>time from task creation to close in minutes</inlineHelpText>
    <label>Time to Close</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
