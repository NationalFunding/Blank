<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Years_In_Business__c</fullName>
    <description>Calculates how many years the company has been in business based on the field Date Established</description>
    <externalId>false</externalId>
    <formula>FLOOR((TODAY()- Date_Established__c )/365)</formula>
    <label>Years In Business</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
