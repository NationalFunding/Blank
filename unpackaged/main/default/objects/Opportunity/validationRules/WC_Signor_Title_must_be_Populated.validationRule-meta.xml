<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>WC_Signor_Title_must_be_Populated</fullName>
    <active>false</active>
    <description>Deactivated 1/17/18</description>
    <errorConditionFormula>(NOT(ISBLANK(Doc_Formulas_LU__r.Signor_Contact_ID__c))) &amp;&amp; 
ISBLANK(Doc_Formulas_LU__r.Signor_Title__c) &amp;&amp; 
(ISPICKVAL(StageName, 'Statements In - MCA')) &amp;&amp; 
ISCHANGED(StageName) &amp;&amp; 
(RecordType.Name = 'Working Capital Oppty')</errorConditionFormula>
    <errorMessage>Signor Title must be populated before updating the Stage to 'Statements In - MCA'. Once these fields are complete, click the 'Recalc Roles' button.</errorMessage>
</ValidationRule>
