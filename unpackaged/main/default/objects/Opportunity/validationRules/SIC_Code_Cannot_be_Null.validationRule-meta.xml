<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SIC_Code_Cannot_be_Null</fullName>
    <active>false</active>
    <errorConditionFormula>ISBLANK(Account.SICCODE__c) &amp;&amp; (ISPICKVAL(StageName, 'Approved - MCA') || ISPICKVAL(StageName, 'Approved - Lease')) &amp;&amp; ISCHANGED(StageName)</errorConditionFormula>
    <errorDisplayField>First_Due_Lender_For_Actual__c</errorDisplayField>
    <errorMessage>The Account's SIC Code must be populated before updating the Stage.</errorMessage>
</ValidationRule>
