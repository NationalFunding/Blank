<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>WC_Annual_Rev_Cannot_be_Null</fullName>
    <active>true</active>
    <errorConditionFormula>ISBLANK(Annual_Revenue__c) &amp;&amp; ISPICKVAL(StageName, 'Statements In - MCA') &amp;&amp; ISCHANGED(StageName)</errorConditionFormula>
    <errorMessage>Annual Revenue must have a value before the Stage can be updated to 'Statements In - MCA'.</errorMessage>
</ValidationRule>
