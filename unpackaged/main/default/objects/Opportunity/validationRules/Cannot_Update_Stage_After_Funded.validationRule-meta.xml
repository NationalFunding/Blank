<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Update_Stage_After_Funded</fullName>
    <active>true</active>
    <description>Prevents users from updating the Opportunity stage after it's Funded.</description>
    <errorConditionFormula>AND(
			 ISPICKVAL(PRIORVALUE(StageName), 'Funded'),
				ISCHANGED(StageName),
				$Setup.ValidationRules__c.Update_Stage_After_Funded__c = False
				
				)</errorConditionFormula>
    <errorMessage>You cannot change the stage of a Funded Opportunity.</errorMessage>
</ValidationRule>
