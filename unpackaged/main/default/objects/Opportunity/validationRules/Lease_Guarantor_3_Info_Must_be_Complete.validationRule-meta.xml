<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lease_Guarantor_3_Info_Must_be_Complete</fullName>
    <active>false</active>
    <description>Requested by Nikki to be made inactive.  5/2/14</description>
    <errorConditionFormula>((NOT(ISBLANK(Doc_Formulas_LU__r.Guarantor_3_Contact_ID__c))) &amp;&amp; (ISBLANK( Doc_Formulas_LU__r.Guarantor_3_Contact_ID__r.SSN_Encrypted__c ) || ISBLANK(Doc_Formulas_LU__r.Guarantor_3_Street_Address__c) || ISBLANK(Doc_Formulas_LU__r.Guarantor_3_City__c) || ISBLANK(Doc_Formulas_LU__r.Guarantor_3_State__c) || ISBLANK(Doc_Formulas_LU__r.Guarantor_3_Zip_Code__c) || ISBLANK(Doc_Formulas_LU__r.Guarantor_3_Contact_ID__r.Ownership_Percentage__c))) &amp;&amp; ISPICKVAL(StageName, 'Credit Submittal') &amp;&amp; ISCHANGED(StageName)</errorConditionFormula>
    <errorMessage>Guarantor 3 SSN, Ownership %, and Address info must be populated before updating the Stage to 'Credit Submittal'. Once these fields are complete, click the 'Recalc Roles' button.</errorMessage>
</ValidationRule>
