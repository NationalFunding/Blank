<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lease_Signor_Info_Must_be_Complete</fullName>
    <active>true</active>
    <errorConditionFormula>((NOT(ISBLANK(Doc_Formulas_LU__r.Signor_Contact_ID__c))) &amp;&amp; (ISBLANK(Doc_Formulas_LU__r.Signor_Contact_ID__r.SSN_Encrypted__c) || ISBLANK(Doc_Formulas_LU__r.Signor_Street_Address__c) || ISBLANK(Doc_Formulas_LU__r.Signor_City__c) || ISBLANK(Doc_Formulas_LU__r.Signor_State__c) || ISBLANK(Doc_Formulas_LU__r.Signor_Zip_Code__c) || ISBLANK(Doc_Formulas_LU__r.Signor_Contact_ID__r.Ownership_Percentage__c))) &amp;&amp; ISPICKVAL(StageName, 'Credit Submittal') &amp;&amp; ISCHANGED(StageName)</errorConditionFormula>
    <errorMessage>Signor SSN, Ownership %, and Address info must be populated before updating the Stage to 'Credit Submittal'. Once these fields are complete, click the 'Recalc Roles' button.</errorMessage>
</ValidationRule>
