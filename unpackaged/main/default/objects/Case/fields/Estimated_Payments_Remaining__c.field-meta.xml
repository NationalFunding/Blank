<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Estimated_Payments_Remaining__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
	Opportunity__r.Balance_Remaining__c /  Opportunity__r.Actual_Daily_Payment__c &lt; 0,
	0,
	CEILING(Opportunity__r.Balance_Remaining__c /  Opportunity__r.Actual_Daily_Payment__c)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Estimated Payments Remaining</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
