<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Internet_Response_Date_Day__c</fullName>
    <externalId>false</externalId>
    <formula>CASE(
MOD(DATEVALUE(Internet_Response_Date__c)- DATE(1900, 1, 7), 7), 
0, "Sunday", 
1, "Monday", 
2, "Tuesday", 
3, "Wednesday", 
4, "Thursday", 
5, "Friday", 
6, "Saturday", "Error")</formula>
    <label>Internet Response Date Day</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
