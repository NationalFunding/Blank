<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Siftrock_Email__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
	ISBLANK(Owner:User.Email), "",
	LEFT(Owner:User.Email, (FIND("@", Owner:User.Email))) + "reply." + RIGHT(Owner:User.Email,LEN(Owner:User.Email)-FIND('@',Owner:User.Email))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Siftrock Email</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
