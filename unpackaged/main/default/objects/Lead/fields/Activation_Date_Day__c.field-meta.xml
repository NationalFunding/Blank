<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Activation_Date_Day__c</fullName>
    <description>Day of week of the Activation Date pd-499</description>
    <externalId>false</externalId>
    <formula>CASE(WEEKDAY(DATEVALUE(Activation_Date__c)),
						1,'Sunday',
						2,'Monday',
						3,'Tuesday',
						4,'Wednesday',
						5,'Thursday',
						6,'Friday',
						7,'Saturday',
					''
						)</formula>
    <inlineHelpText>Day of week of the Activation Date</inlineHelpText>
    <label>Activation Date Day</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
