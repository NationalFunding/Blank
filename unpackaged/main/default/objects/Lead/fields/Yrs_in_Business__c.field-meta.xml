<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Yrs_in_Business__c</fullName>
    <description>Calculates how many years the business has been in operation</description>
    <externalId>false</externalId>
    <formula>YEAR(TODAY())- YEAR( Date_Established__c )</formula>
    <inlineHelpText>None - formula based on Lead.Date_Established__c</inlineHelpText>
    <label>Yrs in Business</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
