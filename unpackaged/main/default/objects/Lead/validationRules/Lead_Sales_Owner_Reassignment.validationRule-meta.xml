<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Sales_Owner_Reassignment</fullName>
    <active>true</active>
    <description>This rule will not allow a Sales User to reassign record to another user except House Account.</description>
    <errorConditionFormula>AND(

$UserRole.DeveloperName = "WC_Sales_User",
 $Setup.ValidationRules__c.Transfer_Leads__c =FALSE
,ISCHANGED( OwnerId ),
 PRIORVALUE(OwnerId )=  $User.Id ,
 Owner:User.Full_Name__c  &lt;&gt; "House Account")</errorConditionFormula>
    <errorMessage>You cannot reassign Lead to another user.</errorMessage>
</ValidationRule>
