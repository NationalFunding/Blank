<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UW_TIB__c</fullName>
    <description>Time in Business in months calculated from Date Established</description>
    <externalId>false</externalId>
    <formula>(MONTH(TODAY()) + (12*(YEAR(TODAY())-YEAR(UW_Date_Established__c))) - MONTH(UW_Date_Established__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>UW TIB</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
