<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SMS_Opt_Out_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
	ISCHANGED(SMS_Opt_Out__c),
	PRIORVALUE(SMS_Opt_Out__c)=TRUE,
	SMS_Opt_Out__c = FALSE,
 NOT($Setup.ValidationRules__c.Allow_Unchecking_SMS_Opt_Out__c)
)</errorConditionFormula>
    <errorMessage>You cannot manually uncheck the SMS Opt Out field</errorMessage>
</ValidationRule>
