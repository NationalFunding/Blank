<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>X_Mins_After_Creation__c</fullName>
    <description>Field used to check partner evaluation after configured wait time.</description>
    <formula>CreatedDate + $Setup.Automation_Custom_Settings__c.Partner_Evaluation_Wait_Time__c/24/60</formula>
    <label>X Mins After Creation</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>DateTime</type>
</CustomField>
