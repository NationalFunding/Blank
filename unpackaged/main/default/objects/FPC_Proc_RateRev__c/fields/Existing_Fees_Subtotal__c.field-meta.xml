<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Existing_Fees_Subtotal__c</fullName>
    <description>This field will calculate the existing fee expense for the rate review.</description>
    <formula>Discover_Per_Item_Existing_Expense__c  +  MC_Per_Item_Existing_Expense__c  +  Offline_Debit_Per_Item_Existing_Expense__c  +  Visa_Per_Item_Existing_Expense__c + Existing_Processor_Fee_Summary__c</formula>
